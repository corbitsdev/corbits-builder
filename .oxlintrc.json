{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["vendor/**", "**/dist/**", "**/generated/**", "tmp/**"],
  "options": {
    "denyWarnings": true
  },
  "rules": {
    "eslint/eqeqeq": "error",
    "eslint/prefer-const": "error",
    "eslint/no-var": "error",
    "eslint/no-else-return": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "unicorn/require-module-specifiers": "error",
    "import/no-cycle": "error",
    // Any `.env` read: process.env, Bun.env, import.meta.env (Bun's alias), through globalThis or
    // destructured. `key.env` names a variable in config/install-root.ts and install-root.ts, and a
    // Hono handler's `c.env` is its server, not the environment. This one entry stands in for a
    // custom lint plugin or ast-grep rule; an object named `key` or `c`, or an alias, gets past it,
    // and that is accepted.
    "eslint/no-restricted-properties": [
      "error",
      {
        "property": "env",
        "allowObjects": ["key", "c"],
        "message": "Read the environment through the hub's environment.ts, which validates it."
      }
    ],
    "eslint/complexity": [
      "error",
      {
        "max": 40
      }
    ],
    "eslint/max-params": [
      "error",
      {
        "max": 6
      }
    ],
    "eslint/max-nested-callbacks": [
      "error",
      {
        "max": 5
      }
    ],
    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@corbits-builder/plugin-host",
              "@corbits-builder/plugin-host/**"
            ],
            "message": "Only the hub imports the plugin host; a plugin author's types live in @corbits-builder/plugin."
          }
        ]
      }
    ]
  },
  "overrides": [
    // Each environment.ts, the only code that reads the environment, and tests, which set and
    // restore it.
    {
      "files": [
        "**/environment.ts",
        "**/*.test.ts",
        "**/*.test.tsx",
        "test/**"
      ],
      "rules": {
        "eslint/no-restricted-properties": "off"
      }
    },
    // Not configuration. The starter and the app checks run with a generated app's environment.
    // Build constants: build-packages.ts has Bun.build's define replace the BUILDER_* reads in
    // agent-package.ts and role-inference.ts. A child process gets PATH, HOME or TMPDIR as is. The
    // workflow child reads the signing key Interchange's sidecar hands it. `bun run dev:stop` reads
    // the shell's ports as plain text, and the interface reads Vite's build mode.
    {
      "files": [
        "plugins/coder/starter/**",
        "packages/app-checks/check/**",
        "apps/hub/src/workflows/agent-package.ts",
        "apps/hub/src/workflows/role-inference.ts",
        "apps/hub/src/builds/posix-child.ts",
        "apps/hub/src/live-app/runner.ts",
        "apps/hub/src/sidecar/spawn.ts",
        "apps/hub/src/builds/app-repository.ts",
        "apps/web/src/main.tsx",
        "scripts/dev-stop.ts"
      ],
      "rules": {
        "eslint/no-restricted-properties": "off"
      }
    },
    {
      "files": [
        "apps/hub/src/auth/agent-token-bridge.ts",
        "apps/web/src/pages/workspace/deliverable-block.tsx",
        "apps/web/src/pages/workspace/room.model.ts"
      ],
      "rules": {
        "eslint/complexity": "off"
      }
    },
    {
      "files": [
        "apps/hub/src/artifacts/service.ts",
        "apps/hub/src/projects/routes.ts"
      ],
      "rules": {
        "eslint/max-params": "off"
      }
    },
    {
      "files": ["apps/hub/**"],
      "rules": {
        "eslint/no-restricted-imports": "off"
      }
    },
    {
      "files": ["plugins/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@corbits-builder/(hub|plugin-host)(/|$)",
                "message": "A plugin reaches the host only through @corbits-builder/plugin, never the hub's or the plugin host's own modules."
              },
              {
                "group": [
                  "@corbits-builder/*",
                  "@corbits-builder/*/**",
                  "!@corbits-builder/plugin",
                  "!@corbits-builder/plugin/**",
                  "!@corbits-builder/plugin-ui",
                  "!@corbits-builder/plugin-ui/**",
                  "!@corbits-builder/schemas",
                  "!@corbits-builder/schemas/**",
                  "!@corbits-builder/app-checks",
                  "!@corbits-builder/app-checks/**",
                  "!@corbits-builder/hub",
                  "!@corbits-builder/hub/**",
                  "!@corbits-builder/plugin-host",
                  "!@corbits-builder/plugin-host/**"
                ],
                "message": "A plugin never imports another plugin; what plugins share belongs in @corbits-builder/plugin, @corbits-builder/plugin-ui, @corbits-builder/schemas or @corbits-builder/app-checks."
              }
            ]
          }
        ]
      }
    },
    // An override replaces the rule for its files, so each depth of a plugin's files restates the
    // package rules and adds how many folders up a relative import may climb before it leaves.
    // The host is matched by a regex because a glob group's negations would also clear it.
    {
      "files": ["plugins/*/*.ts", "plugins/*/*.tsx"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@corbits-builder/(hub|plugin-host)(/|$)",
                "message": "A plugin reaches the host only through @corbits-builder/plugin, never the hub's or the plugin host's own modules."
              },
              {
                "group": [
                  "@corbits-builder/*",
                  "@corbits-builder/*/**",
                  "!@corbits-builder/plugin",
                  "!@corbits-builder/plugin/**",
                  "!@corbits-builder/plugin-ui",
                  "!@corbits-builder/plugin-ui/**",
                  "!@corbits-builder/schemas",
                  "!@corbits-builder/schemas/**",
                  "!@corbits-builder/app-checks",
                  "!@corbits-builder/app-checks/**",
                  "!@corbits-builder/hub",
                  "!@corbits-builder/hub/**",
                  "!@corbits-builder/plugin-host",
                  "!@corbits-builder/plugin-host/**"
                ],
                "message": "A plugin never imports another plugin; what plugins share belongs in @corbits-builder/plugin, @corbits-builder/plugin-ui, @corbits-builder/schemas or @corbits-builder/app-checks."
              },
              {
                "regex": "^(\\.\\./){1}",
                "message": "A plugin imports only its own files; a relative path never leaves its folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["plugins/*/*/*.ts", "plugins/*/*/*.tsx"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@corbits-builder/(hub|plugin-host)(/|$)",
                "message": "A plugin reaches the host only through @corbits-builder/plugin, never the hub's or the plugin host's own modules."
              },
              {
                "group": [
                  "@corbits-builder/*",
                  "@corbits-builder/*/**",
                  "!@corbits-builder/plugin",
                  "!@corbits-builder/plugin/**",
                  "!@corbits-builder/plugin-ui",
                  "!@corbits-builder/plugin-ui/**",
                  "!@corbits-builder/schemas",
                  "!@corbits-builder/schemas/**",
                  "!@corbits-builder/app-checks",
                  "!@corbits-builder/app-checks/**",
                  "!@corbits-builder/hub",
                  "!@corbits-builder/hub/**",
                  "!@corbits-builder/plugin-host",
                  "!@corbits-builder/plugin-host/**"
                ],
                "message": "A plugin never imports another plugin; what plugins share belongs in @corbits-builder/plugin, @corbits-builder/plugin-ui, @corbits-builder/schemas or @corbits-builder/app-checks."
              },
              {
                "regex": "^(\\.\\./){2}",
                "message": "A plugin imports only its own files; a relative path never leaves its folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["plugins/*/*/*/*.ts", "plugins/*/*/*/*.tsx"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@corbits-builder/(hub|plugin-host)(/|$)",
                "message": "A plugin reaches the host only through @corbits-builder/plugin, never the hub's or the plugin host's own modules."
              },
              {
                "group": [
                  "@corbits-builder/*",
                  "@corbits-builder/*/**",
                  "!@corbits-builder/plugin",
                  "!@corbits-builder/plugin/**",
                  "!@corbits-builder/plugin-ui",
                  "!@corbits-builder/plugin-ui/**",
                  "!@corbits-builder/schemas",
                  "!@corbits-builder/schemas/**",
                  "!@corbits-builder/app-checks",
                  "!@corbits-builder/app-checks/**",
                  "!@corbits-builder/hub",
                  "!@corbits-builder/hub/**",
                  "!@corbits-builder/plugin-host",
                  "!@corbits-builder/plugin-host/**"
                ],
                "message": "A plugin never imports another plugin; what plugins share belongs in @corbits-builder/plugin, @corbits-builder/plugin-ui, @corbits-builder/schemas or @corbits-builder/app-checks."
              },
              {
                "regex": "^(\\.\\./){3}",
                "message": "A plugin imports only its own files; a relative path never leaves its folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["plugins/*/*/*/*/*.ts", "plugins/*/*/*/*/*.tsx"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@corbits-builder/(hub|plugin-host)(/|$)",
                "message": "A plugin reaches the host only through @corbits-builder/plugin, never the hub's or the plugin host's own modules."
              },
              {
                "group": [
                  "@corbits-builder/*",
                  "@corbits-builder/*/**",
                  "!@corbits-builder/plugin",
                  "!@corbits-builder/plugin/**",
                  "!@corbits-builder/plugin-ui",
                  "!@corbits-builder/plugin-ui/**",
                  "!@corbits-builder/schemas",
                  "!@corbits-builder/schemas/**",
                  "!@corbits-builder/app-checks",
                  "!@corbits-builder/app-checks/**",
                  "!@corbits-builder/hub",
                  "!@corbits-builder/hub/**",
                  "!@corbits-builder/plugin-host",
                  "!@corbits-builder/plugin-host/**"
                ],
                "message": "A plugin never imports another plugin; what plugins share belongs in @corbits-builder/plugin, @corbits-builder/plugin-ui, @corbits-builder/schemas or @corbits-builder/app-checks."
              },
              {
                "regex": "^(\\.\\./){4}",
                "message": "A plugin imports only its own files; a relative path never leaves its folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["plugins/*/*/*/*/*/*.ts", "plugins/*/*/*/*/*/*.tsx"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@corbits-builder/(hub|plugin-host)(/|$)",
                "message": "A plugin reaches the host only through @corbits-builder/plugin, never the hub's or the plugin host's own modules."
              },
              {
                "group": [
                  "@corbits-builder/*",
                  "@corbits-builder/*/**",
                  "!@corbits-builder/plugin",
                  "!@corbits-builder/plugin/**",
                  "!@corbits-builder/plugin-ui",
                  "!@corbits-builder/plugin-ui/**",
                  "!@corbits-builder/schemas",
                  "!@corbits-builder/schemas/**",
                  "!@corbits-builder/app-checks",
                  "!@corbits-builder/app-checks/**",
                  "!@corbits-builder/hub",
                  "!@corbits-builder/hub/**",
                  "!@corbits-builder/plugin-host",
                  "!@corbits-builder/plugin-host/**"
                ],
                "message": "A plugin never imports another plugin; what plugins share belongs in @corbits-builder/plugin, @corbits-builder/plugin-ui, @corbits-builder/schemas or @corbits-builder/app-checks."
              },
              {
                "regex": "^(\\.\\./){5}",
                "message": "A plugin imports only its own files; a relative path never leaves its folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/**/*.view.tsx", "apps/web/src/**/*.stories.tsx"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@tanstack/react-query",
                "message": "A view or a story never reads the hub. The page's model does."
              },
              {
                "name": "@corbits-builder/client",
                "allowTypeImports": true,
                "message": "A view or a story never calls the hub. The page's model does."
              }
            ],
            "patterns": [
              {
                "group": ["**/api/*", "**/queries/*"],
                "message": "A view or a story never reaches the hub. Take what it shows as props; the page's model reads it."
              },
              {
                "group": [
                  "@corbits-builder/plugin-host",
                  "@corbits-builder/plugin-host/**"
                ],
                "message": "Only the hub imports the plugin host; a plugin author's types live in @corbits-builder/plugin."
              },
              {
                "group": ["**/*.model", "**/*.model.ts", "**/*.model.js"],
                "message": "A view owns its props and a story draws the view; neither runs the page's model."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/**/*.model.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@corbits-builder/plugin-host",
                  "@corbits-builder/plugin-host/**"
                ],
                "message": "Only the hub imports the plugin host; a plugin author's types live in @corbits-builder/plugin."
              },
              {
                "group": ["**/*.module.css"],
                "message": "A model holds no look. Styles belong to the view."
              },
              {
                "group": ["**/*.view", "**/*.view.tsx", "**/*.view.jsx"],
                "allowTypeImports": true,
                "message": "A model returns the view's props; it never renders the view."
              }
            ]
          }
        ]
      }
    }
  ]
}
