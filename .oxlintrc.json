{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["vendor/**", "**/dist/**", "**/generated/**", "tmp/**"],
  "options": {
    "denyWarnings": true
  },
  "rules": {
    "eslint/eqeqeq": "error",
    "eslint/prefer-const": "error",
    "eslint/no-var": "error",
    "eslint/no-else-return": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "unicorn/require-module-specifiers": "error",
    "import/no-cycle": "error",
    "eslint/complexity": [
      "error",
      {
        "max": 40
      }
    ],
    "eslint/max-params": [
      "error",
      {
        "max": 6
      }
    ],
    "eslint/max-nested-callbacks": [
      "error",
      {
        "max": 5
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "apps/hub/src/auth/agent-token-bridge.ts",
        "apps/web/src/pages/workspace/deliverable-block.tsx",
        "apps/web/src/pages/workspace/room.model.ts"
      ],
      "rules": {
        "eslint/complexity": "off"
      }
    },
    {
      "files": [
        "apps/hub/src/artifacts/service.ts",
        "apps/hub/src/projects/routes.ts"
      ],
      "rules": {
        "eslint/max-params": "off"
      }
    },
    {
      "files": ["apps/web/src/**/*.view.tsx", "apps/web/src/**/*.stories.tsx"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@tanstack/react-query",
                "message": "A view or a story never reads the hub. The page's model does."
              },
              {
                "name": "@corbits-builder/client",
                "allowTypeImports": true,
                "message": "A view or a story never calls the hub. The page's model does."
              }
            ],
            "patterns": [
              {
                "group": ["**/api/*", "**/queries/*"],
                "message": "A view or a story never reaches the hub. Take what it shows as props; the page's model reads it."
              },
              {
                "group": ["**/*.model", "**/*.model.ts", "**/*.model.js"],
                "message": "A view owns its props and a story draws the view; neither runs the page's model."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/**/*.model.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/*.module.css"],
                "message": "A model holds no look. Styles belong to the view."
              },
              {
                "group": ["**/*.view", "**/*.view.tsx", "**/*.view.jsx"],
                "allowTypeImports": true,
                "message": "A model returns the view's props; it never renders the view."
              }
            ]
          }
        ]
      }
    }
  ]
}
