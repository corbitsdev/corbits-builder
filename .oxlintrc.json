{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["vendor/**", "**/dist/**", "**/generated/**", "tmp/**"],
  "options": {
    "denyWarnings": true
  },
  "jsPlugins": ["./scripts/oxlint-environment.ts"],
  "rules": {
    "eslint/eqeqeq": "error",
    "eslint/prefer-const": "error",
    "eslint/no-var": "error",
    "eslint/no-else-return": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "unicorn/require-module-specifiers": "error",
    "import/no-cycle": "error",
    "eslint/no-restricted-properties": [
      "error",
      {
        "object": "process",
        "property": "env",
        "message": "Read the environment through this process's environment.ts, which validates it with @corbits-builder/environment; hand a child process PATH or HOME with inherit from @corbits-builder/environment/inherit."
      },
      {
        "object": "Bun",
        "property": "env",
        "message": "Read the environment through this process's environment.ts, which validates it with @corbits-builder/environment."
      }
    ],
    "environment/no-direct-read": "error",
    "eslint/complexity": [
      "error",
      {
        "max": 40
      }
    ],
    "eslint/max-params": [
      "error",
      {
        "max": 6
      }
    ],
    "eslint/max-nested-callbacks": [
      "error",
      {
        "max": 5
      }
    ],
    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@corbits-builder/plugin-host",
              "@corbits-builder/plugin-host/**"
            ],
            "message": "Only the hub imports the plugin host; a plugin author's types live in @corbits-builder/plugin."
          }
        ]
      }
    ]
  },
  "overrides": [
    // The environment package, the only code that reads the environment, and tests, which set and
    // restore it.
    {
      "files": [
        "packages/environment/src/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "test/**"
      ],
      "rules": {
        "eslint/no-restricted-properties": "off",
        "environment/no-direct-read": "off"
      }
    },
    // Not Builder's processes. The starter is the template a generated app grows from. The app
    // checks are compiled alone from their source text in a project's sandbox, where no workspace
    // package resolves. Both run with the project's environment.
    {
      "files": ["plugins/coder/starter/**", "packages/app-checks/check/**"],
      "rules": {
        "eslint/no-restricted-properties": "off",
        "environment/no-direct-read": "off"
      }
    },
    // Build constants, not environment reads: build-packages.ts has Bun.build's define replace these
    // exact expressions in each workflow package. BUILDER_TOOLS must stay a literal inside import()
    // for the bundler to inline the plugin's tools module. Tests set them in the
    // environment in place of a build.
    {
      "files": [
        "apps/hub/src/workflows/agent-package.ts",
        "apps/hub/src/workflows/role-inference.ts"
      ],
      "rules": {
        "eslint/no-restricted-properties": "off"
      }
    },
    // The interface's only reader of Vite's build mode, which browser code cannot get from the
    // environment package.
    {
      "files": ["apps/web/src/build-mode.ts"],
      "rules": {
        "environment/no-direct-read": "off"
      }
    },
    {
      "files": [
        "apps/hub/src/auth/agent-token-bridge.ts",
        "apps/web/src/pages/workspace/deliverable-block.tsx",
        "apps/web/src/pages/workspace/room.model.ts"
      ],
      "rules": {
        "eslint/complexity": "off"
      }
    },
    {
      "files": [
        "apps/hub/src/artifacts/service.ts",
        "apps/hub/src/projects/routes.ts"
      ],
      "rules": {
        "eslint/max-params": "off"
      }
    },
    {
      "files": ["apps/hub/**"],
      "rules": {
        "eslint/no-restricted-imports": "off"
      }
    },
    {
      "files": ["plugins/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@corbits-builder/(hub|plugin-host)(/|$)",
                "message": "A plugin reaches the host only through @corbits-builder/plugin, never the hub's or the plugin host's own modules."
              },
              {
                "group": [
                  "@corbits-builder/*",
                  "@corbits-builder/*/**",
                  "!@corbits-builder/plugin",
                  "!@corbits-builder/plugin/**",
                  "!@corbits-builder/plugin-ui",
                  "!@corbits-builder/plugin-ui/**",
                  "!@corbits-builder/schemas",
                  "!@corbits-builder/schemas/**",
                  "!@corbits-builder/app-checks",
                  "!@corbits-builder/app-checks/**",
                  "!@corbits-builder/ssh-publish",
                  "!@corbits-builder/ssh-publish/**",
                  "!@corbits-builder/publishing",
                  "!@corbits-builder/hub",
                  "!@corbits-builder/hub/**",
                  "!@corbits-builder/plugin-host",
                  "!@corbits-builder/plugin-host/**"
                ],
                "message": "A plugin never imports another plugin; what plugins share belongs in @corbits-builder/plugin, @corbits-builder/plugin-ui, @corbits-builder/schemas, @corbits-builder/app-checks, @corbits-builder/ssh-publish or @corbits-builder/publishing."
              }
            ]
          }
        ]
      }
    },
    // An override replaces the rule for its files, so each depth of a plugin's files restates the
    // package rules and adds how many folders up a relative import may climb before it leaves.
    // The host is matched by a regex because a glob group's negations would also clear it.
    {
      "files": ["plugins/*/*.ts", "plugins/*/*.tsx"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@corbits-builder/(hub|plugin-host)(/|$)",
                "message": "A plugin reaches the host only through @corbits-builder/plugin, never the hub's or the plugin host's own modules."
              },
              {
                "group": [
                  "@corbits-builder/*",
                  "@corbits-builder/*/**",
                  "!@corbits-builder/plugin",
                  "!@corbits-builder/plugin/**",
                  "!@corbits-builder/plugin-ui",
                  "!@corbits-builder/plugin-ui/**",
                  "!@corbits-builder/schemas",
                  "!@corbits-builder/schemas/**",
                  "!@corbits-builder/app-checks",
                  "!@corbits-builder/app-checks/**",
                  "!@corbits-builder/ssh-publish",
                  "!@corbits-builder/ssh-publish/**",
                  "!@corbits-builder/publishing",
                  "!@corbits-builder/hub",
                  "!@corbits-builder/hub/**",
                  "!@corbits-builder/plugin-host",
                  "!@corbits-builder/plugin-host/**"
                ],
                "message": "A plugin never imports another plugin; what plugins share belongs in @corbits-builder/plugin, @corbits-builder/plugin-ui, @corbits-builder/schemas, @corbits-builder/app-checks, @corbits-builder/ssh-publish or @corbits-builder/publishing."
              },
              {
                "regex": "^(\\.\\./){1}",
                "message": "A plugin imports only its own files; a relative path never leaves its folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["plugins/*/*/*.ts", "plugins/*/*/*.tsx"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@corbits-builder/(hub|plugin-host)(/|$)",
                "message": "A plugin reaches the host only through @corbits-builder/plugin, never the hub's or the plugin host's own modules."
              },
              {
                "group": [
                  "@corbits-builder/*",
                  "@corbits-builder/*/**",
                  "!@corbits-builder/plugin",
                  "!@corbits-builder/plugin/**",
                  "!@corbits-builder/plugin-ui",
                  "!@corbits-builder/plugin-ui/**",
                  "!@corbits-builder/schemas",
                  "!@corbits-builder/schemas/**",
                  "!@corbits-builder/app-checks",
                  "!@corbits-builder/app-checks/**",
                  "!@corbits-builder/ssh-publish",
                  "!@corbits-builder/ssh-publish/**",
                  "!@corbits-builder/publishing",
                  "!@corbits-builder/hub",
                  "!@corbits-builder/hub/**",
                  "!@corbits-builder/plugin-host",
                  "!@corbits-builder/plugin-host/**"
                ],
                "message": "A plugin never imports another plugin; what plugins share belongs in @corbits-builder/plugin, @corbits-builder/plugin-ui, @corbits-builder/schemas, @corbits-builder/app-checks, @corbits-builder/ssh-publish or @corbits-builder/publishing."
              },
              {
                "regex": "^(\\.\\./){2}",
                "message": "A plugin imports only its own files; a relative path never leaves its folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["plugins/*/*/*/*.ts", "plugins/*/*/*/*.tsx"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@corbits-builder/(hub|plugin-host)(/|$)",
                "message": "A plugin reaches the host only through @corbits-builder/plugin, never the hub's or the plugin host's own modules."
              },
              {
                "group": [
                  "@corbits-builder/*",
                  "@corbits-builder/*/**",
                  "!@corbits-builder/plugin",
                  "!@corbits-builder/plugin/**",
                  "!@corbits-builder/plugin-ui",
                  "!@corbits-builder/plugin-ui/**",
                  "!@corbits-builder/schemas",
                  "!@corbits-builder/schemas/**",
                  "!@corbits-builder/app-checks",
                  "!@corbits-builder/app-checks/**",
                  "!@corbits-builder/ssh-publish",
                  "!@corbits-builder/ssh-publish/**",
                  "!@corbits-builder/publishing",
                  "!@corbits-builder/hub",
                  "!@corbits-builder/hub/**",
                  "!@corbits-builder/plugin-host",
                  "!@corbits-builder/plugin-host/**"
                ],
                "message": "A plugin never imports another plugin; what plugins share belongs in @corbits-builder/plugin, @corbits-builder/plugin-ui, @corbits-builder/schemas, @corbits-builder/app-checks, @corbits-builder/ssh-publish or @corbits-builder/publishing."
              },
              {
                "regex": "^(\\.\\./){3}",
                "message": "A plugin imports only its own files; a relative path never leaves its folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["plugins/*/*/*/*/*.ts", "plugins/*/*/*/*/*.tsx"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@corbits-builder/(hub|plugin-host)(/|$)",
                "message": "A plugin reaches the host only through @corbits-builder/plugin, never the hub's or the plugin host's own modules."
              },
              {
                "group": [
                  "@corbits-builder/*",
                  "@corbits-builder/*/**",
                  "!@corbits-builder/plugin",
                  "!@corbits-builder/plugin/**",
                  "!@corbits-builder/plugin-ui",
                  "!@corbits-builder/plugin-ui/**",
                  "!@corbits-builder/schemas",
                  "!@corbits-builder/schemas/**",
                  "!@corbits-builder/app-checks",
                  "!@corbits-builder/app-checks/**",
                  "!@corbits-builder/ssh-publish",
                  "!@corbits-builder/ssh-publish/**",
                  "!@corbits-builder/publishing",
                  "!@corbits-builder/hub",
                  "!@corbits-builder/hub/**",
                  "!@corbits-builder/plugin-host",
                  "!@corbits-builder/plugin-host/**"
                ],
                "message": "A plugin never imports another plugin; what plugins share belongs in @corbits-builder/plugin, @corbits-builder/plugin-ui, @corbits-builder/schemas, @corbits-builder/app-checks, @corbits-builder/ssh-publish or @corbits-builder/publishing."
              },
              {
                "regex": "^(\\.\\./){4}",
                "message": "A plugin imports only its own files; a relative path never leaves its folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["plugins/*/*/*/*/*/*.ts", "plugins/*/*/*/*/*/*.tsx"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@corbits-builder/(hub|plugin-host)(/|$)",
                "message": "A plugin reaches the host only through @corbits-builder/plugin, never the hub's or the plugin host's own modules."
              },
              {
                "group": [
                  "@corbits-builder/*",
                  "@corbits-builder/*/**",
                  "!@corbits-builder/plugin",
                  "!@corbits-builder/plugin/**",
                  "!@corbits-builder/plugin-ui",
                  "!@corbits-builder/plugin-ui/**",
                  "!@corbits-builder/schemas",
                  "!@corbits-builder/schemas/**",
                  "!@corbits-builder/app-checks",
                  "!@corbits-builder/app-checks/**",
                  "!@corbits-builder/ssh-publish",
                  "!@corbits-builder/ssh-publish/**",
                  "!@corbits-builder/publishing",
                  "!@corbits-builder/hub",
                  "!@corbits-builder/hub/**",
                  "!@corbits-builder/plugin-host",
                  "!@corbits-builder/plugin-host/**"
                ],
                "message": "A plugin never imports another plugin; what plugins share belongs in @corbits-builder/plugin, @corbits-builder/plugin-ui, @corbits-builder/schemas, @corbits-builder/app-checks, @corbits-builder/ssh-publish or @corbits-builder/publishing."
              },
              {
                "regex": "^(\\.\\./){5}",
                "message": "A plugin imports only its own files; a relative path never leaves its folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/**/*.view.tsx", "apps/web/src/**/*.stories.tsx"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@tanstack/react-query",
                "message": "A view or a story never reads the hub. The page's model does."
              },
              {
                "name": "@corbits-builder/client",
                "allowTypeImports": true,
                "message": "A view or a story never calls the hub. The page's model does."
              }
            ],
            "patterns": [
              {
                "group": ["**/api/*", "**/queries/*"],
                "message": "A view or a story never reaches the hub. Take what it shows as props; the page's model reads it."
              },
              {
                "group": [
                  "@corbits-builder/plugin-host",
                  "@corbits-builder/plugin-host/**"
                ],
                "message": "Only the hub imports the plugin host; a plugin author's types live in @corbits-builder/plugin."
              },
              {
                "group": ["**/*.model", "**/*.model.ts", "**/*.model.js"],
                "message": "A view owns its props and a story draws the view; neither runs the page's model."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/**/*.model.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@corbits-builder/plugin-host",
                  "@corbits-builder/plugin-host/**"
                ],
                "message": "Only the hub imports the plugin host; a plugin author's types live in @corbits-builder/plugin."
              },
              {
                "group": ["**/*.module.css"],
                "message": "A model holds no look. Styles belong to the view."
              },
              {
                "group": ["**/*.view", "**/*.view.tsx", "**/*.view.jsx"],
                "allowTypeImports": true,
                "message": "A model returns the view's props; it never renders the view."
              }
            ]
          }
        ]
      }
    }
  ]
}
