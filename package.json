{
  "name": "corbits-builder",
  "version": "0.1.0-rc.3",
  "private": true,
  "description": "Builder turns an idea into approved documents, a design and a working web app, with agents on the model provider you choose.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-builder.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "workflows/*",
    "vendor/interchange/packages/*",
    "vendor/interchange/apps/sidecar"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run db:migrate && bun --env-file=.env.web run --parallel dev:hub dev:web",
    "dev:hub": "UI_PUBLIC_URL=http://localhost:${UI_PORT:-5173} bun run start",
    "dev:web": "bun --env-file=.env.web run --cwd apps/web dev",
    "start": "exec bun --env-file=.env.hub --conditions=intx-src apps/hub/src/server.ts",
    "db:migrate": "bun --env-file=.env.hub --conditions=intx-src apps/hub/src/migrate.ts",
    "db:generate": "bun --conditions=intx-src ./node_modules/drizzle-kit/bin.cjs generate --config=apps/hub/drizzle.config.ts",
    "docker:up": "docker compose --env-file .env.hub --project-directory . -f deploy/compose.yml -f deploy/compose.build.yml up -d --build",
    "docker:sidecar": "docker build -f deploy/Dockerfile --target sidecar -t corbits-builder-sidecar:local .",
    "auth:bootstrap": "bun --env-file=.env.hub --conditions=intx-src apps/hub/src/setup.ts",
    "auth:emulate": "bun --env-file=.env.hub scripts/google-emulate.ts",
    "lint": "bun --bun run oxlint --deny-warnings",
    "format": "bun fmt --no-script",
    "format:check": "bun fmt --no-script --check",
    "typecheck": "bun check --no-script && bun check --no-script -p packages/client && bun check --no-script -p apps/web",
    "test": "bun --conditions=intx-src test ./apps/hub ./apps/web/src ./packages ./workflows ./test/integration",
    "test:e2e": "bun --env-file=.env.hub --conditions=intx-src test ./test/e2e",
    "vendor:verify": "bun scripts/verify-vendor.ts",
    "pins:verify": "bun scripts/verify-pins.ts",
    "skills:react-ui": "bun scripts/react-ui-api.ts"
  },
  "dependencies": {
    "@corbits/agent-token": "0.2.2",
    "@corbits/artifacts": "0.3.0",
    "@intx/agent": "workspace:*",
    "@intx/authz": "workspace:*",
    "@intx/crypto": "0.5.0",
    "@intx/db": "workspace:*",
    "@intx/harness": "workspace:*",
    "@intx/hub-agent": "workspace:*",
    "@intx/hub-api": "workspace:*",
    "@intx/hub-common": "workspace:*",
    "@intx/hub-sessions": "workspace:*",
    "@intx/inference": "0.5.0",
    "@intx/log": "0.5.0",
    "@intx/mailbox": "0.5.0",
    "@intx/mime": "0.5.0",
    "@intx/pack-transport": "0.5.0",
    "@intx/storage-isogit": "workspace:*",
    "@intx/tool-packaging": "workspace:*",
    "@intx/tools-lsp": "0.5.0",
    "@intx/tools-mail": "0.5.0",
    "@intx/tools-posix": "0.5.0",
    "@intx/types": "workspace:*",
    "@intx/workflow": "workspace:*",
    "@intx/workflow-deploy": "workspace:*",
    "@intx/workflow-host": "workspace:*",
    "@logtape/logtape": "2.4.2",
    "arktype": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "hono-openapi": "1.5.0",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@corbits-builder/client": "workspace:*",
    "@corbits-builder/coordinator": "workspace:*",
    "@corbits-builder/designer": "workspace:*",
    "@corbits-builder/hub": "workspace:*",
    "@corbits-builder/schemas": "workspace:*",
    "@corbits-builder/writer": "workspace:*",
    "@emulators/core": "0.12.3",
    "@emulators/google": "0.12.3",
    "@intx/sidecar-app": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "drizzle-kit": "0.31.9",
    "jszip": "3.10.2",
    "oxlint": "1.89.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "@types/semver": "7.8.0",
    "@types/ssri": "7.1.5",
    "arktype": "2.2.9",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "isomorphic-git": "1.44.7",
    "postgres": "3.4.9",
    "semver": "7.8.5",
    "ssri": "12.0.0",
    "tar": "7.5.22"
  },
  "patchedDependencies": {
    "@corbits/mcp@0.4.1": "patches/@corbits%2Fmcp@0.4.1.patch"
  }
}
