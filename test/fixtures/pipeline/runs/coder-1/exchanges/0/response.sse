data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":11,"function":{"arguments":"{\"path\":\"client/src/api.ts\",\"content\":\"import { useEffect, useState } from \\\"react\\\";\\nimport { useQueries, useQuery, type UseQueryOptions } from \\\"@tanstack/react-query\\\";\\nimport { Forecast, Health, Nearest, Places } from \\\"@app/shared\\\";\\nimport type { z } from \\\"zod\\\";\\nimport { readCached, writeCached } from \\\"./lib/storage.ts\\\";\\n\\nasync function parsed<T>(response: Response, path: string, schema: z.ZodType<T>): Promise<T> {\\n  if (!response.ok) {\\n    const body = await response.json().catch(() => undefined);\\n    const message =\\n      body && typeof body.error === \\\"string\\\" ? body.error : `${path} answered ${response.status}`;\\n    throw new Error(message);\\n  }\\n  return schema.parse(await response.json());\\n}\\n\\n// Every response is parsed with its shared schema, so a wrong shape fails here instead of deep in the UI.\\nexport async function getJson<T>(path: string, schema: z.ZodType<T>): Promise<T> {\\n  return parsed(await fetch(path), path, schema);\\n}\\n\\nexport const useHealth = () =>\\n  useQuery({ queryKey: [\\\"health\\\"], queryFn: () => getJson(\\\"/api/health\\\", Health) });\\n\\n/** A place to fetch weather for. `id` names its stored copy for offline use. */\\nexport type PlaceRef = { id: string; lat: number; lon: number };\\n\\nconst FIVE_MIN = 5 * 60_000;\\nconst FRESH_ENOUGH = 15 * 60_000;\\n\\nconst round = (n: number) => n.toFixed(2);\\n\\n/** index.html starts Home's forecast request before the app loads; the first matching query uses it. */\\nfunction takePrefetch(path: string): Promise<Forecast> | null {\\n  const w = window as { __prefetch?: { url: string; response: Promise<Response> } };\\n  const pre = w.__prefetch;\\n  if (!pre || pre.url !== path) return null;\\n  w.__prefetch = undefined;\\n  return pre.response.then((r) => parsed(r, path, Forecast));\\n}\\n\\nexport function forecastOptions(place: PlaceRef): UseQueryOptions<Forecast> {\\n  const cached = readCached(place.id);\\n  const usable = cached && Date.now() - cached.at < FRESH_ENOUGH ? cached : undefined;\\n  return {\\n    queryKey: [\\\"forecast\\\", round(place.lat), round(place.lon)],\\n    queryFn: async () => {\\n      const path = `/api/forecast?lat=${round(place.lat)}&lon=${round(place.lon)}`;\\n      const data = await (takePrefetch(path) ?? getJson(path, Forecast));\\n      writeCached(place.id, data);\\n      return data;\\n    },\\n    // Reused for five minutes, so switching between cities doesn't ask the free service again.\\n    staleTime: FIVE_MIN,\\n    // Fail (and fall back to the stored copy) when offline instead of waiting silently.\\n    networkMode: \\\"always\\\",\\n    retry: 1,\\n    retryDelay: 800,\\n    ...(usable ? { initialData: usable.data, initialDataUpdatedAt: usable.at } : {}),\\n  };\\n}\\n\\nexport const useForecast = (place: PlaceRef | null) =>\\n  useQuery({ ...forecastOptions(place ?? { id: \\\"none\\\", lat: 0, lon: 0 }), enabled: place !== null });\\n\\nexport const useForecasts = (places: PlaceRef[]) =>\\n  useQueries({ queries: places.map((p) => forecastOptions(p)) });\\n\\n/** The text after the person stops typing for 300ms. */\\nexport function useDebounced(value: string, ms = 300) {\\n  const [debounced, setDebounced] = useState(value);\\n  useEffect(() => {\\n    const t = setTimeout(() => setDebounced(value), ms);\\n    return () => clearTimeout(t);\\n  }, [value, ms]);\\n  return debounced;\\n}\\n\\nexport const usePlaces = (q: string) =>\\n  useQuery({\\n    queryKey: [\\\"places\\\", q.toLowerCase()],\\n    queryFn: () => getJson(`/api/places?q=${encodeURIComponent(q)}`, Places),\\n    enabled: q.length >= 2,\\n    staleTime: FIVE_MIN,\\n    networkMode: \\\"always\\\",\\n    retry: 1,\\n  });\\n\\nexport const fetchNearest = (lat: number, lon: number, tz: string) =>\\n  getJson(`/api/nearest?lat=${round(lat)}&lon=${round(lon)}&tz=${encodeURIComponent(tz)}`, Nearest);\\n\"}"}}]},"finish_reason":null}]}

