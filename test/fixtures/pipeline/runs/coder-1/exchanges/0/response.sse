data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":48,"function":{"arguments":"{\"path\":\"client/src/scene/storm.ts\",\"content\":\"import { rand, type EffectOptions } from \\\"./common.ts\\\";\\nimport { Rain } from \\\"./rain.ts\\\";\\n\\n// Storm: heavy rain under dark clouds, with lightning. For safety, flashes are rationed: a strike\\n// flashes at most twice, strikes are seconds apart, and a hard limit never allows more than three\\n// flashes in any one second. Under reduced motion there is no lightning at all.\\n\\nconst MAX_FLASHES_PER_SECOND = 3;\\n\\ntype Bolt = { pts: [number, number][]; branches: [number, number][][] };\\n\\nexport class Storm extends Rain {\\n  private nextStrike = rand(1.2, 3);\\n  private flashTimes: number[] = [];\\n  private flash = 0; // current flash brightness 0..1\\n  private pending: number[] = []; // times of the strike's follow-up flashes\\n  private bolt: Bolt | null = null;\\n  private boltLife = 0;\\n  private time = 0;\\n  constructor(opts: EffectOptions) {\\n    super({ ...opts, intensity: opts.intensity === \\\"light\\\" ? \\\"moderate\\\" : \\\"heavy\\\" }, true);\\n  }\\n  /** Flashes in the last second, for checks. */\\n  flashesLastSecond() {\\n    return this.flashTimes.filter((t) => this.time - t < 1).length;\\n  }\\n  private tryFlash(strength: number) {\\n    this.flashTimes = this.flashTimes.filter((t) => this.time - t < 1);\\n    if (this.flashTimes.length >= MAX_FLASHES_PER_SECOND) return false;\\n    this.flashTimes.push(this.time);\\n    this.flash = Math.max(this.flash, strength);\\n    return true;\\n  }\\n  private makeBolt(): Bolt {\\n    const pts: [number, number][] = [];\\n    let x = rand(0.15, 0.85) * this.w;\\n    let y = this.h * 0.08;\\n    const end = this.h * rand(0.55, 0.8);\\n    const branches: [number, number][][] = [];\\n    pts.push([x, y]);\\n    while (y < end) {\\n      x += rand(-28, 28);\\n      y += rand(14, 34);\\n      pts.push([x, y]);\\n      if (Math.random() < 0.12 && branches.length < 3) {\\n        const b: [number, number][] = [[x, y]];\\n        let bx = x;\\n        let by = y;\\n        const dir = Math.random() < 0.5 ? -1 : 1;\\n        for (let i = 0; i < 6; i++) {\\n          bx += dir * rand(8, 26);\\n          by += rand(10, 24);\\n          b.push([bx, by]);\\n        }\\n        branches.push(b);\\n      }\\n    }\\n    return { pts, branches };\\n  }\\n  override update(dt: number) {\\n    super.update(dt);\\n    this.time += dt;\\n    this.flash = Math.max(0, this.flash - dt * 5.5);\\n    this.boltLife = Math.max(0, this.boltLife - dt);\\n    if (this.opts.still) return;\\n    this.pending = this.pending.filter((at) => {\\n      if (this.time >= at) {\\n        this.tryFlash(0.55);\\n        return false;\\n      }\\n      return true;\\n    });\\n    this.nextStrike -= dt;\\n    if (this.nextStrike <= 0) {\\n      const heavy = this.opts.intensity === \\\"heavy\\\";\\n      this.nextStrike = heavy ? rand(2.5, 6) : rand(4, 9);\\n      if (this.tryFlash(1)) {\\n        this.bolt = this.makeBolt();\\n        this.boltLife = 0.28;\\n        // One follow-up flicker, well apart, so a strike is never more than two flashes.\\n        if (Math.random() < 0.6) this.pending.push(this.time + rand(0.25, 0.4));\\n      }\\n    }\\n  }\\n  override draw(ctx: CanvasRenderingContext2D, alpha: number) {\\n    if (this.flash > 0.01) {\\n      ctx.fillStyle = `rgba(215,222,255,${0.32 * this.flash * alpha})`;\\n      ctx.fillRect(0, 0, this.w, this.h);\\n    }\\n    super.draw(ctx, alpha);\\n    if (this.bolt && this.boltLife > 0) {\\n      const a = Math.min(1, this.boltLife / 0.12) * alpha;\\n      ctx.save();\\n      ctx.shadowColor = \\\"rgba(190,200,255,0.9)\\\";\\n      ctx.shadowBlur = 18;\\n      ctx.strokeStyle = `rgba(245,247,255,${a})`;\\n      ctx.lineJoin = \\\"round\\\";\\n      ctx.lineWidth = 2.6;\\n      ctx.beginPath();\\n      this.bolt.pts.forEach(([x, y], i) => (i ? ctx.lineTo(x, y) : ctx.moveTo(x, y)));\\n      ctx.stroke();\\n      ctx.lineWidth = 1.2;\\n      for (const b of this.bolt.branches) {\\n        ctx.beginPath();\\n        b.forEach(([x, y], i) => (i ? ctx.lineTo(x, y) : ctx.moveTo(x, y)));\\n        ctx.stroke();\\n      }\\n      ctx.restore();\\n    }\\n  }\\n}\\n\"}"}}]},"finish_reason":null}]}

