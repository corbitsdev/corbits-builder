data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":47,"function":{"arguments":"{\"path\":\"client/src/scene/snow.ts\",\"content\":\"import { Clouds, dotSprite, rand, share, type Effect, type EffectOptions } from \\\"./common.ts\\\";\\n\\n// Snow: flakes in depth. Far flakes are small, dim and slow; near flakes are large, soft and sway\\n// as they fall. Heavy snow is dense and blown sideways; flurries are sparse and lazy.\\n\\nconst FULL: Record<string, number> = { light: 180, moderate: 420, heavy: 900 };\\n\\ntype Flake = { x: number; y: number; z: number; r: number; v: number; phase: number; sway: number };\\n\\nexport class Snow implements Effect {\\n  private flakes: Flake[] = [];\\n  private clouds: Clouds;\\n  private w = 0;\\n  private h = 0;\\n  private time = 0;\\n  private sprite = dotSprite(\\\"255,255,255\\\", 32);\\n  constructor(private opts: EffectOptions) {\\n    this.clouds = new Clouds({\\n      color: opts.isDay ? \\\"235,240,247\\\" : \\\"120,135,165\\\",\\n      count: opts.quality >= 2 ? 7 : 4,\\n      top: -0.05,\\n      bottom: 0.25,\\n      speed: 6,\\n      alpha: opts.isDay ? 0.55 : 0.45,\\n      scale: [1.1, 1.9],\\n    });\\n  }\\n  private newFlake(anywhere: boolean): Flake {\\n    const z = Math.random() ** 1.4;\\n    return {\\n      x: rand(-40, this.w + 40),\\n      y: anywhere ? rand(-20, this.h) : rand(-60, -10),\\n      z,\\n      r: 1 + z * 4.5,\\n      v: 22 + z * 70 + (this.opts.intensity === \\\"heavy\\\" ? 30 : 0),\\n      phase: rand(0, Math.PI * 2),\\n      sway: rand(8, 26) * (0.4 + z),\\n    };\\n  }\\n  resize(w: number, h: number) {\\n    this.w = w;\\n    this.h = h;\\n    this.clouds.resize(w, h);\\n    if (this.flakes.length === 0) {\\n      const n = share(this.opts, FULL[this.opts.intensity]!);\\n      for (let i = 0; i < n; i++) this.flakes.push(this.newFlake(true));\\n    }\\n  }\\n  update(dt: number) {\\n    this.time += dt;\\n    this.clouds.update(dt);\\n    const drift = this.opts.intensity === \\\"heavy\\\" ? 38 : 10;\\n    for (let i = 0; i < this.flakes.length; i++) {\\n      const f = this.flakes[i]!;\\n      f.y += f.v * dt;\\n      f.x += (drift * (0.4 + f.z) + Math.cos(this.time * 0.9 + f.phase) * f.sway * 0.9) * dt;\\n      if (f.y > this.h + 10 || f.x > this.w + 50) this.flakes[i] = this.newFlake(false);\\n    }\\n  }\\n  draw(ctx: CanvasRenderingContext2D, alpha: number) {\\n    this.clouds.draw(ctx, alpha);\\n    // Far flakes: plain dots in one path.\\n    ctx.fillStyle = `rgba(255,255,255,${0.55 * alpha})`;\\n    ctx.beginPath();\\n    for (const f of this.flakes) {\\n      if (f.z >= 0.45) continue;\\n      ctx.moveTo(f.x + f.r, f.y);\\n      ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2);\\n    }\\n    ctx.fill();\\n    // Near flakes: soft sprites, larger and brighter the closer they are.\\n    for (const f of this.flakes) {\\n      if (f.z < 0.45) continue;\\n      ctx.globalAlpha = (0.55 + f.z * 0.45) * alpha;\\n      const s = f.r * 3.2;\\n      ctx.drawImage(this.sprite, f.x - s / 2, f.y - s / 2, s, s);\\n    }\\n    ctx.globalAlpha = 1;\\n    // A pale drift of settled snow along the bottom.\\n    const g = ctx.createLinearGradient(0, this.h * 0.86, 0, this.h);\\n    g.addColorStop(0, \\\"rgba(255,255,255,0)\\\");\\n    g.addColorStop(1, `rgba(255,255,255,${(this.opts.isDay ? 0.35 : 0.18) * alpha})`);\\n    ctx.fillStyle = g;\\n    ctx.fillRect(0, this.h * 0.86, this.w, this.h * 0.14);\\n  }\\n  count() {\\n    return this.flakes.length + this.clouds.size;\\n  }\\n}\\n\"}"}}]},"finish_reason":null}]}

