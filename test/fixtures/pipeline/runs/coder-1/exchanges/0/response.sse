data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":41,"function":{"arguments":"{\"path\":\"client/src/scene/common.ts\",\"content\":\"// Shared pieces for the scene effects: the effect contract, random helpers and pre-drawn sprites\\n// (clouds, mist, flakes) so each frame only copies small images instead of building gradients.\\n\\nexport type Intensity = \\\"light\\\" | \\\"moderate\\\" | \\\"heavy\\\";\\n\\nexport type EffectOptions = {\\n  intensity: Intensity;\\n  isDay: boolean;\\n  /** 0 = still frame, 1 = simpler, 2 = reduced, 3 = full. */\\n  quality: number;\\n  /** Reduced motion: hold still, no flashing, no shimmer. */\\n  still: boolean;\\n};\\n\\nexport interface Effect {\\n  resize(w: number, h: number): void;\\n  update(dt: number, t: number): void;\\n  draw(ctx: CanvasRenderingContext2D, alpha: number): void;\\n  /** Moving pieces currently drawn, for the smoothness monitor and checks. */\\n  count(): number;\\n}\\n\\n/** How much of the full particle budget each quality level draws. */\\nexport const QUALITY_SHARE = [0.12, 0.25, 0.55, 1] as const;\\n\\nexport const rand = (a: number, b: number) => a + Math.random() * (b - a);\\nexport const pick = <T>(xs: readonly T[]) => xs[Math.floor(Math.random() * xs.length)]!;\\n\\nexport function share(opts: EffectOptions, full: number) {\\n  return Math.max(1, Math.round(full * QUALITY_SHARE[Math.max(0, Math.min(3, opts.quality))]!));\\n}\\n\\nexport const INTENSITY_SCALE: Record<Intensity, number> = { light: 0.3, moderate: 0.6, heavy: 1 };\\n\\nfunction offscreen(w: number, h: number) {\\n  const c = document.createElement(\\\"canvas\\\");\\n  c.width = w;\\n  c.height = h;\\n  return c;\\n}\\n\\nconst spriteCache = new Map<string, HTMLCanvasElement[]>();\\n\\n/** A few soft cloud shapes in one colour, drawn once and reused. */\\nexport function cloudSprites(color: string, puffAlpha = 0.9): HTMLCanvasElement[] {\\n  const key = `cloud:${color}:${puffAlpha}`;\\n  const hit = spriteCache.get(key);\\n  if (hit) return hit;\\n  const sprites: HTMLCanvasElement[] = [];\\n  for (let s = 0; s < 5; s++) {\\n    const w = 360;\\n    const h = 170;\\n    const c = offscreen(w, h);\\n    const g = c.getContext(\\\"2d\\\")!;\\n    const puffs = 7 + Math.floor(Math.random() * 6);\\n    for (let i = 0; i < puffs; i++) {\\n      const px = rand(70, w - 70);\\n      const py = rand(70, h - 45) - Math.abs(px - w / 2) * 0.12;\\n      const r = rand(34, 62) * (1 - Math.abs(px - w / 2) / w);\\n      const grad = g.createRadialGradient(px, py, 0, px, py, r * 1.35);\\n      grad.addColorStop(0, `rgba(${color},${puffAlpha})`);\\n      grad.addColorStop(0.55, `rgba(${color},${puffAlpha * 0.65})`);\\n      grad.addColorStop(1, `rgba(${color},0)`);\\n      g.fillStyle = grad;\\n      g.beginPath();\\n      g.arc(px, py, r * 1.35, 0, Math.PI * 2);\\n      g.fill();\\n    }\\n    sprites.push(c);\\n  }\\n  spriteCache.set(key, sprites);\\n  return sprites;\\n}\\n\\n/** A wide soft ellipse for fog and haze. */\\nexport function mistSprite(color: string): HTMLCanvasElement {\\n  const key = `mist:${color}`;\\n  const hit = spriteCache.get(key);\\n  if (hit) return hit[0]!;\\n  const w = 512;\\n  const h = 160;\\n  const c = offscreen(w, h);\\n  const g = c.getContext(\\\"2d\\\")!;\\n  g.translate(w / 2, h / 2);\\n  g.scale(1, h / w);\\n  const grad = g.createRadialGradient(0, 0, 0, 0, 0, w / 2);\\n  grad.addColorStop(0, `rgba(${color},0.75)`);\\n  grad.addColorStop(0.5, `rgba(${color},0.4)`);\\n  grad.addColorStop(1, `rgba(${color},0)`);\\n  g.fillStyle = grad;\\n  g.beginPath();\\n  g.arc(0, 0, w / 2, 0, Math.PI * 2);\\n  g.fill();\\n  spriteCache.set(key, [c]);\\n  return c;\\n}\\n\\n/** A soft round dot (snowflake, star glow, heat mote). */\\nexport function dotSprite(color: string, size = 32): HTMLCanvasElement {\\n  const key = `dot:${color}:${size}`;\\n  const hit = spriteCache.get(key);\\n  if (hit) return hit[0]!;\\n  const c = offscreen(size, size);\\n  const g = c.getContext(\\\"2d\\\")!;\\n  const r = size / 2;\\n  const grad = g.createRadialGradient(r, r, 0, r, r, r);\\n  grad.addColorStop(0, `rgba(${color},1)`);\\n  grad.addColorStop(0.45, `rgba(${color},0.85)`);\\n  grad.addColorStop(1, `rgba(${color},0)`);\\n  g.fillStyle = grad;\\n  g.fillRect(0, 0, size, size);\\n  spriteCache.set(key, [c]);\\n  return c;\\n}\\n\\n/** A drifting band of clouds, used by cloudy, rain, storm, snow and wind. */\\nexport class Clouds {\\n  private items: { x: number; y: number; s: number; v: number; img: HTMLCanvasElement; a: number }[] = [];\\n  private w = 0;\\n  private h = 0;\\n  constructor(\\n    private opts: {\\n      color: string;\\n      count: number;\\n      /** Fraction of the screen height the clouds sit in. */\\n      top: number;\\n      bottom: number;\\n      speed: number;\\n      alpha: number;\\n      scale: [number, number];\\n    },\\n  ) {}\\n  resize(w: number, h: number) {\\n    const first = this.items.length === 0;\\n    this.w = w;\\n    this.h = h;\\n    if (!first) return;\\n    const sprites = cloudSprites(this.opts.color);\\n    const n = this.opts.count;\\n    for (let i = 0; i < n; i++) {\\n      const depth = i / Math.max(1, n - 1);\\n      const s = rand(this.opts.scale[0], this.opts.scale[1]) * (0.7 + depth * 0.6) * Math.max(0.7, w / 1400);\\n      this.items.push({\\n        x: rand(-0.2, 1.1) * w,\\n        y: rand(this.opts.top, this.opts.bottom) * h,\\n        s,\\n        v: this.opts.speed * (0.5 + depth),\\n        img: pick(sprites),\\n        a: this.opts.alpha * (0.6 + depth * 0.4),\\n      });\\n    }\\n    // Far (small, slow) first, near (big, fast) on top.\\n    this.items.sort((a, b) => a.s - b.s);\\n  }\\n  update(dt: number) {\\n    for (const c of this.items) {\\n      c.x += c.v * dt;\\n      const width = c.img.width * c.s;\\n      if (c.v > 0 && c.x > this.w + 20) {\\n        c.x = -width - rand(0, 200);\\n        c.y = rand(this.opts.top, this.opts.bottom) * this.h;\\n      }\\n    }\\n  }\\n  draw(ctx: CanvasRenderingContext2D, alpha: number) {\\n    for (const c of this.items) {\\n      ctx.globalAlpha = c.a * alpha;\\n      ctx.drawImage(c.img, c.x, c.y - (c.img.height * c.s) / 2, c.img.width * c.s, c.img.height * c.s);\\n    }\\n    ctx.globalAlpha = 1;\\n  }\\n  get size() {\\n    return this.items.length;\\n  }\\n}\\n\"}"}}]},"finish_reason":null}]}

