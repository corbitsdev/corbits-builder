data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":24,"function":{"arguments":"{\"path\":\"client/src/lib/storage.ts\",\"content\":\"import { useSyncExternalStore } from \\\"react\\\";\\nimport { z } from \\\"zod\\\";\\nimport { Forecast } from \\\"@app/shared\\\";\\nimport { defaultUnit } from \\\"./format.ts\\\";\\n\\n// Everything the app remembers lives in this browser's localStorage: saved cities, the unit, the\\n// simpler-effects choice, the compare picks, the device location and the last weather seen per\\n// place. Each value is checked when read; anything damaged is dropped instead of breaking the app.\\n\\nexport const SavedCity = z.object({\\n  id: z.string(),\\n  name: z.string(),\\n  admin1: z.string().optional(),\\n  country: z.string().optional(),\\n  lat: z.number(),\\n  lon: z.number(),\\n});\\nexport type SavedCity = z.infer<typeof SavedCity>;\\n\\nexport const MY_LOCATION_ID = \\\"here\\\";\\n\\nconst MyLocation = z.object({\\n  lat: z.number(),\\n  lon: z.number(),\\n  name: z.string().nullable(),\\n  admin1: z.string().nullable(),\\n  country: z.string().nullable(),\\n  at: z.number(),\\n});\\nexport type MyLocation = z.infer<typeof MyLocation>;\\n\\nconst Settings = z.object({\\n  unit: z.enum([\\\"c\\\", \\\"f\\\"]),\\n  simpler: z.boolean(),\\n  /** \\\"unknown\\\" until the browser has been asked once. */\\n  location: z.enum([\\\"unknown\\\", \\\"granted\\\", \\\"denied\\\"]),\\n  lastPlace: z.string().optional(),\\n});\\ntype Settings = z.infer<typeof Settings>;\\n\\nconst LastScene = z.object({ key: z.string(), intensity: z.enum([\\\"light\\\", \\\"moderate\\\", \\\"heavy\\\"]) });\\nexport type LastScene = z.infer<typeof LastScene>;\\n\\nconst Cached = z.object({ at: z.number(), data: Forecast });\\nexport type Cached = z.infer<typeof Cached>;\\n\\ntype State = {\\n  cities: SavedCity[];\\n  settings: Settings;\\n  compare: string[];\\n  here: MyLocation | null;\\n  lastScene: LastScene | null;\\n};\\n\\nconst KEYS = {\\n  cities: \\\"aw.cities\\\",\\n  settings: \\\"aw.settings\\\",\\n  compare: \\\"aw.compare\\\",\\n  here: \\\"aw.here\\\",\\n  lastScene: \\\"aw.scene\\\",\\n} as const;\\n\\nfunction read<T>(key: string, schema: z.ZodType<T>, fallback: T): T {\\n  try {\\n    const raw = localStorage.getItem(key);\\n    if (raw == null) return fallback;\\n    const parsed = schema.safeParse(JSON.parse(raw));\\n    if (parsed.success) return parsed.data;\\n    localStorage.removeItem(key);\\n  } catch {\\n    // Storage blocked or damaged: start fresh.\\n  }\\n  return fallback;\\n}\\n\\nfunction write(key: string, value: unknown) {\\n  try {\\n    if (value === null) localStorage.removeItem(key);\\n    else localStorage.setItem(key, JSON.stringify(value));\\n  } catch {\\n    // Full or blocked storage: the app keeps working for this visit.\\n  }\\n}\\n\\nfunction load(): State {\\n  return {\\n    cities: read(KEYS.cities, z.array(SavedCity), []),\\n    settings: read(KEYS.settings, Settings, { unit: defaultUnit(), simpler: false, location: \\\"unknown\\\" }),\\n    compare: read(KEYS.compare, z.array(z.string()), []),\\n    here: read(KEYS.here, MyLocation.nullable(), null),\\n    lastScene: read(KEYS.lastScene, LastScene.nullable(), null),\\n  };\\n}\\n\\nlet state = load();\\nconst listeners = new Set<() => void>();\\n\\nfunction set<K extends keyof State>(key: K, value: State[K]) {\\n  state = { ...state, [key]: value };\\n  write(KEYS[key], value);\\n  for (const l of listeners) l();\\n}\\n\\n// Another tab changed something: pick it up.\\naddEventListener(\\\"storage\\\", (e) => {\\n  if (e.key && Object.values(KEYS).includes(e.key as never)) {\\n    state = load();\\n    for (const l of listeners) l();\\n  }\\n});\\n\\nconst subscribe = (l: () => void) => {\\n  listeners.add(l);\\n  return () => listeners.delete(l);\\n};\\n\\nexport function useStore<T>(pick: (s: State) => T): T {\\n  return useSyncExternalStore(subscribe, () => pick(state));\\n}\\nexport const getState = () => state;\\n\\n/** Same place = same coordinates rounded to about 1 km. */\\nexport const cityId = (lat: number, lon: number) => `${lat.toFixed(2)},${lon.toFixed(2)}`;\\n\\nexport const store = {\\n  setUnit: (unit: \\\"c\\\" | \\\"f\\\") => set(\\\"settings\\\", { ...state.settings, unit }),\\n  setSimpler: (simpler: boolean) => set(\\\"settings\\\", { ...state.settings, simpler }),\\n  setLocationState: (location: Settings[\\\"location\\\"]) => set(\\\"settings\\\", { ...state.settings, location }),\\n  setLastPlace: (lastPlace: string | undefined) => {\\n    if (state.settings.lastPlace !== lastPlace) set(\\\"settings\\\", { ...state.settings, lastPlace });\\n  },\\n  setHere: (here: MyLocation | null) => set(\\\"here\\\", here),\\n  setLastScene: (scene: LastScene | null) => {\\n    if (scene?.key !== state.lastScene?.key || scene?.intensity !== state.lastScene?.intensity) set(\\\"lastScene\\\", scene);\\n  },\\n  isSaved: (id: string) => state.cities.some((c) => c.id === id),\\n  /** Adds a city unless it's already saved. Returns false for a duplicate. */\\n  save(city: Omit<SavedCity, \\\"id\\\">, index?: number): boolean {\\n    const id = cityId(city.lat, city.lon);\\n    if (state.cities.some((c) => c.id === id)) return false;\\n    const next = [...state.cities];\\n    next.splice(index ?? next.length, 0, { ...city, id });\\n    set(\\\"cities\\\", next);\\n    return true;\\n  },\\n  remove(id: string): { city: SavedCity; index: number; picked: boolean } | null {\\n    const index = state.cities.findIndex((c) => c.id === id);\\n    if (index < 0) return null;\\n    const city = state.cities[index]!;\\n    const picked = state.compare.includes(id);\\n    set(\\\"cities\\\", state.cities.filter((c) => c.id !== id));\\n    if (picked) set(\\\"compare\\\", state.compare.filter((c) => c !== id));\\n    if (state.settings.lastPlace === id) set(\\\"settings\\\", { ...state.settings, lastPlace: undefined });\\n    return { city, index, picked };\\n  },\\n  restore(removed: { city: SavedCity; index: number; picked: boolean }) {\\n    if (state.cities.some((c) => c.id === removed.city.id)) return;\\n    const next = [...state.cities];\\n    next.splice(Math.min(removed.index, next.length), 0, removed.city);\\n    set(\\\"cities\\\", next);\\n    if (removed.picked && state.compare.length < 4) set(\\\"compare\\\", [...state.compare, removed.city.id]);\\n  },\\n  setCompare: (ids: string[]) => set(\\\"compare\\\", ids.slice(0, 4)),\\n};\\n\\n// The last weather seen per place, for offline use.\\nconst wxKey = (id: string) => `aw.wx.${id}`;\\nexport function readCached(id: string): Cached | null {\\n  return read(wxKey(id), Cached.nullable(), null);\\n}\\nexport function writeCached(id: string, data: Forecast) {\\n  write(wxKey(id), { at: Date.now(), data });\\n}\\n\"}"}}]},"finish_reason":null}]}

