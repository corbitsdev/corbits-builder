data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":13,"function":{"arguments":"{\"path\":\"client/src/components/layout.tsx\",\"content\":\"import { useEffect, useRef, useState } from \\\"react\\\";\\nimport { Link, Outlet, useLocation } from \\\"react-router\\\";\\nimport { Bookmark, Columns2, Home, Menu, Search, SlidersVertical, X } from \\\"lucide-react\\\";\\nimport { useQueryClient } from \\\"@tanstack/react-query\\\";\\nimport { Button, Sidebar, SidebarContent, SidebarItem, TopBar, TopBarActions } from \\\"@corbits/react-ui\\\";\\nimport { SceneLayer } from \\\"../scene/SceneLayer.tsx\\\";\\n\\nconst NAV = [\\n  { to: \\\"/\\\", label: \\\"Home\\\", icon: <Home />, testId: \\\"nav-home-link\\\" },\\n  { to: \\\"/search\\\", label: \\\"Search\\\", icon: <Search />, testId: \\\"nav-search-link\\\" },\\n  { to: \\\"/cities\\\", label: \\\"Saved cities\\\", icon: <Bookmark />, testId: \\\"nav-cities-link\\\" },\\n  { to: \\\"/compare\\\", label: \\\"Compare\\\", icon: <Columns2 />, testId: \\\"nav-compare-link\\\" },\\n  { to: \\\"/settings\\\", label: \\\"Settings\\\", icon: <SlidersVertical />, testId: \\\"nav-settings-link\\\" },\\n];\\n\\nconst AWAY_MS = 15 * 60_000;\\n\\n/** Coming back after 15 minutes or more away refreshes the weather without a tap. */\\nfunction useReturnRefresh() {\\n  const client = useQueryClient();\\n  useEffect(() => {\\n    let hiddenAt: number | null = document.hidden ? Date.now() : null;\\n    const onChange = () => {\\n      if (document.hidden) {\\n        hiddenAt = Date.now();\\n        return;\\n      }\\n      if (hiddenAt !== null && Date.now() - hiddenAt >= AWAY_MS) {\\n        void client.invalidateQueries({ queryKey: [\\\"forecast\\\"] });\\n      }\\n      hiddenAt = null;\\n    };\\n    document.addEventListener(\\\"visibilitychange\\\", onChange);\\n    return () => document.removeEventListener(\\\"visibilitychange\\\", onChange);\\n  }, [client]);\\n}\\n\\nexport function Layout() {\\n  const { pathname } = useLocation();\\n  const [open, setOpen] = useState(false);\\n  const navRef = useRef<HTMLElement>(null);\\n  const menuRef = useRef<HTMLButtonElement>(null);\\n  useReturnRefresh();\\n\\n  useEffect(() => {\\n    setOpen(false);\\n    window.scrollTo(0, 0);\\n  }, [pathname]);\\n\\n  useEffect(() => {\\n    if (!open) return;\\n    navRef.current?.querySelector<HTMLElement>(\\\"a\\\")?.focus();\\n    const onKey = (e: KeyboardEvent) => {\\n      if (e.key === \\\"Escape\\\") {\\n        setOpen(false);\\n        menuRef.current?.focus();\\n      }\\n    };\\n    addEventListener(\\\"keydown\\\", onKey);\\n    return () => removeEventListener(\\\"keydown\\\", onKey);\\n  }, [open]);\\n\\n  const active = (to: string) => (to === \\\"/\\\" ? pathname === \\\"/\\\" : pathname.startsWith(to));\\n\\n  return (\\n    <div className=\\\"flex min-h-dvh flex-col text-foreground\\\">\\n      <SceneLayer />\\n      <TopBar className=\\\"app-bar\\\">\\n        <Button\\n          ref={menuRef}\\n          variant=\\\"ghost\\\"\\n          size=\\\"icon\\\"\\n          className=\\\"menu-button\\\"\\n          aria-label={open ? \\\"Close menu\\\" : \\\"Menu\\\"}\\n          aria-expanded={open}\\n          aria-controls=\\\"app-nav\\\"\\n          onClick={() => setOpen((o) => !o)}\\n          data-testid=\\\"menu-button\\\"\\n        >\\n          {open ? <X /> : <Menu />}\\n        </Button>\\n        <Link to=\\\"/\\\" className=\\\"app-name\\\" data-testid=\\\"app-name-link\\\">\\n          Animated Weather\\n        </Link>\\n        <TopBarActions>\\n          <Button asChild variant=\\\"ghost\\\" size=\\\"icon\\\" className=\\\"top-search\\\">\\n            <Link to=\\\"/search\\\" aria-label=\\\"Search for a city\\\" data-testid=\\\"top-search-link\\\">\\n              <Search />\\n            </Link>\\n          </Button>\\n        </TopBarActions>\\n      </TopBar>\\n      <div className=\\\"scrim\\\" data-open={open} onClick={() => setOpen(false)} aria-hidden=\\\"true\\\" />\\n      <Sidebar ref={navRef} id=\\\"app-nav\\\" className=\\\"app-nav\\\" data-open={open}>\\n        <SidebarContent>\\n          <nav aria-label=\\\"Main\\\" className=\\\"px-2\\\">\\n            <ul className=\\\"flex flex-col gap-0.5\\\">\\n              {NAV.map((n) => (\\n                <SidebarItem key={n.to} asChild active={active(n.to)} icon={n.icon}>\\n                  <Link to={n.to} data-testid={n.testId} onClick={() => setOpen(false)}>\\n                    {n.label}\\n                  </Link>\\n                </SidebarItem>\\n              ))}\\n            </ul>\\n          </nav>\\n        </SidebarContent>\\n        <p className=\\\"border-t border-border p-4 text-xs text-muted-foreground\\\">\\n          Weather and city search by Open-Meteo.\\n        </p>\\n      </Sidebar>\\n      <div className=\\\"app-main-wrap flex-1\\\">\\n        <main className=\\\"app-main\\\">\\n          <Outlet />\\n        </main>\\n      </div>\\n    </div>\\n  );\\n}\\n\"}"}}]},"finish_reason":null}]}

