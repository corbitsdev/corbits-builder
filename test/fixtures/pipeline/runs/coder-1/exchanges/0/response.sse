data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":50,"function":{"arguments":"{\"path\":\"client/src/styles.css\",\"content\":\"@import \\\"tailwindcss\\\";\\n@import \\\"@corbits/react-ui/theme.css\\\";\\n\\n/* ===== Design tokens (DESIGN.md, Adaptive weather-driven) ===== */\\n:root {\\n  --background: #eef2f6;\\n  --foreground: #121820;\\n  --card: rgb(255 255 255 / 0.82);\\n  --card-foreground: #121820;\\n  --popover: #ffffff;\\n  --popover-foreground: #121820;\\n  --primary: #2f5b8a;\\n  --primary-foreground: #ffffff;\\n  --primary-active: #264b72;\\n  --secondary: rgb(18 24 32 / 0.06);\\n  --secondary-foreground: #121820;\\n  --muted: rgb(18 24 32 / 0.06);\\n  --muted-foreground: #46505e;\\n  --accent: rgb(18 24 32 / 0.08);\\n  --accent-foreground: #121820;\\n  --destructive: #a8322a;\\n  --destructive-foreground: #ffffff;\\n  --success: #cfe3d3;\\n  --success-foreground: #121820;\\n  --border: rgb(18 24 32 / 0.12);\\n  --input: #7b8594;\\n  --ring: #2f5b8a;\\n  --radius: 0.875rem;\\n  --radius-sm: calc(var(--radius) - 4px);\\n  --radius-lg: calc(var(--radius) + 4px);\\n  --shadow-popover: 0 12px 32px rgb(10 20 40 / 0.16), 0 1px 3px rgb(10 20 40 / 0.08);\\n  --font-sans: system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial, sans-serif;\\n  --font-mono: \\\"Space Mono\\\", \\\"Fira Code\\\", Monaco, Consolas, monospace;\\n  --ease-out: cubic-bezier(0.23, 1, 0.32, 1);\\n  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);\\n  --duration-micro: 150ms;\\n  --duration-standard: 200ms;\\n  --duration-large: 300ms;\\n  color-scheme: light;\\n}\\n.dark {\\n  --background: #0b0f24;\\n  --foreground: #eef1fa;\\n  --card: rgb(18 23 52 / 0.74);\\n  --card-foreground: #eef1fa;\\n  --popover: #171c3d;\\n  --popover-foreground: #eef1fa;\\n  --primary: #a5b4fc;\\n  --primary-foreground: #0b1030;\\n  --primary-active: #c3cdfd;\\n  --secondary: rgb(255 255 255 / 0.1);\\n  --secondary-foreground: #eef1fa;\\n  --muted: rgb(255 255 255 / 0.08);\\n  --muted-foreground: #b6bdd6;\\n  --accent: rgb(255 255 255 / 0.12);\\n  --accent-foreground: #eef1fa;\\n  --destructive: #f08a80;\\n  --destructive-foreground: #0b0f24;\\n  --success: #2f5a45;\\n  --success-foreground: #eef1fa;\\n  --border: rgb(255 255 255 / 0.14);\\n  --input: #8b93b3;\\n  --ring: #a5b4fc;\\n  --shadow-popover: 0 12px 32px rgb(0 0 0 / 0.5);\\n  color-scheme: dark;\\n}\\n@media (prefers-color-scheme: dark) {\\n  :root:not(.dark):not(.light) {\\n    --background: #0b0f24;\\n    --foreground: #eef1fa;\\n    --card: rgb(18 23 52 / 0.74);\\n    --card-foreground: #eef1fa;\\n    --popover: #171c3d;\\n    --popover-foreground: #eef1fa;\\n    --primary: #a5b4fc;\\n    --primary-foreground: #0b1030;\\n    --primary-active: #c3cdfd;\\n    --secondary: rgb(255 255 255 / 0.1);\\n    --secondary-foreground: #eef1fa;\\n    --muted: rgb(255 255 255 / 0.08);\\n    --muted-foreground: #b6bdd6;\\n    --accent: rgb(255 255 255 / 0.12);\\n    --accent-foreground: #eef1fa;\\n    --destructive: #f08a80;\\n    --destructive-foreground: #0b0f24;\\n    --success: #2f5a45;\\n    --success-foreground: #eef1fa;\\n    --border: rgb(255 255 255 / 0.14);\\n    --input: #8b93b3;\\n    --ring: #a5b4fc;\\n    --shadow-popover: 0 12px 32px rgb(0 0 0 / 0.5);\\n    color-scheme: dark;\\n  }\\n}\\n\\n/* Kit tokens the design leaves implicit: emphasis text follows the scene's accent. */\\n:root {\\n  --primary-emphasis: var(--primary);\\n  --border-strong: var(--input);\\n}\\n\\n/* ===== Sky colours per condition and day/night (also tint chips, bands and swatches) ===== */\\n[data-wx=\\\"clear-day\\\"] { --sky-a: #3d7fd1; --sky-b: #9cc9f2; }\\n[data-wx=\\\"hot-day\\\"] { --sky-a: #e7801c; --sky-b: #f9d58a; }\\n[data-wx=\\\"cloudy-day\\\"] { --sky-a: #7d8ea1; --sky-b: #c9d3dd; }\\n[data-wx=\\\"rain-day\\\"] { --sky-a: #3f5876; --sky-b: #8ea2b7; }\\n[data-wx=\\\"storm-day\\\"] { --sky-a: #2a2e44; --sky-b: #5b607b; }\\n[data-wx=\\\"snow-day\\\"] { --sky-a: #8fa6bf; --sky-b: #dce5ee; }\\n[data-wx=\\\"wind-day\\\"] { --sky-a: #4f86ad; --sky-b: #bcd6e6; }\\n[data-wx=\\\"fog-day\\\"] { --sky-a: #9aa1a8; --sky-b: #dde1e5; }\\n[data-wx=\\\"clear-night\\\"] { --sky-a: #070b26; --sky-b: #283070; }\\n[data-wx=\\\"hot-night\\\"] { --sky-a: #1d1736; --sky-b: #5a2f45; }\\n[data-wx=\\\"cloudy-night\\\"] { --sky-a: #161c29; --sky-b: #3a4356; }\\n[data-wx=\\\"rain-night\\\"] { --sky-a: #0c1626; --sky-b: #2a3b55; }\\n[data-wx=\\\"storm-night\\\"] { --sky-a: #07071a; --sky-b: #2b2445; }\\n[data-wx=\\\"snow-night\\\"] { --sky-a: #18263f; --sky-b: #4a5f80; }\\n[data-wx=\\\"wind-night\\\"] { --sky-a: #0b1f30; --sky-b: #2c4b60; }\\n[data-wx=\\\"fog-night\\\"] { --sky-a: #1b1f24; --sky-b: #40464e; }\\n[data-wx=\\\"calm\\\"] { --sky-a: #cfd9e4; --sky-b: #f3f6f9; }\\n\\n/* ===== Palettes: the shown scene sets the whole app's surfaces and accent ===== */\\nhtml[data-wx$=\\\"-day\\\"],\\nhtml[data-wx=\\\"calm\\\"] {\\n  --background: #ffffff;\\n  --foreground: #121820;\\n  --card: rgb(255 255 255 / 0.82);\\n  --card-foreground: #121820;\\n  --popover: #ffffff;\\n  --popover-foreground: #121820;\\n  --muted: rgb(18 24 32 / 0.06);\\n  --muted-foreground: #434d5b;\\n  --accent: rgb(18 24 32 / 0.08);\\n  --accent-foreground: #121820;\\n  --border: rgb(18 24 32 / 0.12);\\n  --input: #7b8594;\\n  --pop: #1a5288;\\n  color-scheme: light;\\n}\\nhtml[data-wx$=\\\"-night\\\"] {\\n  --background: #0e1330;\\n  --foreground: #eef1fa;\\n  --card: rgb(14 18 40 / 0.74);\\n  --card-foreground: #eef1fa;\\n  --popover: #171c3d;\\n  --popover-foreground: #eef1fa;\\n  --muted: rgb(255 255 255 / 0.08);\\n  --muted-foreground: #b6bdd6;\\n  --accent: rgb(255 255 255 / 0.12);\\n  --accent-foreground: #eef1fa;\\n  --border: rgb(255 255 255 / 0.14);\\n  --input: #8b93b3;\\n  --pop: #9cc7f0;\\n  color-scheme: dark;\\n}\\nhtml[data-wx=\\\"clear-day\\\"] { --primary: #1d5fb3; --primary-active: #174e94; --ring: #1d5fb3; --primary-foreground: #fff; }\\nhtml[data-wx=\\\"hot-day\\\"] { --primary: #a54a08; --primary-active: #8a3e06; --ring: #a54a08; --primary-foreground: #fff; }\\nhtml[data-wx=\\\"cloudy-day\\\"] { --primary: #3f5872; --primary-active: #33485e; --ring: #3f5872; --primary-foreground: #fff; }\\nhtml[data-wx=\\\"rain-day\\\"] { --primary: #2f5b8a; --primary-active: #264b72; --ring: #2f5b8a; --primary-foreground: #fff; }\\nhtml[data-wx=\\\"storm-day\\\"] { --primary: #4f46a8; --primary-active: #423a90; --ring: #4f46a8; --primary-foreground: #fff; }\\nhtml[data-wx=\\\"snow-day\\\"] { --primary: #2563a8; --primary-active: #1e5290; --ring: #2563a8; --primary-foreground: #fff; }\\nhtml[data-wx=\\\"wind-day\\\"] { --primary: #0e6a82; --primary-active: #0b586c; --ring: #0e6a82; --primary-foreground: #fff; }\\nhtml[data-wx=\\\"fog-day\\\"] { --primary: #4b5563; --primary-active: #3d4651; --ring: #4b5563; --primary-foreground: #fff; }\\nhtml[data-wx=\\\"calm\\\"] { --primary: #2f5b8a; --primary-active: #264b72; --ring: #2f5b8a; --primary-foreground: #fff; }\\nhtml[data-wx=\\\"clear-night\\\"] { --primary: #a5b4fc; --primary-active: #c3cdfd; --ring: #a5b4fc; --primary-foreground: #0b1030; }\\nhtml[data-wx=\\\"hot-night\\\"] { --primary: #f6b44b; --primary-active: #f8c56f; --ring: #f6b44b; --primary-foreground: #1d1736; }\\nhtml[data-wx=\\\"cloudy-night\\\"] { --primary: #9fb3cf; --primary-active: #b8c8de; --ring: #9fb3cf; --primary-foreground: #11151f; }\\nhtml[data-wx=\\\"rain-night\\\"] { --primary: #7fa9db; --primary-active: #9dbde4; --ring: #7fa9db; --primary-foreground: #0c1626; }\\nhtml[data-wx=\\\"storm-night\\\"] { --primary: #b2a6ff; --primary-active: #c9c0ff; --ring: #b2a6ff; --primary-foreground: #0e0b22; }\\nhtml[data-wx=\\\"snow-night\\\"] { --primary: #bcd7f5; --primary-active: #d3e5f8; --ring: #bcd7f5; --primary-foreground: #18263f; }\\nhtml[data-wx=\\\"wind-night\\\"] { --primary: #6cc6dc; --primary-active: #8fd4e5; --ring: #6cc6dc; --primary-foreground: #0b1f30; }\\nhtml[data-wx=\\\"fog-night\\\"] { --primary: #c0c7cf; --primary-active: #d4d9df; --ring: #c0c7cf; --primary-foreground: #1b1f24; }\\n\\n/* ===== Base ===== */\\nhtml {\\n  scrollbar-gutter: stable;\\n}\\nbody {\\n  margin: 0;\\n  background: var(--background);\\n  color: var(--foreground);\\n  font: 400 14px/20px var(--font-sans);\\n  transition: color var(--duration-large) var(--ease-out);\\n}\\nh1, h2, p { margin: 0; }\\n.sr {\\n  position: absolute;\\n  width: 1px;\\n  height: 1px;\\n  overflow: hidden;\\n  clip: rect(0 0 0 0);\\n  white-space: nowrap;\\n}\\n\\n/* ===== Scene: full screen, behind everything ===== */\\n.scene {\\n  position: fixed;\\n  inset: 0;\\n  z-index: -1;\\n  overflow: hidden;\\n  pointer-events: none;\\n}\\n.scene-sky {\\n  position: absolute;\\n  inset: 0;\\n  background: var(--sky-a);\\n  box-shadow: inset 0 -50vh 50vh -10vh var(--sky-b);\\n  animation: scene-in 1200ms var(--ease-out) both;\\n}\\n.scene-canvas {\\n  position: absolute;\\n  inset: 0;\\n  width: 100%;\\n  height: 100%;\\n  animation: scene-in 1200ms var(--ease-out) both;\\n}\\n@keyframes scene-in { from { opacity: 0; } }\\n@media (prefers-reduced-motion: reduce) {\\n  .scene-sky, .scene-canvas { animation: none; }\\n}\\n\\n/* ===== Frosted panels with subtle depth ===== */\\n[data-slot=\\\"card\\\"],\\n.frost,\\n[data-slot=\\\"sidebar\\\"],\\n[data-slot=\\\"top-bar\\\"],\\n[role=\\\"dialog\\\"],\\n[data-sonner-toast] {\\n  -webkit-backdrop-filter: blur(18px) saturate(1.3);\\n  backdrop-filter: blur(18px) saturate(1.3);\\n}\\n[data-slot=\\\"card\\\"] {\\n  border-radius: var(--radius-lg);\\n  box-shadow: 0 1px 2px rgb(10 20 40 / 0.06), 0 10px 30px rgb(10 20 40 / 0.1);\\n}\\n/* On the weakest devices blur is costly; panels turn more solid instead. */\\nhtml[data-lite=\\\"true\\\"] [data-slot=\\\"card\\\"],\\nhtml[data-lite=\\\"true\\\"] [data-slot=\\\"sidebar\\\"],\\nhtml[data-lite=\\\"true\\\"] [data-slot=\\\"top-bar\\\"] {\\n  -webkit-backdrop-filter: none;\\n  backdrop-filter: none;\\n}\\n\\n/* ===== App shell ===== */\\n.app-bar {\\n  position: sticky;\\n  top: 0;\\n  z-index: 30;\\n  background: var(--card);\\n  color: var(--card-foreground);\\n}\\n.app-bar .app-name { font-weight: 600; font-size: 16px; text-decoration: none; color: inherit; }\\n.app-nav {\\n  position: fixed;\\n  top: 56px;\\n  bottom: 0;\\n  left: 0;\\n  z-index: 20;\\n  width: 240px;\\n  height: auto;\\n}\\n.app-nav [data-slot=\\\"sidebar-item\\\"][aria-current=\\\"page\\\"] {\\n  background: var(--muted);\\n  color: var(--foreground);\\n}\\n.app-main {\\n  max-width: 1200px;\\n  margin: 0 auto;\\n  padding: 24px 16px 48px;\\n}\\n.menu-button { display: none; }\\n.scrim { display: none; }\\n@media (min-width: 640px) {\\n  .app-main { padding: 32px 24px 64px; }\\n}\\n@media (min-width: 768px) {\\n  .app-main-wrap { margin-left: 240px; }\\n  .top-search { display: none; }\\n}\\n@media (min-width: 1024px) {\\n  .app-main { padding-inline: 32px; }\\n}\\n@media (max-width: 767px) {\\n  .menu-button { display: inline-flex; }\\n  .app-nav {\\n    width: min(280px, 85vw);\\n    box-shadow: var(--shadow-popover);\\n    transform: translateX(-105%);\\n    visibility: hidden;\\n    transition: transform var(--duration-large) var(--ease-out), visibility 0s linear var(--duration-large);\\n  }\\n  .app-nav[data-open=\\\"true\\\"] {\\n    transform: none;\\n    visibility: visible;\\n    transition: transform var(--duration-large) var(--ease-out);\\n  }\\n  .scrim[data-open=\\\"true\\\"] {\\n    display: block;\\n    position: fixed;\\n    inset: 56px 0 0 0;\\n    z-index: 19;\\n    background: rgb(0 0 0 / 0.3);\\n  }\\n}\\n.app-main h1.page-title { font-size: 30px; line-height: 36px; font-weight: 600; letter-spacing: -0.01em; text-wrap: balance; }\\n.screen-header {\\n  display: flex;\\n  flex-wrap: wrap;\\n  align-items: center;\\n  justify-content: space-between;\\n  gap: 16px;\\n}\\n.narrow { max-width: 760px; margin-inline: auto; }\\n.stack { display: flex; flex-direction: column; gap: 16px; }\\n.row { display: flex; align-items: center; gap: 8px; }\\n.wrap { flex-wrap: wrap; }\\n.muted { color: var(--muted-foreground); }\\n.small { font-size: 12px; line-height: 16px; }\\n.label {\\n  font-size: 12px;\\n  line-height: 16px;\\n  font-weight: 600;\\n  letter-spacing: 0.08em;\\n  text-transform: uppercase;\\n  color: var(--muted-foreground);\\n}\\n.show-sm { display: block; }\\n.hide-sm { display: none; }\\n@media (min-width: 640px) {\\n  .show-sm { display: none; }\\n  .hide-sm { display: inline; }\\n}\\n\\n/* Kit badges in sentence case where they carry words (scene, counts). */\\n.badge-plain { text-transform: none; letter-spacing: 0; font-size: 12px; line-height: 16px; padding: 2px 8px; }\\n.badge-warning {\\n  border-color: color-mix(in srgb, var(--primary) 40%, transparent);\\n  background: color-mix(in srgb, var(--primary) 12%, transparent);\\n  color: var(--foreground);\\n}\\n\\n/* °C / °F */\\n.unit-toggle {\\n  display: inline-flex;\\n  padding: 3px;\\n  gap: 2px;\\n  border: 1px solid var(--border);\\n  border-radius: 999px;\\n  background: var(--muted);\\n}\\n.unit-toggle button { border: 0; min-height: 32px; padding: 4px 12px; font-size: 14px; }\\n.unit-toggle button[aria-pressed=\\\"false\\\"] { color: var(--muted-foreground); background: transparent; box-shadow: none; }\\n.unit-toggle button[aria-pressed=\\\"true\\\"] { background: var(--popover); color: var(--foreground); }\\n\\n/* Notices (offline, error, permission) */\\n.notice { display: flex; flex-direction: row; align-items: flex-start; gap: 12px; padding: 16px; border-left: 4px solid var(--primary); }\\n.notice-error { border-left-color: var(--destructive); }\\n\\n/* ===== Home: places panel + main view ===== */\\n.wx-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }\\n.wx-main, .places { min-width: 0; }\\n@media (min-width: 1200px) {\\n  .wx-layout { grid-template-columns: 280px minmax(0, 1fr); align-items: start; gap: 24px; }\\n  .places { position: sticky; top: 80px; }\\n}\\n.places { gap: 12px; padding: 16px; }\\n.search-entry {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  min-height: 44px;\\n  padding: 0 12px;\\n  border: 1px solid var(--input);\\n  border-radius: var(--radius);\\n  background: var(--popover);\\n  color: var(--muted-foreground);\\n  font-size: 16px;\\n  text-decoration: none;\\n}\\n.place-list {\\n  list-style: none;\\n  margin: 0;\\n  padding: 2px 2px 6px;\\n  display: flex;\\n  gap: 8px;\\n  overflow-x: auto;\\n  scroll-snap-type: x mandatory;\\n}\\n.place-list > li { flex: 0 0 auto; scroll-snap-align: start; }\\n@media (min-width: 1200px) {\\n  .places .place-list { flex-direction: column; overflow: visible; padding: 0; }\\n}\\n.place {\\n  display: flex;\\n  align-items: center;\\n  gap: 10px;\\n  min-width: 196px;\\n  padding: 8px 12px 8px 8px;\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius);\\n  color: inherit;\\n  text-decoration: none;\\n  transition: background-color var(--duration-micro) var(--ease-out);\\n}\\n@media (hover: hover) and (pointer: fine) {\\n  .place:hover { background: var(--muted); }\\n}\\n.place[aria-current=\\\"true\\\"] { border-color: var(--primary); box-shadow: inset 0 0 0 1px var(--primary); background: var(--muted); }\\n.place-text { display: grid; line-height: 18px; min-width: 0; }\\n.place-text > * { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n.place-temp { font-size: 20px; font-weight: 600; font-variant-numeric: tabular-nums; }\\n.place-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); overflow: visible; scroll-snap-type: none; }\\n.place-grid .place { min-width: 0; }\\n.wx-chip {\\n  display: inline-grid;\\n  place-items: center;\\n  width: 36px;\\n  height: 36px;\\n  flex: none;\\n  border-radius: 50%;\\n  background: var(--sky-a, #8ea2b7);\\n  color: #fff;\\n  box-shadow: inset 0 -12px 12px -4px var(--sky-b, #cfd9e4), inset 0 0 0 1px rgb(0 0 0 / 0.12);\\n}\\n.wx-chip svg { width: 20px; height: 20px; filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.45)); }\\n.wx-chip-lg { width: 64px; height: 64px; }\\n.wx-chip-lg svg { width: 32px; height: 32px; }\\n\\n/* Current conditions */\\n.sub { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }\\n.hero-top { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }\\n.hero-icon { width: 72px; height: 72px; stroke-width: 1.25; flex: none; }\\n.temp {\\n  font-size: clamp(64px, 14vw, 96px);\\n  line-height: 1;\\n  font-weight: 250;\\n  letter-spacing: -0.04em;\\n  font-variant-numeric: tabular-nums;\\n}\\n.cond { font-size: 20px; line-height: 28px; font-weight: 600; }\\n.stats { display: grid; gap: 12px; grid-template-columns: repeat(2, minmax(0, 1fr)); }\\n@media (min-width: 480px) {\\n  .stats { grid-template-columns: repeat(auto-fit, minmax(132px, 1fr)); }\\n}\\n.stat {\\n  display: grid;\\n  gap: 6px;\\n  align-content: start;\\n  padding: 16px;\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius-lg);\\n  background: var(--muted);\\n  min-width: 0;\\n}\\n.stat > :first-child { color: var(--muted-foreground); font-size: 10px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; }\\n.stat > :nth-child(2) { font-size: 24px; line-height: 1.1; font-weight: 600; font-variant-numeric: tabular-nums; }\\n.stat > small { color: var(--muted-foreground); font-size: 12px; line-height: 16px; }\\n.hero-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }\\n.switch-label { gap: 10px; cursor: pointer; font-weight: 500; }\\n\\n/* 24-hour strip */\\n.hours {\\n  list-style: none;\\n  margin: 0;\\n  padding: 0 0 6px;\\n  display: flex;\\n  gap: 4px;\\n  overflow-x: auto;\\n  scroll-snap-type: x proximity;\\n}\\n.hours > li {\\n  position: relative;\\n  flex: 0 0 64px;\\n  display: grid;\\n  justify-items: center;\\n  gap: 6px;\\n  padding: 10px 4px;\\n  border-radius: var(--radius);\\n  scroll-snap-align: start;\\n  text-align: center;\\n}\\n.hours > li:first-child { background: var(--muted); font-weight: 600; }\\n.hours b { font-size: 16px; font-variant-numeric: tabular-nums; }\\n.hours svg { width: 20px; height: 20px; }\\n.pop { color: var(--pop, #1f5f99); font-size: 12px; font-weight: 600; font-variant-numeric: tabular-nums; }\\n\\n/* 7-day list */\\n.days { list-style: none; margin: 0; padding: 0; }\\n.days > li {\\n  position: relative;\\n  display: grid;\\n  grid-template-columns: 52px minmax(0, 1fr) 40px auto;\\n  align-items: center;\\n  gap: 10px;\\n  padding: 10px 0;\\n  border-top: 1px solid var(--border);\\n}\\n.day-cond { display: flex; align-items: center; gap: 8px; min-width: 0; }\\n.day-cond > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n.day-cond svg { width: 20px; height: 20px; flex: none; }\\n.range { display: flex; align-items: center; gap: 8px; font-variant-numeric: tabular-nums; }\\n.range .lo { color: var(--muted-foreground); }\\n.range-bar { display: none; position: relative; width: 120px; height: 6px; border-radius: 3px; background: var(--muted); }\\n.range-bar > span { position: absolute; inset-block: 0; border-radius: 3px; background: var(--primary); }\\n@media (min-width: 560px) {\\n  .range-bar { display: block; }\\n  .days > li { grid-template-columns: 64px minmax(0, 1fr) 48px auto; gap: 16px; }\\n}\\n\\n/* Saved cities and search results */\\n.city-list { list-style: none; margin: 0; padding: 4px 16px; display: flex; flex-direction: column; }\\n.city-row {\\n  display: grid;\\n  grid-template-columns: auto auto minmax(0, 1fr) auto auto;\\n  align-items: center;\\n  gap: 12px;\\n  padding: 12px 0;\\n}\\n.city-row + .city-row { border-top: 1px solid var(--border); }\\n.result-row { grid-template-columns: auto minmax(0, 1fr) auto auto; }\\n.city-main { display: grid; color: inherit; text-decoration: none; line-height: 20px; min-width: 0; border-radius: var(--radius-sm); }\\n.city-main > * { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n.city-temp { font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; text-align: right; min-width: 3ch; }\\n.results-card { padding: 16px 0 4px; gap: 4px; }\\n.results-card > p { padding-inline: 16px; }\\n.skeleton-row { height: 56px; margin: 0 16px 8px; }\\n\\n/* Compare */\\n.cmp-grid {\\n  display: grid;\\n  grid-auto-flow: column;\\n  grid-auto-columns: minmax(min(260px, 82vw), 1fr);\\n  gap: 16px;\\n  overflow-x: auto;\\n  padding-bottom: 8px;\\n  scroll-snap-type: x mandatory;\\n}\\n.cmp-grid > * { scroll-snap-align: start; }\\n.cmp { padding: 0; overflow: hidden; gap: 0; }\\n.cmp > :not(.wx-band) { padding-inline: 20px; }\\n.wx-band {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  gap: 8px;\\n  height: 72px;\\n  padding: 0 20px;\\n  background: var(--sky-a);\\n  box-shadow: inset 0 -28px 28px -8px var(--sky-b);\\n  color: #fff;\\n  text-shadow: 0 1px 2px rgb(0 0 0 / 0.55);\\n}\\n.wx-band svg { width: 32px; height: 32px; flex: none; filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.4)); }\\n.cmp-head { padding-top: 16px; }\\n.cmp-head h2 { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n.cmp-temp { margin: 8px 0 0; font-size: 48px; line-height: 1; font-weight: 300; font-variant-numeric: tabular-nums; }\\n.cmp-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 16px 0; }\\n.cmp-stats dt { color: var(--muted-foreground); font-size: 12px; }\\n.cmp-stats dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; }\\n.outlook {\\n  list-style: none;\\n  margin: 0;\\n  padding: 12px 20px 20px;\\n  display: grid;\\n  grid-template-columns: repeat(4, 1fr);\\n  gap: 4px;\\n  border-top: 1px solid var(--border);\\n  text-align: center;\\n  font-size: 13px;\\n}\\n.outlook li { display: grid; justify-items: center; gap: 4px; }\\n.outlook svg { width: 20px; height: 20px; }\\n\\n/* Settings */\\n.setting-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }\\n.setting-row p { margin: 4px 0 0; max-width: 60ch; }\\n.swatches { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 12px; }\\n.swatch { display: grid; gap: 6px; font-size: 13px; }\\n.swatch > span:first-child {\\n  display: grid;\\n  place-items: center;\\n  height: 64px;\\n  border-radius: var(--radius);\\n  background: var(--sky-a);\\n  box-shadow: inset 0 -24px 24px -8px var(--sky-b);\\n  color: #fff;\\n}\\n.swatch svg { width: 24px; height: 24px; filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.4)); }\\n\\n/* Empty and first visit */\\n.welcome { max-width: 560px; margin: 8vh auto 0; }\\n.empty-card { align-items: center; text-align: center; padding: 48px 24px; }\\n.empty-card > p { max-width: 45ch; color: var(--muted-foreground); }\\n.empty-card > svg { width: 32px; height: 32px; color: var(--muted-foreground); }\\n@media (max-width: 639px) {\\n  .cmp-grid { grid-auto-columns: 82vw; }\\n}\\n@media (min-width: 1024px) {\\n  .cmp-grid { grid-auto-columns: minmax(220px, 1fr); }\\n}\\n\\n/* Text never sits straight on the moving scene: headers and loose lines get a frosted strip. */\\n.screen-header,\\n.frost-strip {\\n  padding: 16px 20px;\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius-lg);\\n  background: var(--card);\\n  color: var(--card-foreground);\\n  -webkit-backdrop-filter: blur(18px) saturate(1.3);\\n  backdrop-filter: blur(18px) saturate(1.3);\\n  box-shadow: 0 1px 2px rgb(10 20 40 / 0.06), 0 10px 30px rgb(10 20 40 / 0.1);\\n}\\n.frost-strip { padding: 10px 16px; }\\n.band-label { background: rgb(0 0 0 / 0.5); color: #fff; text-shadow: none; }\\n/* On narrow screens, search regions and 7-day conditions wrap instead of being cut off. */\\n.result-row .city-main > * { white-space: normal; }\\n.day-cond > span { white-space: normal; overflow: visible; }\\n\"}"}}]},"finish_reason":null}]}

