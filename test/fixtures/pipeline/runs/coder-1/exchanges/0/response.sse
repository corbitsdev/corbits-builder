data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":19,"function":{"arguments":"{\"path\":\"client/src/lib/hooks.ts\",\"content\":\"import { useEffect, useState, useSyncExternalStore } from \\\"react\\\";\\n\\n/** The current time, ticking every `ms`, for \\\"updated 2 min ago\\\" and local clocks. */\\nexport function useNow(ms = 30_000) {\\n  const [now, setNow] = useState(() => Date.now());\\n  useEffect(() => {\\n    const t = setInterval(() => setNow(Date.now()), ms);\\n    return () => clearInterval(t);\\n  }, [ms]);\\n  return now;\\n}\\n\\n/** Whether the browser thinks it has a connection. */\\nexport const useOnline = () =>\\n  useSyncExternalStore(\\n    (l) => {\\n      addEventListener(\\\"online\\\", l);\\n      addEventListener(\\\"offline\\\", l);\\n      return () => {\\n        removeEventListener(\\\"online\\\", l);\\n        removeEventListener(\\\"offline\\\", l);\\n      };\\n    },\\n    () => navigator.onLine,\\n  );\\n\"}"}}]},"finish_reason":null}]}

