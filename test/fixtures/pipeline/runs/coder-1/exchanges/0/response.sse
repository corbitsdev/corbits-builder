data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":30,"function":{"arguments":"{\"path\":\"client/src/pages/compare.tsx\",\"content\":\"import { Link, useSearchParams } from \\\"react-router\\\";\\nimport { Columns2 } from \\\"lucide-react\\\";\\nimport { Button, Card, Skeleton } from \\\"@corbits/react-ui\\\";\\nimport { useForecast } from \\\"../api.ts\\\";\\nimport { UnitToggle, WxIcon } from \\\"../components/weather-bits.tsx\\\";\\nimport { cityNow, temp, windShort, windSpeed } from \\\"../lib/format.ts\\\";\\nimport { useNow } from \\\"../lib/hooks.ts\\\";\\nimport { cityAsPlace, glance, hereAsPlace, region, type Place } from \\\"../lib/places.ts\\\";\\nimport { useScene } from \\\"../lib/scene-state.ts\\\";\\nimport { readCached, useStore } from \\\"../lib/storage.ts\\\";\\nimport { outlook, today } from \\\"../lib/view.ts\\\";\\n\\nconst WORDS = [\\\"\\\", \\\"One\\\", \\\"Two\\\", \\\"Three\\\", \\\"Four\\\"];\\n\\nexport function Compare() {\\n  useScene(null, false);\\n  const [params] = useSearchParams();\\n  const cities = useStore((s) => s.cities);\\n  const here = useStore((s) => s.here);\\n  const location = useStore((s) => s.settings.location);\\n  const stored = useStore((s) => s.compare);\\n  const all: Place[] = [...(here && location === \\\"granted\\\" ? [hereAsPlace(here)] : []), ...cities.map(cityAsPlace)];\\n  const ids = (params.get(\\\"c\\\")?.split(\\\"~\\\").filter(Boolean) ?? stored).slice(0, 4);\\n  const picked = ids.map((id) => all.find((p) => p.id === id)).filter((p): p is Place => !!p);\\n\\n  if (picked.length < 2) {\\n    return (\\n      <div className=\\\"stack narrow\\\">\\n        <div className=\\\"screen-header\\\">\\n          <h1 className=\\\"page-title\\\" data-testid=\\\"compare-title\\\">\\n            Compare\\n          </h1>\\n        </div>\\n        <Card className=\\\"empty-card\\\" data-testid=\\\"compare-empty-card\\\">\\n          <Columns2 aria-hidden=\\\"true\\\" />\\n          <h2 className=\\\"text-lg font-semibold\\\">Pick at least two cities</h2>\\n          <p>Tick 2 to 4 of your saved cities to see their weather side by side.</p>\\n          <Button asChild>\\n            <Link to=\\\"/cities\\\" data-testid=\\\"compare-pick-link\\\">\\n              Choose cities\\n            </Link>\\n          </Button>\\n        </Card>\\n      </div>\\n    );\\n  }\\n\\n  return (\\n    <div className=\\\"stack\\\">\\n      <div className=\\\"screen-header\\\">\\n        <div className=\\\"flex flex-col gap-1\\\">\\n          <h1 className=\\\"page-title\\\" data-testid=\\\"compare-title\\\">\\n            Compare\\n          </h1>\\n          <p className=\\\"muted\\\">{WORDS[picked.length]} cities side by side, right now.</p>\\n        </div>\\n        <div className=\\\"row wrap\\\">\\n          <UnitToggle prefix=\\\"compare\\\" />\\n          <Button asChild>\\n            <Link to=\\\"/cities\\\" data-testid=\\\"compare-change-link\\\">\\n              Change cities\\n            </Link>\\n          </Button>\\n        </div>\\n      </div>\\n      <div\\n        className=\\\"cmp-grid\\\"\\n        data-testid=\\\"compare-grid\\\"\\n        tabIndex={0}\\n        role=\\\"region\\\"\\n        aria-label=\\\"Compared cities, scroll sideways for more\\\"\\n      >\\n        {picked.map((p) => (\\n          <CompareCard key={p.id} place={p} />\\n        ))}\\n      </div>\\n    </div>\\n  );\\n}\\n\\nfunction CompareCard({ place }: { place: Place }) {\\n  const unit = useStore((s) => s.settings.unit);\\n  useNow(60_000);\\n  const q = useForecast(place);\\n  const data = q.data ?? readCached(place.id)?.data;\\n  const g = data ? glance(data) : null;\\n  const where = region(place);\\n  if (!data || !g) {\\n    return (\\n      <Card className=\\\"cmp\\\" data-testid=\\\"compare-card\\\" aria-label={place.name} role=\\\"article\\\">\\n        <div className=\\\"wx-band\\\" data-wx=\\\"calm\\\" />\\n        <div className=\\\"cmp-head flex flex-col gap-2 pb-5\\\">\\n          <h2 className=\\\"text-lg font-semibold\\\">{place.name}</h2>\\n          {q.isError ? (\\n            <p className=\\\"muted\\\" role=\\\"alert\\\">\\n              We couldn't get this city's weather. Check your connection and try again.\\n            </p>\\n          ) : (\\n            <>\\n              <Skeleton className=\\\"h-12 w-24\\\" />\\n              <Skeleton className=\\\"h-5 w-32\\\" />\\n              <Skeleton className=\\\"h-16 w-full\\\" />\\n            </>\\n          )}\\n        </div>\\n      </Card>\\n    );\\n  }\\n  const t = today(data);\\n  const c = data.current;\\n  return (\\n    <Card className=\\\"cmp\\\" data-testid=\\\"compare-card\\\" aria-label={place.name} role=\\\"article\\\">\\n      <div className=\\\"wx-band\\\" data-wx={g.wx}>\\n        <span className=\\\"small rounded-full band-label px-2 py-0.5 font-semibold\\\">{g.scene.label}</span>\\n        <WxIcon name={g.icon} />\\n      </div>\\n      <div className=\\\"cmp-head\\\">\\n        <h2 className=\\\"text-lg font-semibold\\\">{place.isHere && place.name !== \\\"My location\\\" ? `My location · ${place.name}` : place.name}</h2>\\n        <p className=\\\"small muted\\\">\\n          {where ? `${where} · ` : \\\"\\\"}\\n          {cityNow(data)} local\\n        </p>\\n        <p className=\\\"cmp-temp\\\" data-testid=\\\"compare-temperature-count\\\">\\n          {temp(c.temperature_2m, unit)}\\n        </p>\\n        <p className=\\\"mt-1 font-semibold\\\">{g.text}</p>\\n      </div>\\n      <dl className=\\\"cmp-stats\\\">\\n        <div>\\n          <dt>Feels like</dt>\\n          <dd>{temp(c.apparent_temperature, unit)}</dd>\\n        </div>\\n        <div>\\n          <dt>Wind</dt>\\n          <dd>\\n            {windSpeed(c.wind_speed_10m, unit)} {windShort(c.wind_direction_10m)}\\n          </dd>\\n        </div>\\n        <div>\\n          <dt>Humidity</dt>\\n          <dd>{Math.round(c.relative_humidity_2m)}%</dd>\\n        </div>\\n        <div>\\n          <dt>High / low</dt>\\n          <dd>\\n            {temp(t.hiC, unit)} / {temp(t.loC, unit)}\\n          </dd>\\n        </div>\\n      </dl>\\n      <ol className=\\\"outlook\\\" aria-label={`Next hours in ${place.name}`}>\\n        {outlook(data).map((h) => (\\n          <li key={h.time}>\\n            <span className=\\\"muted\\\">{h.label}</span>\\n            <WxIcon name={h.icon} label={h.text} />\\n            <b>{temp(h.tempC, unit)}</b>\\n          </li>\\n        ))}\\n      </ol>\\n    </Card>\\n  );\\n}\\n\"}"}}]},"finish_reason":null}]}

