data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":29,"function":{"arguments":"{\"path\":\"client/src/pages/cities.tsx\",\"content\":\"import { Link } from \\\"react-router\\\";\\nimport { Bookmark, Columns2, Navigation, Plus, Search, Trash2 } from \\\"lucide-react\\\";\\nimport { toast as sonner } from \\\"sonner\\\";\\nimport { Badge, Button, Card, Checkbox, Skeleton } from \\\"@corbits/react-ui\\\";\\nimport { toast } from \\\"@corbits/react-ui/ui/toast\\\";\\nimport { useForecast } from \\\"../api.ts\\\";\\nimport { WxChip } from \\\"../components/weather-bits.tsx\\\";\\nimport { cityNow, temp } from \\\"../lib/format.ts\\\";\\nimport { useNow } from \\\"../lib/hooks.ts\\\";\\nimport { cityAsPlace, glance, hereAsPlace, placeHref, region, type Place } from \\\"../lib/places.ts\\\";\\nimport { useScene } from \\\"../lib/scene-state.ts\\\";\\nimport { readCached, store, useStore } from \\\"../lib/storage.ts\\\";\\nimport { useLocateAction } from \\\"../lib/use-locate.ts\\\";\\n\\nexport const MAX_COMPARE = 4;\\n\\nexport function Cities() {\\n  useScene(\\\"keep\\\");\\n  const cities = useStore((s) => s.cities);\\n  const here = useStore((s) => s.here);\\n  const location = useStore((s) => s.settings.location);\\n  const picked = useStore((s) => s.compare);\\n  const places: Place[] = [...(here && location === \\\"granted\\\" ? [hereAsPlace(here)] : []), ...cities.map(cityAsPlace)];\\n  const valid = picked.filter((id) => places.some((p) => p.id === id));\\n  const n = valid.length;\\n\\n  const toggle = (id: string, on: boolean) => {\\n    if (on && n >= MAX_COMPARE) return;\\n    store.setCompare(on ? [...valid, id] : valid.filter((x) => x !== id));\\n  };\\n\\n  return (\\n    <div className=\\\"stack narrow\\\">\\n      <div className=\\\"screen-header\\\">\\n        <div className=\\\"flex flex-col gap-1\\\">\\n          <h1 className=\\\"page-title\\\" data-testid=\\\"cities-title\\\">\\n            Saved cities\\n          </h1>\\n          {cities.length ? <p className=\\\"muted\\\">Tap a city to see its weather. Tick 2 to 4 to compare.</p> : null}\\n        </div>\\n        {cities.length ? (\\n          n >= 2 ? (\\n            <Button asChild>\\n              <Link to={`/compare?c=${encodeURIComponent(valid.join(\\\"~\\\"))}`} data-testid=\\\"cities-compare-link\\\">\\n                <Columns2 />\\n                Compare {n} cities\\n              </Link>\\n            </Button>\\n          ) : (\\n            <Button disabled data-testid=\\\"cities-compare-link\\\">\\n              <Columns2 />\\n              Tick 2 to compare\\n            </Button>\\n          )\\n        ) : null}\\n      </div>\\n\\n      {cities.length === 0 ? (\\n        <Card className=\\\"empty-card\\\" data-testid=\\\"cities-empty-card\\\">\\n          <Bookmark aria-hidden=\\\"true\\\" />\\n          <h2 className=\\\"text-lg font-semibold\\\">No saved cities yet</h2>\\n          <p>Save the places you check often. They'll show here with their weather, and you can compare up to four side by side.</p>\\n          <Button asChild>\\n            <Link to=\\\"/search\\\" data-testid=\\\"cities-empty-search-link\\\">\\n              <Search />\\n              Search for a city\\n            </Link>\\n          </Button>\\n        </Card>\\n      ) : (\\n        <>\\n          <div className=\\\"row wrap justify-between frost-strip\\\">\\n            <Badge className=\\\"badge-plain\\\" role=\\\"status\\\" data-testid=\\\"cities-selected-count\\\">\\n              {n} picked · up to {MAX_COMPARE}\\n            </Badge>\\n            <Button asChild variant=\\\"outline\\\">\\n              <Link to=\\\"/search\\\" data-testid=\\\"cities-add-link\\\">\\n                <Plus />\\n                Add a city\\n              </Link>\\n            </Button>\\n          </div>\\n          <Card className=\\\"p-0\\\" aria-label=\\\"Saved cities\\\" role=\\\"region\\\">\\n            <ul className=\\\"city-list\\\" data-testid=\\\"cities-list\\\">\\n              {places.map((p) => (\\n                <CityRow\\n                  key={p.id}\\n                  place={p}\\n                  checked={valid.includes(p.id)}\\n                  disabled={!valid.includes(p.id) && n >= MAX_COMPARE}\\n                  onCheck={(on) => toggle(p.id, on)}\\n                />\\n              ))}\\n            </ul>\\n          </Card>\\n        </>\\n      )}\\n      <p className=\\\"small muted row gap-2 frost-strip\\\" data-testid=\\\"cities-browser-note\\\">\\n        <Bookmark className=\\\"size-4 shrink-0\\\" aria-hidden=\\\"true\\\" />\\n        Your cities are kept in this browser only. Clearing your browser's data removes them.\\n      </p>\\n    </div>\\n  );\\n}\\n\\nfunction CityRow({\\n  place,\\n  checked,\\n  disabled,\\n  onCheck,\\n}: {\\n  place: Place;\\n  checked: boolean;\\n  disabled: boolean;\\n  onCheck: (on: boolean) => void;\\n}) {\\n  const unit = useStore((s) => s.settings.unit);\\n  useNow(60_000);\\n  const { locate, locating } = useLocateAction();\\n  const q = useForecast(place);\\n  const data = q.data ?? readCached(place.id)?.data;\\n  const g = data ? glance(data) : null;\\n  const title = place.isHere ? (place.name === \\\"My location\\\" ? \\\"My location\\\" : `My location · ${place.name}`) : place.name;\\n\\n  const remove = () => {\\n    const removed = store.remove(place.id);\\n    if (!removed) return;\\n    // The row is gone; keep keyboard focus in the list rather than losing it.\\n    requestAnimationFrame(() =>\\n      document.querySelector<HTMLElement>('[data-testid=\\\"cities-list\\\"] [data-testid=\\\"cities-city-link\\\"], [data-testid=\\\"cities-empty-search-link\\\"]')?.focus(),\\n    );\\n    sonner(`${place.name} removed.`, {\\n      duration: 4000,\\n      action: {\\n        label: \\\"Undo\\\",\\n        onClick: () => {\\n          store.restore(removed);\\n          toast(`${place.name} put back.`);\\n        },\\n      },\\n    });\\n  };\\n\\n  return (\\n    <li className=\\\"city-row\\\">\\n      <label className=\\\"inline-flex cursor-pointer p-1\\\" data-testid=\\\"cities-compare-checkbox\\\" title={disabled ? \\\"Four cities are already picked\\\" : undefined}>\\n        <Checkbox checked={checked} disabled={disabled} onCheckedChange={onCheck} />\\n        <span className=\\\"sr\\\">\\n          Compare {place.name}\\n          {disabled ? \\\" (four cities are already picked)\\\" : \\\"\\\"}\\n        </span>\\n      </label>\\n      {g ? <WxChip wx={g.wx} icon={g.icon} /> : <Skeleton className=\\\"size-9 rounded-full\\\" />}\\n      <Link className=\\\"city-main\\\" to={placeHref(place, true)} data-testid=\\\"cities-city-link\\\">\\n        <b>{title}</b>\\n        <span className=\\\"small\\\">{g && data ? `${g.text} · ${cityNow(data)} local` : q.isError ? \\\"Weather unavailable\\\" : \\\"Loading weather…\\\"}</span>\\n        <span className=\\\"small muted\\\">{region(place) || \\\" \\\"}</span>\\n      </Link>\\n      <span className=\\\"city-temp\\\">{g ? temp(g.tempC, unit) : \\\"\\\"}</span>\\n      {place.isHere ? (\\n        <Button\\n          variant=\\\"ghost\\\"\\n          size=\\\"icon\\\"\\n          onClick={() => void locate()}\\n          disabled={locating}\\n          aria-label=\\\"Check my location again\\\"\\n          data-testid=\\\"cities-locate-button\\\"\\n        >\\n          <Navigation />\\n        </Button>\\n      ) : (\\n        <Button variant=\\\"ghost\\\" size=\\\"icon\\\" onClick={remove} aria-label={`Remove ${place.name}`} data-testid=\\\"cities-remove-button\\\">\\n          <Trash2 />\\n        </Button>\\n      )}\\n    </li>\\n  );\\n}\\n\"}"}}]},"finish_reason":null}]}

