data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":32,"function":{"arguments":"{\"path\":\"client/src/pages/home.tsx\",\"content\":\"import { useEffect, useMemo, useRef } from \\\"react\\\";\\nimport { Link, useSearchParams } from \\\"react-router\\\";\\nimport { Bookmark, CircleAlert, Clock, MapPinOff, Navigation, Plus, RefreshCw, Search, WifiOff } from \\\"lucide-react\\\";\\nimport { Badge, Button, Card, Switch } from \\\"@corbits/react-ui\\\";\\nimport { toast } from \\\"@corbits/react-ui/ui/toast\\\";\\nimport { useForecast } from \\\"../api.ts\\\";\\nimport { DayList, HeroSkeleton, HourStrip, ListSkeleton, StatTiles } from \\\"../components/forecast.tsx\\\";\\nimport { PlaceRow, PlacesPanel } from \\\"../components/places.tsx\\\";\\nimport { Notice, UnitToggle, WxChip, WxIcon } from \\\"../components/weather-bits.tsx\\\";\\nimport { age, ago, cityNow, savedAt, temp } from \\\"../lib/format.ts\\\";\\nimport { useNow, useOnline } from \\\"../lib/hooks.ts\\\";\\nimport { locate, permissionGranted } from \\\"../lib/location.ts\\\";\\nimport { cityAsPlace, glance, hereAsPlace, region, type Place } from \\\"../lib/places.ts\\\";\\nimport { useScene } from \\\"../lib/scene-state.ts\\\";\\nimport { cityId, getState, MY_LOCATION_ID, readCached, store, useStore } from \\\"../lib/storage.ts\\\";\\nimport { useLocateAction } from \\\"../lib/use-locate.ts\\\";\\nimport { parseForced } from \\\"../lib/weather.ts\\\";\\nimport { summary } from \\\"../lib/view.ts\\\";\\n\\nconst geoSupported = typeof navigator !== \\\"undefined\\\" && \\\"geolocation\\\" in navigator;\\n\\n/** Reads which place Home should show from the address, the saved places and the location. */\\nfunction usePlace(): { place: Place | null; preview: boolean } {\\n  const [params] = useSearchParams();\\n  const cities = useStore((s) => s.cities);\\n  const here = useStore((s) => s.here);\\n  const location = useStore((s) => s.settings.location);\\n  const lastPlace = useStore((s) => s.settings.lastPlace);\\n  const lat = Number(params.get(\\\"lat\\\"));\\n  const lon = Number(params.get(\\\"lon\\\"));\\n  const name = params.get(\\\"name\\\");\\n  const city = params.get(\\\"city\\\");\\n  return useMemo(() => {\\n    if (name && Number.isFinite(lat) && Number.isFinite(lon) && params.has(\\\"lat\\\") && params.has(\\\"lon\\\")) {\\n      const id = cityId(lat, lon);\\n      const saved = cities.find((c) => c.id === id);\\n      if (saved) return { place: cityAsPlace(saved), preview: false };\\n      return {\\n        place: { id, name, admin1: params.get(\\\"admin1\\\"), country: params.get(\\\"country\\\"), lat, lon, isHere: false },\\n        preview: true,\\n      };\\n    }\\n    if (city === MY_LOCATION_ID && here) return { place: hereAsPlace(here), preview: false };\\n    const saved = city ? cities.find((c) => c.id === city) : undefined;\\n    if (saved) return { place: cityAsPlace(saved), preview: false };\\n    if (here && location === \\\"granted\\\") return { place: hereAsPlace(here), preview: false };\\n    const last = cities.find((c) => c.id === lastPlace);\\n    if (last && location !== \\\"unknown\\\") return { place: cityAsPlace(last), preview: false };\\n    return { place: null, preview: false };\\n  }, [name, lat, lon, city, cities, here, location, lastPlace, params]);\\n}\\n\\nexport function Home() {\\n  const [params] = useSearchParams();\\n  const { place, preview } = usePlace();\\n  const cities = useStore((s) => s.cities);\\n  const here = useStore((s) => s.here);\\n  const location = useStore((s) => s.settings.location);\\n  const { locate: locateAction, locating } = useLocateAction();\\n\\n  // First open: ask for the device location once. Later opens refresh it quietly if already allowed.\\n  const asked = useRef(false);\\n  useEffect(() => {\\n    if (asked.current) return;\\n    asked.current = true;\\n    const s = getState().settings.location;\\n    if (s === \\\"unknown\\\" && geoSupported) void locate();\\n    else if (s === \\\"granted\\\") void permissionGranted().then((ok) => {\\n      if (ok) void locate();\\n    });\\n  }, []);\\n\\n  useEffect(() => {\\n    if (place && !preview) store.setLastPlace(place.id);\\n  }, [place, preview]);\\n\\n  const places = useMemo(\\n    () => [...(here && location === \\\"granted\\\" ? [hereAsPlace(here)] : []), ...cities.map(cityAsPlace)],\\n    [here, location, cities],\\n  );\\n\\n  if (!place) {\\n    const waiting = locating || (location === \\\"unknown\\\" && geoSupported);\\n    if (waiting) return <LocatingState places={places} onLocate={locateAction} />;\\n    if (cities.length) return <DeniedState places={places} onRetry={locateAction} />;\\n    return <EmptyState onLocate={locateAction} />;\\n  }\\n  return (\\n    <PlaceView\\n      key={place.id}\\n      place={place}\\n      preview={preview}\\n      places={places}\\n      forced={params.get(\\\"force\\\")}\\n      onLocate={locateAction}\\n      locating={locating}\\n    />\\n  );\\n}\\n\\nfunction PlaceView({\\n  place,\\n  preview,\\n  places,\\n  forced,\\n  onLocate,\\n  locating,\\n}: {\\n  place: Place;\\n  preview: boolean;\\n  places: Place[];\\n  forced: string | null;\\n  onLocate: () => void;\\n  locating: boolean;\\n}) {\\n  const unit = useStore((s) => s.settings.unit);\\n  const simpler = useStore((s) => s.settings.simpler);\\n  const online = useOnline();\\n  const now = useNow();\\n  const q = useForecast(place);\\n  const cached = useMemo(() => (q.data ? null : readCached(place.id)), [q.data, place.id]);\\n  const fallback = q.isError || !online ? cached : null;\\n  const data = q.data ?? fallback?.data;\\n  const updatedAt = q.data ? q.dataUpdatedAt : fallback?.at;\\n  const offline = !online;\\n  const failed = q.isError && !q.isFetching;\\n  const g = data ? glance(data) : null;\\n  const forcedScene = parseForced(forced);\\n  const scene = forcedScene ?? g?.scene ?? null;\\n  useScene(scene, !forcedScene);\\n\\n  const refresh = async () => {\\n    const r = await q.refetch();\\n    if (r.isSuccess) toast(\\\"Weather updated just now.\\\");\\n  };\\n  const save = () => {\\n    const added = store.save({\\n      name: place.name,\\n      admin1: place.admin1 ?? undefined,\\n      country: place.country ?? undefined,\\n      lat: place.lat,\\n      lon: place.lon,\\n    });\\n    toast(added ? `${place.name} saved to your places.` : `${place.name} is already in your places.`);\\n  };\\n\\n  const where = region(place);\\n  const loading = !data && q.isPending;\\n  const state = loading ? \\\"loading\\\" : offline ? \\\"offline\\\" : failed ? \\\"error\\\" : preview ? \\\"preview\\\" : \\\"populated\\\";\\n\\n  return (\\n    <div className=\\\"wx-layout\\\" data-testid={`home-${state}`} aria-busy={loading || undefined}>\\n      <PlacesPanel places={places} currentId={preview ? null : place.id} onLocate={onLocate} locating={locating} />\\n      <div className=\\\"wx-main stack\\\">\\n        <div className=\\\"screen-header\\\">\\n          <div className=\\\"flex min-w-0 flex-col gap-1\\\">\\n            <h1 className=\\\"page-title\\\" data-testid=\\\"home-title\\\">\\n              {place.name}\\n            </h1>\\n            <p className=\\\"sub muted\\\">\\n              {place.isHere ? (\\n                <>\\n                  <Navigation className=\\\"size-4\\\" aria-hidden=\\\"true\\\" />\\n                  My location{where ? \\\" · \\\" : \\\"\\\"}\\n                </>\\n              ) : null}\\n              {where}\\n              {data ? (\\n                <>\\n                  {where || place.isHere ? \\\" · \\\" : \\\"\\\"}\\n                  <span className=\\\"row gap-1\\\" data-testid=\\\"home-local-time\\\">\\n                    <Clock className=\\\"size-4\\\" aria-hidden=\\\"true\\\" />\\n                    {cityNow(data)} local time\\n                  </span>\\n                </>\\n              ) : null}\\n            </p>\\n          </div>\\n          <div className=\\\"row wrap\\\">\\n            <UnitToggle prefix=\\\"home\\\" />\\n            {preview ? (\\n              <Button variant=\\\"outline\\\" onClick={save} data-testid=\\\"home-save-button\\\">\\n                <Plus />\\n                Save city\\n              </Button>\\n            ) : null}\\n            <Button onClick={() => void refresh()} disabled={q.isFetching} data-testid=\\\"home-refresh-button\\\">\\n              <RefreshCw className={q.isFetching && data ? \\\"motion-safe:animate-spin\\\" : undefined} />\\n              {q.isFetching ? (data ? \\\"Refreshing…\\\" : \\\"Loading…\\\") : \\\"Refresh\\\"}\\n            </Button>\\n          </div>\\n        </div>\\n\\n        {preview ? (\\n          <Notice icon={<Bookmark />} title=\\\"You're looking at a search result.\\\" testId=\\\"home-preview-notice\\\">\\n            Save {place.name} to keep it in your places and compare it with other cities.\\n          </Notice>\\n        ) : null}\\n\\n        {offline ? (\\n          <Notice icon={<WifiOff />} title=\\\"You're offline.\\\" testId=\\\"home-offline-notice\\\">\\n            {data && updatedAt\\n              ? `This is the weather we saved ${savedAt(updatedAt)}, ${ago(updatedAt, now)}, so it may have changed. Fresh weather needs an internet connection.`\\n              : \\\"No saved weather for this city yet. Connect to the internet to see it.\\\"}\\n          </Notice>\\n        ) : failed ? (\\n          <Notice\\n            icon={<CircleAlert />}\\n            title=\\\"We couldn't get fresh weather.\\\"\\n            tone=\\\"error\\\"\\n            testId=\\\"home-error-notice\\\"\\n            actions={\\n              <Button onClick={() => void refresh()} data-testid=\\\"home-retry-button\\\">\\n                <RefreshCw />\\n                Try again\\n              </Button>\\n            }\\n          >\\n            {data && updatedAt\\n              ? `The weather service didn't answer. Below is the last weather we got, updated ${ago(updatedAt, now)}.`\\n              : \\\"The weather service didn't answer, and there's no saved weather for this place yet.\\\"}\\n          </Notice>\\n        ) : null}\\n\\n        {loading ? (\\n          <Card className=\\\"hero\\\" aria-label=\\\"Current conditions\\\" role=\\\"region\\\">\\n            <p className=\\\"sr\\\" role=\\\"status\\\">\\n              Getting the latest weather for {place.name}\\n            </p>\\n            <HeroSkeleton />\\n          </Card>\\n        ) : data && g ? (\\n          <Card className=\\\"hero\\\" aria-label=\\\"Current conditions\\\" role=\\\"region\\\">\\n            <div className=\\\"hero-top\\\">\\n              <WxIcon name={g.icon} className=\\\"hero-icon\\\" />\\n              <div className=\\\"flex flex-col gap-1\\\">\\n                <p className=\\\"temp\\\" data-testid=\\\"home-temperature-count\\\">\\n                  {temp(data.current.temperature_2m, unit)}\\n                </p>\\n                <p className=\\\"cond\\\">{g.text}</p>\\n                <p className=\\\"muted\\\">{summary(data)}</p>\\n              </div>\\n            </div>\\n            <StatTiles f={data} unit={unit} />\\n            <div className=\\\"hero-foot\\\">\\n              <span className=\\\"row wrap gap-2\\\">\\n                <span className=\\\"muted small\\\" data-testid=\\\"home-updated-count\\\">\\n                  {offline ? `Last updated ${savedAt(updatedAt!)}` : failed ? `Last updated ${ago(updatedAt!, now)}` : `Updated ${ago(updatedAt!, now)} · Weather from Open-Meteo`}\\n                </span>\\n                {offline && updatedAt && now - updatedAt > 15 * 60_000 ? (\\n                  <Badge className=\\\"badge-plain badge-warning\\\" data-testid=\\\"home-old-badge\\\">\\n                    Old: {age(updatedAt, now)}\\n                  </Badge>\\n                ) : null}\\n              </span>\\n              <Badge className=\\\"badge-plain\\\" data-testid=\\\"home-scene-badge\\\">\\n                Scene: {scene?.label}\\n              </Badge>\\n              <label className=\\\"row switch-label\\\">\\n                <span className=\\\"inline-flex\\\" data-testid=\\\"home-effects-checkbox\\\">\\n                  <Switch checked={simpler} onCheckedChange={store.setSimpler} label=\\\"Simpler effects\\\" />\\n                </span>\\n                <span aria-hidden=\\\"true\\\">Simpler effects</span>\\n              </label>\\n            </div>\\n          </Card>\\n        ) : null}\\n\\n        {loading || data ? (\\n          <>\\n            <Card aria-label=\\\"Next 24 hours\\\" role=\\\"region\\\">\\n              <div className=\\\"row wrap justify-between\\\">\\n                <h2 className=\\\"text-lg font-semibold\\\">Next 24 hours</h2>\\n                <span className=\\\"small muted\\\">Blue figure: chance of rain</span>\\n              </div>\\n              {data ? <HourStrip f={data} unit={unit} /> : <ListSkeleton rows={10} />}\\n            </Card>\\n            <Card aria-label=\\\"Next 7 days\\\" role=\\\"region\\\">\\n              <h2 className=\\\"text-lg font-semibold\\\">Next 7 days</h2>\\n              {data ? <DayList f={data} unit={unit} /> : <ListSkeleton rows={7} tall />}\\n            </Card>\\n          </>\\n        ) : null}\\n      </div>\\n    </div>\\n  );\\n}\\n\\n/** First open while the browser asks for location: calm sky and placeholders. */\\nfunction LocatingState({ places, onLocate }: { places: Place[]; onLocate: () => void }) {\\n  useForcedOrCalm();\\n  return (\\n    <div className=\\\"wx-layout\\\" data-testid=\\\"home-loading\\\" aria-busy=\\\"true\\\">\\n      <PlacesPanel places={places} currentId={null} onLocate={onLocate} locating />\\n      <div className=\\\"wx-main stack\\\">\\n        <div className=\\\"screen-header\\\">\\n          <div className=\\\"flex flex-col gap-1\\\">\\n            <h1 className=\\\"page-title\\\" data-testid=\\\"home-title\\\">\\n              My location\\n            </h1>\\n            <p className=\\\"sub muted\\\">\\n              <Navigation className=\\\"size-4\\\" aria-hidden=\\\"true\\\" />\\n              Finding where you are…\\n            </p>\\n          </div>\\n          <div className=\\\"row wrap\\\">\\n            <UnitToggle prefix=\\\"home\\\" />\\n            <Button disabled data-testid=\\\"home-refresh-button\\\">\\n              <RefreshCw />\\n              Loading…\\n            </Button>\\n          </div>\\n        </div>\\n        <Card className=\\\"hero\\\" aria-label=\\\"Current conditions\\\" role=\\\"region\\\">\\n          <p className=\\\"sr\\\" role=\\\"status\\\">\\n            Finding your location. If your browser asks, choose Allow to see your local weather.\\n          </p>\\n          <HeroSkeleton />\\n        </Card>\\n        <Card aria-label=\\\"Next 24 hours\\\" role=\\\"region\\\">\\n          <h2 className=\\\"text-lg font-semibold\\\">Next 24 hours</h2>\\n          <ListSkeleton rows={10} />\\n        </Card>\\n      </div>\\n    </div>\\n  );\\n}\\n\\n/** Location declined, with saved places to pick from. */\\nfunction DeniedState({ places, onRetry }: { places: Place[]; onRetry: () => void }) {\\n  useForcedOrCalm();\\n  return (\\n    <div className=\\\"stack narrow\\\" data-testid=\\\"home-denied\\\">\\n      <div className=\\\"screen-header\\\">\\n        <h1 className=\\\"page-title\\\" data-testid=\\\"home-title\\\">\\n          Your weather\\n        </h1>\\n        <UnitToggle prefix=\\\"home\\\" />\\n      </div>\\n      <Notice\\n        icon={<MapPinOff />}\\n        title=\\\"Location is turned off for this app.\\\"\\n        testId=\\\"home-denied-notice\\\"\\n        actions={\\n          <>\\n            <Button asChild>\\n              <Link to=\\\"/search\\\" data-testid=\\\"home-denied-search-link\\\">\\n                <Search />\\n                Search for a city\\n              </Link>\\n            </Button>\\n            <Button variant=\\\"outline\\\" onClick={onRetry} data-testid=\\\"home-denied-retry-button\\\">\\n              <Navigation />\\n              Try again\\n            </Button>\\n          </>\\n        }\\n      >\\n        That's fine: search for a city, or pick one of your saved places below. To use your location later, allow it in\\n        your browser's settings, then tap “Try again”.\\n      </Notice>\\n      <Card aria-label=\\\"Saved places\\\" role=\\\"region\\\" className=\\\"gap-3\\\">\\n        <h2 className=\\\"text-lg font-semibold\\\">Your saved places</h2>\\n        <ul className=\\\"place-list place-grid\\\" data-testid=\\\"home-places-list\\\">\\n          {places.map((p) => (\\n            <SavedTile key={p.id} place={p} />\\n          ))}\\n        </ul>\\n      </Card>\\n    </div>\\n  );\\n}\\n\\nfunction SavedTile({ place }: { place: Place }) {\\n  return <PlaceRow place={place} current={false} />;\\n}\\n\\n/** First visit, no location and nothing saved. */\\nfunction EmptyState({ onLocate }: { onLocate: () => void }) {\\n  useForcedOrCalm();\\n  return (\\n    <div data-testid=\\\"home-empty\\\">\\n      <Card className=\\\"welcome empty-card\\\">\\n        <WxChip wx=\\\"clear-day\\\" icon=\\\"cloud-sun\\\" large />\\n        <h1 className=\\\"page-title\\\" data-testid=\\\"home-title\\\">\\n          Find your weather\\n        </h1>\\n        <p>\\n          Search for a city and watch its weather come alive on screen: rain falling, snow drifting, heat shimmering. Save\\n          the places you care about; they stay in this browser.\\n        </p>\\n        <Button asChild>\\n          <Link to=\\\"/search\\\" data-testid=\\\"home-empty-search-link\\\">\\n            <Search />\\n            Search for a city\\n          </Link>\\n        </Button>\\n        <Button variant=\\\"ghost\\\" onClick={onLocate} data-testid=\\\"home-empty-locate-button\\\">\\n          <Navigation />\\n          Use my location instead\\n        </Button>\\n      </Card>\\n    </div>\\n  );\\n}\\n\\n\\n/** The calm scene, unless the test route forces one. */\\nfunction useForcedOrCalm() {\\n  const [params] = useSearchParams();\\n  const forced = parseForced(params.get(\\\"force\\\"));\\n  useScene(forced, false);\\n}\\n\"}"}}]},"finish_reason":null}]}

