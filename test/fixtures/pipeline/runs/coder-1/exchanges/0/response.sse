data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":16,"function":{"arguments":"{\"path\":\"client/src/components/weather-bits.tsx\",\"content\":\"import type { ReactNode } from \\\"react\\\";\\nimport {\\n  Cloud,\\n  CloudDrizzle,\\n  CloudFog,\\n  CloudLightning,\\n  CloudMoon,\\n  CloudRain,\\n  CloudSun,\\n  Moon,\\n  Snowflake,\\n  Sun,\\n  Wind,\\n  type LucideIcon,\\n} from \\\"lucide-react\\\";\\nimport { FilterChip } from \\\"@corbits/react-ui\\\";\\nimport { toast } from \\\"@corbits/react-ui/ui/toast\\\";\\nimport type { IconName } from \\\"../lib/weather.ts\\\";\\nimport { store, useStore } from \\\"../lib/storage.ts\\\";\\n\\nconst ICONS: Record<IconName, LucideIcon> = {\\n  sun: Sun,\\n  moon: Moon,\\n  cloud: Cloud,\\n  \\\"cloud-sun\\\": CloudSun,\\n  \\\"cloud-moon\\\": CloudMoon,\\n  rain: CloudRain,\\n  drizzle: CloudDrizzle,\\n  storm: CloudLightning,\\n  snow: Snowflake,\\n  wind: Wind,\\n  fog: CloudFog,\\n};\\n\\n/** A weather icon. With `label` it is announced; without, it is decoration. */\\nexport function WxIcon({ name, label, className }: { name: IconName; label?: string; className?: string }) {\\n  const Icon = ICONS[name];\\n  return label ? (\\n    <Icon className={className} role=\\\"img\\\" aria-label={label} />\\n  ) : (\\n    <Icon className={className} aria-hidden=\\\"true\\\" />\\n  );\\n}\\n\\n/** Round sky-coloured chip showing a place's weather at a glance. */\\nexport function WxChip({ wx, icon, large }: { wx: string; icon: IconName; large?: boolean }) {\\n  return (\\n    <span className={large ? \\\"wx-chip wx-chip-lg\\\" : \\\"wx-chip\\\"} data-wx={wx}>\\n      <WxIcon name={icon} />\\n    </span>\\n  );\\n}\\n\\n/** The one °C/°F choice for the whole app; also switches km/h↔mph and mm↔in. */\\nexport function UnitToggle({ prefix }: { prefix: string }) {\\n  const unit = useStore((s) => s.settings.unit);\\n  const choose = (u: \\\"c\\\" | \\\"f\\\") => {\\n    if (u === unit) return;\\n    store.setUnit(u);\\n    toast(u === \\\"f\\\" ? \\\"Showing °F. Wind is now in mph and rain in inches.\\\" : \\\"Showing °C. Wind is now in km/h and rain in mm.\\\");\\n  };\\n  return (\\n    <div className=\\\"unit-toggle\\\" role=\\\"group\\\" aria-label=\\\"Temperature units\\\">\\n      <span className=\\\"inline-flex\\\" data-testid={`${prefix}-celsius-button`}>\\n        <FilterChip selected={unit === \\\"c\\\"} onClick={() => choose(\\\"c\\\")}>\\n          °C\\n        </FilterChip>\\n      </span>\\n      <span className=\\\"inline-flex\\\" data-testid={`${prefix}-fahrenheit-button`}>\\n        <FilterChip selected={unit === \\\"f\\\"} onClick={() => choose(\\\"f\\\")}>\\n          °F\\n        </FilterChip>\\n      </span>\\n    </div>\\n  );\\n}\\n\\n/** Offline, error, location and preview messages. Errors are announced at once. */\\nexport function Notice({\\n  icon,\\n  title,\\n  children,\\n  tone = \\\"info\\\",\\n  testId,\\n  actions,\\n}: {\\n  icon: ReactNode;\\n  title: string;\\n  children?: ReactNode;\\n  tone?: \\\"info\\\" | \\\"error\\\";\\n  testId: string;\\n  actions?: ReactNode;\\n}) {\\n  return (\\n    <div\\n      data-slot=\\\"card\\\"\\n      className={`notice rounded-lg border border-border bg-card text-card-foreground ${tone === \\\"error\\\" ? \\\"notice-error\\\" : \\\"\\\"}`}\\n      role={tone === \\\"error\\\" ? \\\"alert\\\" : \\\"status\\\"}\\n      data-testid={testId}\\n    >\\n      <span className=\\\"mt-0.5 shrink-0 [&_svg]:size-5\\\" aria-hidden=\\\"true\\\">\\n        {icon}\\n      </span>\\n      <div className=\\\"flex min-w-0 grow flex-col gap-2\\\">\\n        <p className=\\\"font-semibold\\\">{title}</p>\\n        {children ? <div className=\\\"text-muted-foreground\\\">{children}</div> : null}\\n        {actions ? <div className=\\\"row wrap\\\">{actions}</div> : null}\\n      </div>\\n    </div>\\n  );\\n}\\n\"}"}}]},"finish_reason":null}]}

