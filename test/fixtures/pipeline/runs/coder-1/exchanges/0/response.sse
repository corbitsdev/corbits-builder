data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":53,"function":{"arguments":"{\"path\":\"server/src/index.ts\",\"content\":\"import { Hono } from \\\"hono\\\";\\nimport { compress } from \\\"hono/compress\\\";\\nimport { zValidator } from \\\"@hono/zod-validator\\\";\\nimport { z } from \\\"zod\\\";\\nimport { Health, Nearest, Places, PlacesQuery, PointQuery } from \\\"@app/shared\\\";\\nimport { serveClient } from \\\"./client.ts\\\";\\nimport { distanceKm, forecast, searchPlaces, UpstreamError } from \\\"./openMeteo.ts\\\";\\n\\nconst app = new Hono();\\n\\n// Gzip everything we send: the app downloads about four times faster on a mobile connection.\\napp.use(compress());\\n\\nconst badQuery = (result: { success: boolean }, c: { json: (b: unknown, s: 400) => Response }) =>\\n  result.success ? undefined : c.json({ error: \\\"That place doesn't look right.\\\" }, 400);\\n\\napp.get(\\\"/api/health\\\", (c) => c.json(Health.parse({ ok: true, time: new Date().toISOString() })));\\n\\n// Weather for one place: current conditions, hourly and daily forecast, sunrise and sunset.\\napp.get(\\\"/api/forecast\\\", zValidator(\\\"query\\\", PointQuery, badQuery), async (c) => {\\n  const { lat, lon } = c.req.valid(\\\"query\\\");\\n  return c.json(await forecast(lat, lon));\\n});\\n\\n// City search as the person types.\\napp.get(\\\"/api/places\\\", zValidator(\\\"query\\\", PlacesQuery, badQuery), async (c) => {\\n  const { q } = c.req.valid(\\\"query\\\");\\n  return c.json(await searchPlaces(q));\\n});\\n\\n// A name for the device's location. Open-Meteo has no reverse lookup, so this searches for the\\n// city named in the place's time zone (and the zone's region) and keeps the closest match within\\n// 60 km. Otherwise the app calls the place \\\"My location\\\".\\nconst NearestQuery = PointQuery.extend({ tz: z.string().max(64).default(\\\"\\\") });\\napp.get(\\\"/api/nearest\\\", zValidator(\\\"query\\\", NearestQuery, badQuery), async (c) => {\\n  const { lat, lon, tz } = c.req.valid(\\\"query\\\");\\n  const names = tz\\n    .split(\\\"/\\\")\\n    .slice(1)\\n    .reverse()\\n    .map((part) => part.replaceAll(\\\"_\\\", \\\" \\\"))\\n    .filter((part) => part.length >= 2);\\n  let best: { d: number; place: z.infer<typeof Places>[\\\"results\\\"] } | undefined;\\n  for (const name of names) {\\n    const parsed = Places.safeParse(await searchPlaces(name, 20));\\n    for (const place of parsed.success ? (parsed.data.results ?? []) : []) {\\n      const d = distanceKm(lat, lon, place.latitude, place.longitude);\\n      if (d <= 60 && (!best || d < best.d)) best = { d, place: [place] };\\n    }\\n  }\\n  const place = best?.place?.[0];\\n  return c.json(\\n    Nearest.parse({\\n      name: place?.name ?? null,\\n      admin1: place?.admin1 ?? null,\\n      country: place?.country ?? null,\\n    }),\\n  );\\n});\\n\\napp.onError((error, c) => {\\n  if (error instanceof UpstreamError) return c.json({ error: error.message }, 502);\\n  console.error(error);\\n  return c.json({ error: \\\"Something went wrong on our side.\\\" }, 500);\\n});\\n\\n// The built client, for `bun run start`, and the not-found answer for /api. Hono matches in order, so\\n// this comes after every /api route. In dev, Vite serves the client and proxies /api here.\\nserveClient(app);\\n\\n// Bun serves the default export on PORT.\\nexport default app;\\n\"}"}}]},"finish_reason":null}]}

