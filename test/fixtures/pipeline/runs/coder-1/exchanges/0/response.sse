data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":15,"function":{"arguments":"{\"path\":\"client/src/components/query-state.tsx\",\"content\":\"import type { ReactNode } from \\\"react\\\";\\nimport type { UseQueryResult } from \\\"@tanstack/react-query\\\";\\nimport { Button, EmptyState, Skeleton } from \\\"@corbits/react-ui\\\";\\n\\n// Every screen that loads data renders through this, so loading, failure and \\\"nothing yet\\\" look the\\n// same everywhere and none of them is forgotten.\\nexport function QueryState<T>({\\n  query,\\n  isEmpty,\\n  empty,\\n  children,\\n}: {\\n  query: UseQueryResult<T>;\\n  isEmpty?: (data: T) => boolean;\\n  empty?: ReactNode;\\n  children: (data: T) => ReactNode;\\n}) {\\n  if (query.isPending)\\n    return (\\n      <div className=\\\"flex flex-col gap-3\\\" aria-busy=\\\"true\\\" data-testid=\\\"query-loading\\\">\\n        <Skeleton className=\\\"h-12 w-full\\\" />\\n        <Skeleton className=\\\"h-12 w-full\\\" />\\n        <Skeleton className=\\\"h-12 w-2/3\\\" />\\n      </div>\\n    );\\n  if (query.isError)\\n    return (\\n      <div role=\\\"alert\\\" data-testid=\\\"query-error\\\">\\n        <EmptyState\\n          title=\\\"Something went wrong\\\"\\n          description={query.error.message}\\n          action={<Button onClick={() => void query.refetch()}>Try again</Button>}\\n        />\\n      </div>\\n    );\\n  if (empty !== undefined && isEmpty?.(query.data)) return <>{empty}</>;\\n  return <>{children(query.data)}</>;\\n}\\n\"}"}}]},"finish_reason":null}]}

