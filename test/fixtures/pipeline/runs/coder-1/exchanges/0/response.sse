data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":9,"function":{"arguments":"{\"path\":\"client/public/manifest.webmanifest\",\"content\":\"{\\n  \\\"name\\\": \\\"Animated Weather\\\",\\n  \\\"short_name\\\": \\\"Weather\\\",\\n  \\\"description\\\": \\\"Weather you can feel: the whole screen moves with the weather where you are.\\\",\\n  \\\"start_url\\\": \\\"/\\\",\\n  \\\"scope\\\": \\\"/\\\",\\n  \\\"display\\\": \\\"standalone\\\",\\n  \\\"background_color\\\": \\\"#cfd9e4\\\",\\n  \\\"theme_color\\\": \\\"#3f5876\\\",\\n  \\\"icons\\\": [\\n    { \\\"src\\\": \\\"/icon-192.png\\\", \\\"sizes\\\": \\\"192x192\\\", \\\"type\\\": \\\"image/png\\\" },\\n    { \\\"src\\\": \\\"/icon-512.png\\\", \\\"sizes\\\": \\\"512x512\\\", \\\"type\\\": \\\"image/png\\\" },\\n    { \\\"src\\\": \\\"/icon-maskable-512.png\\\", \\\"sizes\\\": \\\"512x512\\\", \\\"type\\\": \\\"image/png\\\", \\\"purpose\\\": \\\"maskable\\\" },\\n    { \\\"src\\\": \\\"/icon.svg\\\", \\\"sizes\\\": \\\"any\\\", \\\"type\\\": \\\"image/svg+xml\\\" }\\n  ]\\n}\\n\"}"}}]},"finish_reason":null}]}

