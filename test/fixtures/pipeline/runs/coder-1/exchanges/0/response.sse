data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":17,"function":{"arguments":"{\"path\":\"client/src/lib/format.ts\",\"content\":\"import type { Forecast } from \\\"@app/shared\\\";\\n\\n// Every figure the app shows goes through here, so one unit choice changes all of them.\\nexport type Unit = \\\"c\\\" | \\\"f\\\";\\n\\nconst MINUS = \\\"\\\\u2212\\\";\\n\\n/** Whole degrees with a true minus: \\\"−3°\\\". Never \\\"−0°\\\". */\\nexport function temp(celsius: number | null | undefined, unit: Unit): string {\\n  if (celsius == null || Number.isNaN(celsius)) return \\\"–\\\";\\n  const value = Math.round(unit === \\\"f\\\" ? celsius * 1.8 + 32 : celsius);\\n  return value < 0 ? `${MINUS}${Math.abs(value)}°` : `${value === 0 ? 0 : value}°`;\\n}\\n\\nexport function windSpeed(kmh: number, unit: Unit): string {\\n  return unit === \\\"f\\\" ? `${Math.round(kmh * 0.621371)} mph` : `${Math.round(kmh)} km/h`;\\n}\\n\\nexport function windNumber(kmh: number, unit: Unit): number {\\n  return Math.round(unit === \\\"f\\\" ? kmh * 0.621371 : kmh);\\n}\\n\\nexport function rain(mm: number | null | undefined, unit: Unit): string {\\n  const v = mm ?? 0;\\n  if (unit === \\\"f\\\") {\\n    const inches = v / 25.4;\\n    return `${inches === 0 ? \\\"0\\\" : inches < 0.01 ? \\\"<0.01\\\" : inches.toFixed(2)} in`;\\n  }\\n  return `${v === 0 ? \\\"0\\\" : v < 0.1 ? \\\"<0.1\\\" : Number.isInteger(Math.round(v * 10) / 10) ? Math.round(v) : v.toFixed(1)} mm`;\\n}\\n\\nconst DIRS = [\\\"north\\\", \\\"north-east\\\", \\\"east\\\", \\\"south-east\\\", \\\"south\\\", \\\"south-west\\\", \\\"west\\\", \\\"north-west\\\"];\\nconst SHORT = [\\\"N\\\", \\\"NE\\\", \\\"E\\\", \\\"SE\\\", \\\"S\\\", \\\"SW\\\", \\\"W\\\", \\\"NW\\\"];\\n/** Meteorological direction is where the wind comes from. */\\nexport const windFrom = (deg: number) => DIRS[Math.round(deg / 45) % 8]!;\\nexport const windShort = (deg: number) => SHORT[Math.round(deg / 45) % 8]!;\\n\\n/** A unix time shown as the city's own clock (\\\"14:00\\\"), using the forecast's UTC offset. */\\nexport function cityClock(unix: number, offsetSeconds: number): string {\\n  const d = new Date((unix + offsetSeconds) * 1000);\\n  return `${String(d.getUTCHours()).padStart(2, \\\"0\\\")}:${String(d.getUTCMinutes()).padStart(2, \\\"0\\\")}`;\\n}\\n\\n/** The city's local time right now. */\\nexport function cityNow(f: Forecast): string {\\n  return cityClock(Math.floor(Date.now() / 1000), f.utc_offset_seconds);\\n}\\n\\nexport function cityWeekday(unix: number, offsetSeconds: number): string {\\n  const d = new Date((unix + offsetSeconds) * 1000);\\n  return d.toLocaleDateString(undefined, { weekday: \\\"short\\\", timeZone: \\\"UTC\\\" });\\n}\\n\\n/** \\\"just now\\\", \\\"2 min ago\\\", \\\"3 hours ago\\\", \\\"2 days ago\\\". */\\nexport function ago(ms: number, now = Date.now()): string {\\n  const s = Math.max(0, Math.round((now - ms) / 1000));\\n  if (s < 60) return \\\"just now\\\";\\n  const m = Math.round(s / 60);\\n  if (m < 60) return `${m} min ago`;\\n  const h = Math.round(m / 60);\\n  if (h < 48) return `${h} hour${h === 1 ? \\\"\\\" : \\\"s\\\"} ago`;\\n  const d = Math.round(h / 24);\\n  return `${d} days ago`;\\n}\\n\\n/** Age without \\\"ago\\\", for the \\\"Old: 3 hours\\\" badge. */\\nexport function age(ms: number, now = Date.now()): string {\\n  const m = Math.max(1, Math.round((now - ms) / 60000));\\n  if (m < 60) return `${m} min`;\\n  const h = Math.round(m / 60);\\n  if (h < 48) return `${h} hour${h === 1 ? \\\"\\\" : \\\"s\\\"}`;\\n  return `${Math.round(h / 24)} days`;\\n}\\n\\n/** \\\"today at 07:40\\\" or \\\"Tue 28 Oct at 07:40\\\", in the viewer's own clock and locale. */\\nexport function savedAt(ms: number): string {\\n  const d = new Date(ms);\\n  const time = d.toLocaleTimeString(undefined, { hour: \\\"2-digit\\\", minute: \\\"2-digit\\\" });\\n  const today = new Date();\\n  if (d.toDateString() === today.toDateString()) return `today at ${time}`;\\n  return `${d.toLocaleDateString(undefined, { weekday: \\\"short\\\", day: \\\"numeric\\\", month: \\\"short\\\" })} at ${time}`;\\n}\\n\\n/** First visit: °F only where people use it (United States, Liberia, Myanmar and US territories). */\\nexport function defaultUnit(): Unit {\\n  const langs = [...(navigator.languages ?? []), navigator.language].filter(Boolean);\\n  const region = langs\\n    .map((l) => {\\n      try {\\n        return new Intl.Locale(l).maximize().region;\\n      } catch {\\n        return undefined;\\n      }\\n    })\\n    .find(Boolean);\\n  return region && [\\\"US\\\", \\\"LR\\\", \\\"MM\\\", \\\"PR\\\", \\\"GU\\\", \\\"VI\\\", \\\"AS\\\", \\\"MP\\\", \\\"UM\\\", \\\"BS\\\", \\\"KY\\\", \\\"PW\\\", \\\"FM\\\", \\\"MH\\\"].includes(region)\\n    ? \\\"f\\\"\\n    : \\\"c\\\";\\n}\\n\"}"}}]},"finish_reason":null}]}

