data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":51,"function":{"arguments":"{\"path\":\"packages/shared/src/index.ts\",\"content\":\"import { z } from \\\"zod\\\";\\n\\n// Shapes that cross the wire. The server relays Open-Meteo's answers and the client parses them\\n// with these schemas, so a changed answer fails in one place instead of deep in the screens.\\nexport const Health = z.object({ ok: z.boolean(), time: z.iso.datetime() });\\nexport type Health = z.infer<typeof Health>;\\n\\n/** Query for /api/forecast and /api/nearest: a point on the map. */\\nexport const PointQuery = z.object({\\n  lat: z.coerce.number().min(-90).max(90),\\n  lon: z.coerce.number().min(-180).max(180),\\n});\\n\\n/** Query for /api/places: the typed city name. */\\nexport const PlacesQuery = z.object({ q: z.string().trim().min(2).max(80) });\\n\\nconst nums = z.array(z.number().nullable());\\n\\n/** Open-Meteo forecast, requested with timeformat=unixtime and timezone=auto. */\\nexport const Forecast = z.object({\\n  latitude: z.number(),\\n  longitude: z.number(),\\n  timezone: z.string(),\\n  utc_offset_seconds: z.number(),\\n  current: z.object({\\n    time: z.number(),\\n    temperature_2m: z.number(),\\n    apparent_temperature: z.number(),\\n    relative_humidity_2m: z.number(),\\n    dew_point_2m: z.number(),\\n    is_day: z.number(),\\n    precipitation: z.number(),\\n    weather_code: z.number(),\\n    wind_speed_10m: z.number(),\\n    wind_direction_10m: z.number(),\\n    wind_gusts_10m: z.number(),\\n  }),\\n  hourly: z.object({\\n    time: z.array(z.number()),\\n    temperature_2m: nums,\\n    weather_code: nums,\\n    precipitation_probability: nums,\\n    is_day: nums,\\n  }),\\n  daily: z.object({\\n    time: z.array(z.number()),\\n    weather_code: nums,\\n    temperature_2m_max: nums,\\n    temperature_2m_min: nums,\\n    precipitation_sum: nums,\\n    precipitation_probability_max: nums,\\n    sunrise: z.array(z.number()),\\n    sunset: z.array(z.number()),\\n  }),\\n});\\nexport type Forecast = z.infer<typeof Forecast>;\\n\\n/** One place from Open-Meteo's city search. */\\nexport const Place = z.object({\\n  id: z.number(),\\n  name: z.string(),\\n  latitude: z.number(),\\n  longitude: z.number(),\\n  country: z.string().optional(),\\n  country_code: z.string().optional(),\\n  admin1: z.string().optional(),\\n  timezone: z.string().optional(),\\n  population: z.number().optional(),\\n});\\nexport type Place = z.infer<typeof Place>;\\n\\n/** Open-Meteo's city search answer: no `results` key when nothing matched. */\\nexport const Places = z.object({ results: z.array(Place).optional() });\\nexport type Places = z.infer<typeof Places>;\\n\\n/** /api/nearest: the best name for a point, or null when none is close enough. */\\nexport const Nearest = z.object({\\n  name: z.string().nullable(),\\n  admin1: z.string().nullable(),\\n  country: z.string().nullable(),\\n});\\nexport type Nearest = z.infer<typeof Nearest>;\\n\"}"}}]},"finish_reason":null}]}

