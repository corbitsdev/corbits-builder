data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":43,"function":{"arguments":"{\"path\":\"client/src/scene/fog.ts\",\"content\":\"import { mistSprite, rand, share, type Effect, type EffectOptions } from \\\"./common.ts\\\";\\n\\n// Fog: low banks of mist rolling slowly across the lower screen in several layers, over a pale\\n// haze that thickens towards the ground.\\n\\ntype Bank = { x: number; y: number; w: number; h: number; v: number; a: number };\\n\\nexport class Fog implements Effect {\\n  private banks: Bank[] = [];\\n  private w = 0;\\n  private h = 0;\\n  private sprite: HTMLCanvasElement;\\n  constructor(private opts: EffectOptions) {\\n    this.sprite = mistSprite(opts.isDay ? \\\"255,255,255\\\" : \\\"170,178,190\\\");\\n  }\\n  resize(w: number, h: number) {\\n    const first = this.banks.length === 0;\\n    this.w = w;\\n    this.h = h;\\n    if (!first) return;\\n    const n = share(this.opts, this.opts.intensity === \\\"heavy\\\" ? 34 : 24);\\n    for (let i = 0; i < n; i++) {\\n      const depth = i / Math.max(1, n - 1);\\n      this.banks.push({\\n        x: rand(-0.4, 1) * w,\\n        y: h * (0.3 + depth * 0.62) + rand(-30, 30),\\n        w: w * rand(0.5, 0.95) * (0.7 + depth * 0.6),\\n        h: h * rand(0.16, 0.3),\\n        v: (Math.random() < 0.5 ? -1 : 1) * rand(8, 22) * (0.5 + depth),\\n        a: rand(0.35, 0.6) * (this.opts.isDay ? 1 : 0.6),\\n      });\\n    }\\n  }\\n  update(dt: number) {\\n    for (const b of this.banks) {\\n      b.x += b.v * dt;\\n      if (b.v > 0 && b.x > this.w) b.x = -b.w;\\n      if (b.v < 0 && b.x + b.w < 0) b.x = this.w;\\n    }\\n  }\\n  draw(ctx: CanvasRenderingContext2D, alpha: number) {\\n    const day = this.opts.isDay;\\n    const haze = ctx.createLinearGradient(0, this.h * 0.25, 0, this.h);\\n    haze.addColorStop(0, `rgba(${day ? \\\"240,242,245\\\" : \\\"120,128,140\\\"},0)`);\\n    haze.addColorStop(1, `rgba(${day ? \\\"240,242,245\\\" : \\\"120,128,140\\\"},${(day ? 0.55 : 0.35) * alpha})`);\\n    ctx.fillStyle = haze;\\n    ctx.fillRect(0, this.h * 0.25, this.w, this.h * 0.75);\\n    for (const b of this.banks) {\\n      ctx.globalAlpha = b.a * alpha;\\n      ctx.drawImage(this.sprite, b.x, b.y - b.h / 2, b.w, b.h);\\n    }\\n    ctx.globalAlpha = 1;\\n  }\\n  count() {\\n    return this.banks.length;\\n  }\\n}\\n\"}"}}]},"finish_reason":null}]}

