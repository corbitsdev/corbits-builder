data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":37,"function":{"arguments":"{\"path\":\"client/src/scene/SceneLayer.tsx\",\"content\":\"import { lazy, Suspense, useEffect, useState, useSyncExternalStore } from \\\"react\\\";\\nimport { useShownScene } from \\\"../lib/scene-state.ts\\\";\\nimport { useStore } from \\\"../lib/storage.ts\\\";\\n\\nconst WeatherScene = lazy(() => import(\\\"./WeatherScene.tsx\\\"));\\n\\nconst reducedQuery = typeof matchMedia === \\\"function\\\" ? matchMedia(\\\"(prefers-reduced-motion: reduce)\\\") : null;\\n/** The device's reduce-motion setting, watched live. */\\nexport const useReducedMotion = () =>\\n  useSyncExternalStore(\\n    (l) => {\\n      reducedQuery?.addEventListener(\\\"change\\\", l);\\n      return () => reducedQuery?.removeEventListener(\\\"change\\\", l);\\n    },\\n    () => reducedQuery?.matches ?? false,\\n  );\\n\\n/**\\n * The full-screen weather behind every screen: the sky colours (shown at once) and the animated\\n * canvas (loaded after the figures). It also sets the app's palette: day scenes use the light\\n * surfaces, night scenes the deep indigo ones, and each scene its own accent colour.\\n */\\nexport function SceneLayer() {\\n  const scene = useShownScene();\\n  const simpler = useStore((s) => s.settings.simpler);\\n  const reduced = useReducedMotion();\\n  const wx = scene?.key ?? \\\"calm\\\";\\n  const [skies, setSkies] = useState<{ key: string; id: number }[]>([{ key: wx, id: 0 }]);\\n  const [canvasReady, setCanvasReady] = useState(false);\\n\\n  useEffect(() => {\\n    const root = document.documentElement;\\n    root.dataset.wx = wx;\\n    const night = wx.endsWith(\\\"-night\\\");\\n    root.classList.toggle(\\\"dark\\\", night);\\n    root.classList.toggle(\\\"light\\\", !night);\\n    const meta = document.querySelector('meta[name=\\\"theme-color\\\"]');\\n    meta?.setAttribute(\\\"content\\\", getComputedStyle(root).getPropertyValue(\\\"--sky-a\\\").trim() || \\\"#cfd9e4\\\");\\n    // New sky fades in over the old one; the old one goes once the fade is done (no blank flash).\\n    setSkies((prev) => (prev[prev.length - 1]?.key === wx ? prev : [...prev.slice(-1), { key: wx, id: Date.now() }]));\\n    const t = setTimeout(() => setSkies((prev) => prev.slice(-1)), 1300);\\n    return () => clearTimeout(t);\\n  }, [wx]);\\n\\n  const hasScene = scene !== null;\\n  useEffect(() => {\\n    // Load the moving scene only once a city's figures are on screen (they set the scene), so the\\n    // numbers never wait for the graphics. The calm sky needs no canvas.\\n    if (canvasReady || !hasScene) return;\\n    const idle = window.requestIdleCallback ?? ((cb: () => void) => window.setTimeout(cb, 200));\\n    const handle = idle(() => setCanvasReady(true), { timeout: 800 });\\n    return () => (window.cancelIdleCallback ?? clearTimeout)(handle);\\n  }, [canvasReady, hasScene]);\\n\\n  return (\\n    <div className=\\\"scene\\\" aria-hidden=\\\"true\\\" data-intensity={scene?.intensity}>\\n      {skies.map((s) => (\\n        <div key={s.id} className=\\\"scene-sky\\\" data-wx={s.key} />\\n      ))}\\n      {canvasReady ? (\\n        <Suspense fallback={null}>\\n          <WeatherScene\\n            spec={scene ? { condition: scene.condition, intensity: scene.intensity, isDay: scene.isDay } : null}\\n            simpler={simpler}\\n            reduced={reduced}\\n          />\\n        </Suspense>\\n      ) : null}\\n    </div>\\n  );\\n}\\n\"}"}}]},"finish_reason":null}]}

