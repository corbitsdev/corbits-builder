data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":46,"function":{"arguments":"{\"path\":\"client/src/scene/rain.ts\",\"content\":\"import { Clouds, rand, share, type Effect, type EffectOptions } from \\\"./common.ts\\\";\\n\\n// Rain: thousands of individual drops in three depth layers, with splashes where near drops land.\\n// Light rain is sparse fine drizzle; heavy rain is dense, long, fast streaks with misty spray.\\n\\nconst FULL: Record<string, number> = { light: 260, moderate: 750, heavy: 1600 };\\n\\ntype Drop = { x: number; y: number; z: number; len: number; v: number; ground: number };\\ntype Splash = { x: number; y: number; t: number; life: number; r: number; bits: { dx: number; dy: number }[] };\\n\\nexport class Rain implements Effect {\\n  protected drops: Drop[] = [];\\n  private splashes: Splash[] = [];\\n  protected clouds: Clouds;\\n  protected w = 0;\\n  protected h = 0;\\n  private slant: number;\\n  constructor(protected opts: EffectOptions, dark = false) {\\n    const night = !opts.isDay;\\n    this.slant = opts.intensity === \\\"heavy\\\" ? 0.22 : 0.12;\\n    this.clouds = new Clouds({\\n      color: dark ? (night ? \\\"40,44,66\\\" : \\\"70,76,98\\\") : night ? \\\"70,84,110\\\" : \\\"200,210,222\\\",\\n      count: opts.quality >= 2 ? 9 : 5,\\n      top: -0.05,\\n      bottom: 0.28,\\n      speed: 10,\\n      alpha: dark ? 0.85 : night ? 0.55 : 0.6,\\n      scale: [1.1, 2.0],\\n    });\\n  }\\n  resize(w: number, h: number) {\\n    this.w = w;\\n    this.h = h;\\n    this.clouds.resize(w, h);\\n    const n = share(this.opts, FULL[this.opts.intensity]!);\\n    if (this.drops.length === 0) for (let i = 0; i < n; i++) this.drops.push(this.newDrop(true));\\n    for (const d of this.drops) d.ground = this.groundFor(d.z);\\n  }\\n  private groundFor(z: number) {\\n    // Near drops land low on the screen, far ones further up, so splashes read as depth.\\n    return this.h * (0.72 + z * 0.28) + rand(-10, 10);\\n  }\\n  protected newDrop(anywhere: boolean): Drop {\\n    const z = Math.random() ** 1.6; // more far drops than near ones\\n    const heavy = this.opts.intensity === \\\"heavy\\\";\\n    const light = this.opts.intensity === \\\"light\\\";\\n    const v = (light ? 520 : 760) + z * (heavy ? 900 : 620);\\n    return {\\n      x: rand(-0.15 * this.h, this.w + 20),\\n      y: anywhere ? rand(-this.h, this.h) : rand(-120, -10),\\n      z,\\n      len: (light ? 6 : heavy ? 16 : 11) + z * (light ? 10 : heavy ? 30 : 20),\\n      v,\\n      ground: this.groundFor(z),\\n    };\\n  }\\n  update(dt: number) {\\n    this.clouds.update(dt);\\n    const near = this.opts.quality >= 2;\\n    for (let i = 0; i < this.drops.length; i++) {\\n      const d = this.drops[i]!;\\n      d.y += d.v * dt;\\n      d.x += d.v * this.slant * dt;\\n      if (d.y > d.ground) {\\n        if (near && d.z > 0.55 && this.splashes.length < 220) this.splash(d.x, d.ground, d.z);\\n        this.drops[i] = this.newDrop(false);\\n      }\\n    }\\n    for (const s of this.splashes) s.t += dt;\\n    this.splashes = this.splashes.filter((s) => s.t < s.life);\\n  }\\n  private splash(x: number, y: number, z: number) {\\n    const bits = [];\\n    const n = 2 + Math.floor(Math.random() * 3);\\n    for (let i = 0; i < n; i++) bits.push({ dx: rand(-60, 60) * z, dy: rand(-110, -50) * z });\\n    this.splashes.push({ x, y, t: 0, life: rand(0.22, 0.38), r: 3 + z * 7, bits });\\n  }\\n  draw(ctx: CanvasRenderingContext2D, alpha: number) {\\n    this.clouds.draw(ctx, alpha);\\n    const night = !this.opts.isDay;\\n    const color = night ? \\\"190,210,240\\\" : \\\"235,242,252\\\";\\n    ctx.lineCap = \\\"round\\\";\\n    // Three depth bands, one path each, so thousands of drops cost three strokes.\\n    const bands: [number, number, number, number][] = [\\n      [0, 0.35, 0.28, 1],\\n      [0.35, 0.7, 0.45, 1.3],\\n      [0.7, 1.01, 0.7, 1.8],\\n    ];\\n    for (const [lo, hi, a, width] of bands) {\\n      ctx.strokeStyle = `rgba(${color},${a * alpha})`;\\n      ctx.lineWidth = width;\\n      ctx.beginPath();\\n      for (const d of this.drops) {\\n        if (d.z < lo || d.z >= hi) continue;\\n        ctx.moveTo(d.x, d.y);\\n        ctx.lineTo(d.x - d.len * this.slant, d.y - d.len);\\n      }\\n      ctx.stroke();\\n    }\\n    // Splashes: a flattened ring plus droplets thrown up and falling back.\\n    ctx.lineWidth = 1;\\n    for (const s of this.splashes) {\\n      const k = s.t / s.life;\\n      const a = (1 - k) * 0.6 * alpha;\\n      ctx.strokeStyle = `rgba(${color},${a})`;\\n      ctx.beginPath();\\n      ctx.ellipse(s.x, s.y, s.r * (0.4 + k), s.r * 0.25 * (0.4 + k), 0, 0, Math.PI * 2);\\n      ctx.stroke();\\n      ctx.fillStyle = `rgba(${color},${a})`;\\n      for (const b of s.bits) {\\n        const t = s.t;\\n        ctx.fillRect(s.x + b.dx * t, s.y + b.dy * t + 400 * t * t, 1.6, 1.6);\\n      }\\n    }\\n    // Heavy rain leaves a low spray over the ground.\\n    if (this.opts.intensity === \\\"heavy\\\") {\\n      const g = ctx.createLinearGradient(0, this.h * 0.75, 0, this.h);\\n      g.addColorStop(0, `rgba(${color},0)`);\\n      g.addColorStop(1, `rgba(${color},${0.16 * alpha})`);\\n      ctx.fillStyle = g;\\n      ctx.fillRect(0, this.h * 0.75, this.w, this.h * 0.25);\\n    }\\n    ctx.globalAlpha = 1;\\n  }\\n  count() {\\n    return this.drops.length + this.splashes.length + this.clouds.size;\\n  }\\n}\\n\"}"}}]},"finish_reason":null}]}

