data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":49,"function":{"arguments":"{\"path\":\"client/src/scene/wind.ts\",\"content\":\"import { Clouds, rand, share, type Effect, type EffectOptions } from \\\"./common.ts\\\";\\n\\n// Wind: clouds racing across, long air streaks, tumbling leaves, and a meadow of grass along the\\n// bottom that bends with each gust. Stronger wind means faster, more numerous pieces.\\n\\nconst FULL: Record<string, { streaks: number; leaves: number; grass: number }> = {\\n  light: { streaks: 40, leaves: 24, grass: 140 },\\n  moderate: { streaks: 80, leaves: 50, grass: 170 },\\n  heavy: { streaks: 140, leaves: 90, grass: 200 },\\n};\\n\\ntype Streak = { x: number; y: number; len: number; v: number; a: number; curve: number };\\ntype Leaf = { x: number; y: number; v: number; rot: number; spin: number; phase: number; size: number; hue: number };\\ntype Blade = { x: number; h: number; phase: number; w: number; shade: number };\\n\\nexport class Wind implements Effect {\\n  private clouds: Clouds;\\n  private streaks: Streak[] = [];\\n  private leaves: Leaf[] = [];\\n  private grass: Blade[] = [];\\n  private w = 0;\\n  private h = 0;\\n  private time = 0;\\n  private power: number;\\n  constructor(private opts: EffectOptions) {\\n    this.power = opts.intensity === \\\"heavy\\\" ? 1.5 : opts.intensity === \\\"moderate\\\" ? 1.15 : 0.85;\\n    this.clouds = new Clouds({\\n      color: opts.isDay ? \\\"240,246,252\\\" : \\\"90,120,140\\\",\\n      count: opts.quality >= 2 ? 8 : 5,\\n      top: 0.02,\\n      bottom: 0.4,\\n      speed: 70 * this.power,\\n      alpha: opts.isDay ? 0.6 : 0.45,\\n      scale: [0.8, 1.5],\\n    });\\n  }\\n  private newStreak(anywhere: boolean): Streak {\\n    return {\\n      x: anywhere ? rand(-200, this.w) : rand(-400, -120),\\n      y: rand(0.05, 0.85) * this.h,\\n      len: rand(80, 260),\\n      v: rand(700, 1200) * this.power,\\n      a: rand(0.18, 0.45),\\n      curve: rand(-14, 14),\\n    };\\n  }\\n  private newLeaf(anywhere: boolean): Leaf {\\n    return {\\n      x: anywhere ? rand(-40, this.w) : rand(-120, -20),\\n      y: rand(0.2, 0.92) * this.h,\\n      v: rand(260, 520) * this.power,\\n      rot: rand(0, Math.PI * 2),\\n      spin: rand(-8, 8),\\n      phase: rand(0, Math.PI * 2),\\n      size: rand(4, 9),\\n      hue: rand(25, 95),\\n    };\\n  }\\n  resize(w: number, h: number) {\\n    const first = this.streaks.length === 0;\\n    this.w = w;\\n    this.h = h;\\n    this.clouds.resize(w, h);\\n    const full = FULL[this.opts.intensity]!;\\n    if (first) {\\n      for (let i = 0; i < share(this.opts, full.streaks); i++) this.streaks.push(this.newStreak(true));\\n      for (let i = 0; i < share(this.opts, full.leaves); i++) this.leaves.push(this.newLeaf(true));\\n    }\\n    const blades = Math.round(share(this.opts, full.grass) * Math.min(1.6, w / 1200));\\n    this.grass = [];\\n    for (let i = 0; i < blades; i++) {\\n      this.grass.push({\\n        x: (i / blades) * w + rand(-4, 4),\\n        h: rand(26, 70) * Math.max(0.8, h / 900),\\n        phase: rand(0, Math.PI * 2),\\n        w: rand(2, 4),\\n        shade: rand(0, 1),\\n      });\\n    }\\n  }\\n  /** Gusts rise and fall over a few seconds. */\\n  private gust() {\\n    const t = this.time;\\n    return this.power * (0.55 + 0.25 * Math.sin(t * 0.7) + 0.2 * Math.sin(t * 1.9 + 1.3));\\n  }\\n  update(dt: number) {\\n    this.time += dt;\\n    this.clouds.update(dt);\\n    const g = this.gust();\\n    for (let i = 0; i < this.streaks.length; i++) {\\n      const s = this.streaks[i]!;\\n      s.x += s.v * dt * (0.6 + g * 0.5);\\n      if (s.x - s.len > this.w) this.streaks[i] = this.newStreak(false);\\n    }\\n    for (let i = 0; i < this.leaves.length; i++) {\\n      const l = this.leaves[i]!;\\n      l.x += l.v * dt * (0.6 + g * 0.5);\\n      l.y += Math.sin(this.time * 3 + l.phase) * 60 * dt + 12 * dt;\\n      l.rot += l.spin * dt;\\n      if (l.x > this.w + 30 || l.y > this.h) this.leaves[i] = this.newLeaf(false);\\n    }\\n  }\\n  draw(ctx: CanvasRenderingContext2D, alpha: number) {\\n    this.clouds.draw(ctx, alpha);\\n    const day = this.opts.isDay;\\n    ctx.lineCap = \\\"round\\\";\\n    ctx.lineWidth = 1.5;\\n    for (const s of this.streaks) {\\n      const grad = ctx.createLinearGradient(s.x - s.len, 0, s.x, 0);\\n      grad.addColorStop(0, \\\"rgba(255,255,255,0)\\\");\\n      grad.addColorStop(0.7, `rgba(255,255,255,${s.a * alpha * (day ? 1 : 0.7)})`);\\n      grad.addColorStop(1, \\\"rgba(255,255,255,0)\\\");\\n      ctx.strokeStyle = grad;\\n      ctx.beginPath();\\n      ctx.moveTo(s.x - s.len, s.y);\\n      ctx.quadraticCurveTo(s.x - s.len / 2, s.y + s.curve, s.x, s.y);\\n      ctx.stroke();\\n    }\\n    for (const l of this.leaves) {\\n      ctx.save();\\n      ctx.translate(l.x, l.y);\\n      ctx.rotate(l.rot);\\n      ctx.scale(1, Math.abs(Math.sin(l.rot * 0.7)) * 0.7 + 0.3);\\n      ctx.fillStyle = day ? `hsla(${l.hue},60%,42%,${0.9 * alpha})` : `hsla(${l.hue},30%,30%,${0.85 * alpha})`;\\n      ctx.beginPath();\\n      ctx.ellipse(0, 0, l.size, l.size * 0.45, 0, 0, Math.PI * 2);\\n      ctx.fill();\\n      ctx.restore();\\n    }\\n    // Grass bends with the gust, each blade a little out of step with its neighbours.\\n    const g = this.gust();\\n    const base = this.h + 2;\\n    for (const b of this.grass) {\\n      const bend = (g * 0.75 + Math.sin(this.time * 4 + b.phase) * 0.12 * g) * b.h;\\n      const light = day ? 26 + b.shade * 14 : 12 + b.shade * 8;\\n      ctx.fillStyle = `hsla(${day ? 95 : 160},${day ? 35 : 20}%,${light}%,${alpha})`;\\n      ctx.beginPath();\\n      ctx.moveTo(b.x - b.w, base);\\n      ctx.quadraticCurveTo(b.x + bend * 0.35, base - b.h * 0.6, b.x + bend, base - b.h + Math.abs(bend) * 0.35);\\n      ctx.quadraticCurveTo(b.x + bend * 0.35 + b.w * 0.5, base - b.h * 0.6, b.x + b.w, base);\\n      ctx.fill();\\n    }\\n  }\\n  count() {\\n    return this.streaks.length + this.leaves.length + this.grass.length + this.clouds.size;\\n  }\\n}\\n\"}"}}]},"finish_reason":null}]}

