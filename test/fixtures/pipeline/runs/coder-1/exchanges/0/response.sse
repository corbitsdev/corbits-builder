data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":27,"function":{"arguments":"{\"path\":\"client/src/lib/weather.ts\",\"content\":\"import type { Forecast } from \\\"@app/shared\\\";\\n\\n// Turns Open-Meteo's weather codes (WMO codes) into one of the seven scenes plus an intensity, and\\n// picks day or night from the city's own sunrise and sunset, never the viewer's clock.\\n\\nexport type Condition = \\\"clear\\\" | \\\"hot\\\" | \\\"cloudy\\\" | \\\"rain\\\" | \\\"storm\\\" | \\\"snow\\\" | \\\"wind\\\" | \\\"fog\\\";\\nexport type Intensity = \\\"light\\\" | \\\"moderate\\\" | \\\"heavy\\\";\\nexport type WxKey = `${Condition}-${\\\"day\\\" | \\\"night\\\"}` | \\\"calm\\\";\\nexport type IconName =\\n  | \\\"sun\\\"\\n  | \\\"moon\\\"\\n  | \\\"cloud\\\"\\n  | \\\"cloud-sun\\\"\\n  | \\\"cloud-moon\\\"\\n  | \\\"rain\\\"\\n  | \\\"drizzle\\\"\\n  | \\\"storm\\\"\\n  | \\\"snow\\\"\\n  | \\\"wind\\\"\\n  | \\\"fog\\\";\\n\\n/** Clear weather above this temperature (°C) shows the hot scene. */\\nexport const HOT_THRESHOLD_C = 30;\\n/** Sustained wind (km/h) or gusts at which a dry scene becomes the wind scene. */\\nconst WIND_KMH = 30;\\nconst GUST_KMH = 50;\\n\\ntype CodeInfo = { text: string; condition: Condition; intensity: Intensity; icon: IconName };\\n\\nconst CODES: Record<number, CodeInfo> = {\\n  0: { text: \\\"Clear\\\", condition: \\\"clear\\\", intensity: \\\"moderate\\\", icon: \\\"sun\\\" },\\n  1: { text: \\\"Mostly clear\\\", condition: \\\"clear\\\", intensity: \\\"light\\\", icon: \\\"sun\\\" },\\n  2: { text: \\\"Partly cloudy\\\", condition: \\\"cloudy\\\", intensity: \\\"light\\\", icon: \\\"cloud-sun\\\" },\\n  3: { text: \\\"Overcast\\\", condition: \\\"cloudy\\\", intensity: \\\"heavy\\\", icon: \\\"cloud\\\" },\\n  45: { text: \\\"Fog\\\", condition: \\\"fog\\\", intensity: \\\"moderate\\\", icon: \\\"fog\\\" },\\n  48: { text: \\\"Freezing fog\\\", condition: \\\"fog\\\", intensity: \\\"heavy\\\", icon: \\\"fog\\\" },\\n  51: { text: \\\"Light drizzle\\\", condition: \\\"rain\\\", intensity: \\\"light\\\", icon: \\\"drizzle\\\" },\\n  53: { text: \\\"Drizzle\\\", condition: \\\"rain\\\", intensity: \\\"light\\\", icon: \\\"drizzle\\\" },\\n  55: { text: \\\"Heavy drizzle\\\", condition: \\\"rain\\\", intensity: \\\"moderate\\\", icon: \\\"drizzle\\\" },\\n  56: { text: \\\"Freezing drizzle\\\", condition: \\\"rain\\\", intensity: \\\"light\\\", icon: \\\"drizzle\\\" },\\n  57: { text: \\\"Freezing drizzle\\\", condition: \\\"rain\\\", intensity: \\\"moderate\\\", icon: \\\"drizzle\\\" },\\n  61: { text: \\\"Light rain\\\", condition: \\\"rain\\\", intensity: \\\"light\\\", icon: \\\"rain\\\" },\\n  63: { text: \\\"Moderate rain\\\", condition: \\\"rain\\\", intensity: \\\"moderate\\\", icon: \\\"rain\\\" },\\n  65: { text: \\\"Heavy rain\\\", condition: \\\"rain\\\", intensity: \\\"heavy\\\", icon: \\\"rain\\\" },\\n  66: { text: \\\"Freezing rain\\\", condition: \\\"rain\\\", intensity: \\\"light\\\", icon: \\\"rain\\\" },\\n  67: { text: \\\"Heavy freezing rain\\\", condition: \\\"rain\\\", intensity: \\\"heavy\\\", icon: \\\"rain\\\" },\\n  71: { text: \\\"Light snow\\\", condition: \\\"snow\\\", intensity: \\\"light\\\", icon: \\\"snow\\\" },\\n  73: { text: \\\"Snow\\\", condition: \\\"snow\\\", intensity: \\\"moderate\\\", icon: \\\"snow\\\" },\\n  75: { text: \\\"Heavy snow\\\", condition: \\\"snow\\\", intensity: \\\"heavy\\\", icon: \\\"snow\\\" },\\n  77: { text: \\\"Snow grains\\\", condition: \\\"snow\\\", intensity: \\\"light\\\", icon: \\\"snow\\\" },\\n  80: { text: \\\"Light showers\\\", condition: \\\"rain\\\", intensity: \\\"light\\\", icon: \\\"drizzle\\\" },\\n  81: { text: \\\"Showers\\\", condition: \\\"rain\\\", intensity: \\\"moderate\\\", icon: \\\"rain\\\" },\\n  82: { text: \\\"Heavy showers\\\", condition: \\\"rain\\\", intensity: \\\"heavy\\\", icon: \\\"rain\\\" },\\n  85: { text: \\\"Snow showers\\\", condition: \\\"snow\\\", intensity: \\\"moderate\\\", icon: \\\"snow\\\" },\\n  86: { text: \\\"Heavy snow showers\\\", condition: \\\"snow\\\", intensity: \\\"heavy\\\", icon: \\\"snow\\\" },\\n  95: { text: \\\"Thunderstorm\\\", condition: \\\"storm\\\", intensity: \\\"moderate\\\", icon: \\\"storm\\\" },\\n  96: { text: \\\"Thunderstorm with hail\\\", condition: \\\"storm\\\", intensity: \\\"heavy\\\", icon: \\\"storm\\\" },\\n  99: { text: \\\"Thunderstorm with heavy hail\\\", condition: \\\"storm\\\", intensity: \\\"heavy\\\", icon: \\\"storm\\\" },\\n};\\n\\nexport function codeInfo(code: number | null | undefined): CodeInfo {\\n  return CODES[code ?? 0] ?? { text: \\\"Unsettled\\\", condition: \\\"cloudy\\\", intensity: \\\"moderate\\\", icon: \\\"cloud\\\" };\\n}\\n\\n/** The icon for a code at a given time of day (sun and moon swap at night). */\\nexport function iconFor(code: number | null | undefined, isDay: boolean): IconName {\\n  const icon = codeInfo(code).icon;\\n  if (isDay) return icon;\\n  if (icon === \\\"sun\\\") return \\\"moon\\\";\\n  if (icon === \\\"cloud-sun\\\") return \\\"cloud-moon\\\";\\n  return icon;\\n}\\n\\nexport type Scene = {\\n  condition: Condition;\\n  intensity: Intensity;\\n  isDay: boolean;\\n  key: WxKey;\\n  /** Plain words for the scene, e.g. \\\"Moderate rain, day\\\". */\\n  label: string;\\n};\\n\\nconst INTENSITY_WORD: Record<Intensity, string> = { light: \\\"Light\\\", moderate: \\\"Moderate\\\", heavy: \\\"Heavy\\\" };\\nconst CONDITION_WORD: Record<Condition, string> = {\\n  clear: \\\"clear sky\\\",\\n  hot: \\\"heat\\\",\\n  cloudy: \\\"cloud\\\",\\n  rain: \\\"rain\\\",\\n  storm: \\\"storm\\\",\\n  snow: \\\"snow\\\",\\n  wind: \\\"wind\\\",\\n  fog: \\\"fog\\\",\\n};\\n\\nexport function sceneLabel(condition: Condition, intensity: Intensity, isDay: boolean) {\\n  const time = isDay ? \\\"day\\\" : \\\"night\\\";\\n  if (condition === \\\"clear\\\") return `Clear sky, ${time}`;\\n  if (condition === \\\"hot\\\") return `Hot and clear, ${time}`;\\n  if (condition === \\\"cloudy\\\")\\n    return `${intensity === \\\"light\\\" ? \\\"Partly cloudy\\\" : intensity === \\\"heavy\\\" ? \\\"Overcast\\\" : \\\"Cloudy\\\"}, ${time}`;\\n  if (condition === \\\"wind\\\")\\n    return `${intensity === \\\"light\\\" ? \\\"Breezy\\\" : intensity === \\\"heavy\\\" ? \\\"Strong wind\\\" : \\\"Windy\\\"}, ${time}`;\\n  if (condition === \\\"fog\\\") return `${intensity === \\\"heavy\\\" ? \\\"Thick fog\\\" : \\\"Fog\\\"}, ${time}`;\\n  if (condition === \\\"storm\\\") return `${intensity === \\\"heavy\\\" ? \\\"Severe thunderstorm\\\" : \\\"Thunderstorm\\\"}, ${time}`;\\n  return `${INTENSITY_WORD[intensity]} ${CONDITION_WORD[condition]}, ${time}`;\\n}\\n\\nexport function makeScene(condition: Condition, intensity: Intensity, isDay: boolean): Scene {\\n  return {\\n    condition,\\n    intensity,\\n    isDay,\\n    key: `${condition}-${isDay ? \\\"day\\\" : \\\"night\\\"}`,\\n    label: sceneLabel(condition, intensity, isDay),\\n  };\\n}\\n\\n/** Is it daytime at the city right now? Uses that city's sunrise and sunset for today. */\\nexport function isDayAt(f: Forecast, at = f.current.time): boolean {\\n  const i = dayIndex(f, at);\\n  const rise = f.daily.sunrise[i];\\n  const set = f.daily.sunset[i];\\n  // Polar day or night: Open-Meteo reports equal or missing times, so fall back to its own flag.\\n  if (!rise || !set || rise === set) return f.current.is_day === 1;\\n  return at >= rise && at < set;\\n}\\n\\n/** Index of the day containing a moment, in the city's local calendar. */\\nexport function dayIndex(f: Forecast, at: number): number {\\n  let index = 0;\\n  for (let i = 0; i < f.daily.time.length; i++) if (f.daily.time[i]! <= at) index = i;\\n  return index;\\n}\\n\\nexport function sceneFor(f: Forecast): Scene {\\n  const c = f.current;\\n  const info = codeInfo(c.weather_code);\\n  let condition = info.condition;\\n  let intensity = info.intensity;\\n  const dry = condition === \\\"clear\\\" || condition === \\\"cloudy\\\";\\n  if (dry && (c.wind_speed_10m >= WIND_KMH || c.wind_gusts_10m >= GUST_KMH)) {\\n    condition = \\\"wind\\\";\\n    intensity = c.wind_speed_10m >= 55 || c.wind_gusts_10m >= 80 ? \\\"heavy\\\" : c.wind_speed_10m >= 40 ? \\\"moderate\\\" : \\\"light\\\";\\n  } else if (condition === \\\"clear\\\" && c.temperature_2m > HOT_THRESHOLD_C) {\\n    condition = \\\"hot\\\";\\n    intensity = c.temperature_2m > 38 ? \\\"heavy\\\" : \\\"moderate\\\";\\n  }\\n  return makeScene(condition, intensity, isDayAt(f));\\n}\\n\\n/** Plain words for what's happening now (\\\"Sunny and hot\\\", \\\"Windy\\\", \\\"Moderate rain\\\"). */\\nexport function conditionText(f: Forecast): string {\\n  const scene = sceneFor(f);\\n  const text = codeInfo(f.current.weather_code).text;\\n  if (scene.condition === \\\"hot\\\") return scene.isDay ? \\\"Sunny and hot\\\" : \\\"Clear and hot\\\";\\n  if (scene.condition === \\\"wind\\\") return scene.isDay && f.current.weather_code <= 1 ? \\\"Sunny and windy\\\" : `Windy, ${text.toLowerCase()}`;\\n  if (scene.condition === \\\"clear\\\" && scene.isDay && f.current.weather_code === 0) return \\\"Sunny\\\";\\n  return text;\\n}\\n\\n/** Parse the test route value, e.g. \\\"rain-heavy-night\\\" or \\\"storm-day\\\". */\\nexport function parseForced(value: string | null): Scene | null {\\n  if (!value) return null;\\n  const parts = value.toLowerCase().split(\\\"-\\\");\\n  const condition = parts[0] as Condition;\\n  if (!(condition in CONDITION_WORD)) return null;\\n  const intensity = ([\\\"light\\\", \\\"moderate\\\", \\\"heavy\\\"].find((i) => parts.includes(i)) ?? \\\"moderate\\\") as Intensity;\\n  const isDay = !parts.includes(\\\"night\\\");\\n  return makeScene(condition, intensity, isDay);\\n}\\n\\nexport const ALL_CONDITIONS: Condition[] = [\\\"clear\\\", \\\"hot\\\", \\\"cloudy\\\", \\\"rain\\\", \\\"storm\\\", \\\"snow\\\", \\\"wind\\\", \\\"fog\\\"];\\nexport const CONDITION_NAMES: Record<Condition, string> = {\\n  clear: \\\"Clear\\\",\\n  hot: \\\"Hot\\\",\\n  cloudy: \\\"Cloudy\\\",\\n  rain: \\\"Rain\\\",\\n  storm: \\\"Storm\\\",\\n  snow: \\\"Snow\\\",\\n  wind: \\\"Wind\\\",\\n  fog: \\\"Fog\\\",\\n};\\nexport const CONDITION_ICON: Record<Condition, [IconName, IconName]> = {\\n  clear: [\\\"sun\\\", \\\"moon\\\"],\\n  hot: [\\\"sun\\\", \\\"moon\\\"],\\n  cloudy: [\\\"cloud\\\", \\\"cloud\\\"],\\n  rain: [\\\"rain\\\", \\\"rain\\\"],\\n  storm: [\\\"storm\\\", \\\"storm\\\"],\\n  snow: [\\\"snow\\\", \\\"snow\\\"],\\n  wind: [\\\"wind\\\", \\\"wind\\\"],\\n  fog: [\\\"fog\\\", \\\"fog\\\"],\\n};\\n\"}"}}]},"finish_reason":null}]}

