data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":8,"function":{"arguments":"{\"path\":\"client/public/icon.svg\",\"content\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 512 512\\\">\\n  <defs>\\n    <linearGradient id=\\\"sky\\\" x1=\\\"0\\\" y1=\\\"0\\\" x2=\\\"0\\\" y2=\\\"1\\\">\\n      <stop offset=\\\"0\\\" stop-color=\\\"#3f5876\\\"/>\\n      <stop offset=\\\"1\\\" stop-color=\\\"#8ea2b7\\\"/>\\n    </linearGradient>\\n  </defs>\\n  <rect width=\\\"512\\\" height=\\\"512\\\" rx=\\\"112\\\" fill=\\\"url(#sky)\\\"/>\\n  <circle cx=\\\"330\\\" cy=\\\"180\\\" r=\\\"70\\\" fill=\\\"#fff8e1\\\"/>\\n  <path d=\\\"M150 330a80 80 0 0 1 77-100 100 100 0 0 1 190 30 62 62 0 0 1-12 123H170a60 60 0 0 1-20-53Z\\\" fill=\\\"#fff\\\" opacity=\\\".95\\\"/>\\n  <g stroke=\\\"#dfe9f5\\\" stroke-width=\\\"12\\\" stroke-linecap=\\\"round\\\">\\n    <path d=\\\"M200 410l-14 34\\\"/><path d=\\\"M262 410l-14 34\\\"/><path d=\\\"M324 410l-14 34\\\"/>\\n  </g>\\n</svg>\\n\"}"}}]},"finish_reason":null}]}

