data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":40,"function":{"arguments":"{\"path\":\"client/src/scene/cloud.ts\",\"content\":\"import { Clouds, dotSprite, type Effect, type EffectOptions } from \\\"./common.ts\\\";\\n\\n// Cloudy: several cloud layers drifting at different speeds for depth. Partly cloudy leaves gaps\\n// with the sun (or moon) showing through; overcast fills the sky with heavier grey cloud.\\n\\nexport class Cloudy implements Effect {\\n  private layers: Clouds[];\\n  private w = 0;\\n  private h = 0;\\n  private glow = dotSprite(\\\"255,244,214\\\", 64);\\n  constructor(private opts: EffectOptions) {\\n    const day = opts.isDay;\\n    const overcast = opts.intensity === \\\"heavy\\\";\\n    const q = opts.quality;\\n    const base = overcast ? (day ? \\\"225,230,238\\\" : \\\"95,105,125\\\") : day ? \\\"255,255,255\\\" : \\\"110,122,146\\\";\\n    const dark = overcast ? (day ? \\\"170,180,195\\\" : \\\"60,68,86\\\") : day ? \\\"230,236,244\\\" : \\\"80,90,112\\\";\\n    this.layers = [\\n      new Clouds({ color: dark, count: q >= 2 ? 8 : 4, top: 0.0, bottom: 0.35, speed: 6, alpha: 0.7, scale: [1.3, 2.2] }),\\n      new Clouds({ color: base, count: q >= 2 ? (overcast ? 10 : 6) : 4, top: 0.15, bottom: 0.6, speed: 12, alpha: overcast ? 0.75 : 0.65, scale: [1.0, 1.8] }),\\n    ];\\n    if (q >= 2) {\\n      this.layers.push(new Clouds({ color: base, count: overcast ? 6 : 3, top: 0.5, bottom: 0.85, speed: 22, alpha: 0.4, scale: [1.4, 2.4] }));\\n    }\\n  }\\n  resize(w: number, h: number) {\\n    this.w = w;\\n    this.h = h;\\n    for (const l of this.layers) l.resize(w, h);\\n  }\\n  update(dt: number) {\\n    for (const l of this.layers) l.update(dt);\\n  }\\n  draw(ctx: CanvasRenderingContext2D, alpha: number) {\\n    if (this.opts.intensity !== \\\"heavy\\\") {\\n      // The sun or moon behind thinner cloud.\\n      const r = this.opts.isDay ? 220 : 120;\\n      ctx.globalAlpha = (this.opts.isDay ? 0.55 : 0.3) * alpha;\\n      ctx.drawImage(this.glow, this.w * 0.78 - r, this.h * 0.14 - r, r * 2, r * 2);\\n      ctx.globalAlpha = 1;\\n    }\\n    for (const l of this.layers) l.draw(ctx, alpha);\\n  }\\n  count() {\\n    return this.layers.reduce((n, l) => n + l.size, 0);\\n  }\\n}\\n\"}"}}]},"finish_reason":null}]}

