data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":21,"function":{"arguments":"{\"path\":\"client/src/lib/location.ts\",\"content\":\"import { useSyncExternalStore } from \\\"react\\\";\\nimport { Forecast } from \\\"@app/shared\\\";\\nimport { fetchNearest, getJson } from \\\"../api.ts\\\";\\nimport { distanceKm } from \\\"./geo.ts\\\";\\nimport { getState, store } from \\\"./storage.ts\\\";\\n\\n// The browser's own location feature. It is asked only on first open and when the person taps\\n// \\\"Use my location\\\"; the coordinates go only to the weather lookup.\\n\\nexport type LocateResult = \\\"found\\\" | \\\"denied\\\" | \\\"unavailable\\\";\\n\\nlet busy = false;\\nconst listeners = new Set<() => void>();\\nconst setBusy = (b: boolean) => {\\n  busy = b;\\n  for (const l of listeners) l();\\n};\\nexport const useLocating = () =>\\n  useSyncExternalStore(\\n    (l) => {\\n      listeners.add(l);\\n      return () => listeners.delete(l);\\n    },\\n    () => busy,\\n  );\\n\\nfunction position(): Promise<GeolocationPosition> {\\n  return new Promise((resolve, reject) => {\\n    if (!(\\\"geolocation\\\" in navigator)) {\\n      reject({ code: 2 });\\n      return;\\n    }\\n    navigator.geolocation.getCurrentPosition(resolve, reject, {\\n      enableHighAccuracy: false,\\n      timeout: 20_000,\\n      maximumAge: 10 * 60_000,\\n    });\\n  });\\n}\\n\\n/** Ask for the device location and name it after the nearest city, or \\\"My location\\\". */\\nexport async function locate(): Promise<LocateResult> {\\n  if (busy) return \\\"unavailable\\\";\\n  setBusy(true);\\n  try {\\n    const pos = await position();\\n    const lat = pos.coords.latitude;\\n    const lon = pos.coords.longitude;\\n    store.setLocationState(\\\"granted\\\");\\n    const previous = getState().here;\\n    // Same place as before: keep its name, just refresh the time.\\n    if (previous && previous.name && distanceKm(previous.lat, previous.lon, lat, lon) < 3) {\\n      store.setHere({ ...previous, lat, lon, at: Date.now() });\\n      return \\\"found\\\";\\n    }\\n    store.setHere({ lat, lon, name: null, admin1: null, country: null, at: Date.now() });\\n    try {\\n      const f = await getJson(`/api/forecast?lat=${lat.toFixed(2)}&lon=${lon.toFixed(2)}`, Forecast);\\n      const near = await fetchNearest(lat, lon, f.timezone);\\n      const here = getState().here;\\n      if (here && here.lat === lat && here.lon === lon) store.setHere({ ...here, ...near });\\n    } catch {\\n      // No name: the place is shown as \\\"My location\\\".\\n    }\\n    return \\\"found\\\";\\n  } catch (error) {\\n    const code = (error as { code?: number }).code;\\n    if (code === 1) {\\n      store.setLocationState(\\\"denied\\\");\\n      return \\\"denied\\\";\\n    }\\n    if (getState().settings.location === \\\"unknown\\\") store.setLocationState(\\\"denied\\\");\\n    return \\\"unavailable\\\";\\n  } finally {\\n    setBusy(false);\\n  }\\n}\\n\\n/** Whether the browser already allows location, without asking. */\\nexport async function permissionGranted(): Promise<boolean> {\\n  try {\\n    const status = await navigator.permissions.query({ name: \\\"geolocation\\\" });\\n    return status.state === \\\"granted\\\";\\n  } catch {\\n    return false;\\n  }\\n}\\n\"}"}}]},"finish_reason":null}]}

