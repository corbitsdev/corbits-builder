data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":25,"function":{"arguments":"{\"path\":\"client/src/lib/use-locate.ts\",\"content\":\"import { useNavigate } from \\\"react-router\\\";\\nimport { toast } from \\\"@corbits/react-ui/ui/toast\\\";\\nimport { locate, useLocating } from \\\"./location.ts\\\";\\n\\n/** \\\"Use my location\\\": asks the browser, then shows My location on Home. */\\nexport function useLocateAction() {\\n  const navigate = useNavigate();\\n  const locating = useLocating();\\n  const run = async () => {\\n    toast(\\\"Checking your location…\\\");\\n    const result = await locate();\\n    if (result === \\\"found\\\") navigate(\\\"/?city=here\\\");\\n    else if (result === \\\"denied\\\") toast(\\\"Location is still blocked. Allow it in your browser's settings, then try again.\\\");\\n    else toast(\\\"We couldn't find your location just now. Try again, or search for a city.\\\");\\n  };\\n  return { locate: run, locating };\\n}\\n\"}"}}]},"finish_reason":null}]}

