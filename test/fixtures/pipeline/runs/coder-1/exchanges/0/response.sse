data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":39,"function":{"arguments":"{\"path\":\"client/src/scene/clear.ts\",\"content\":\"import { Clouds, dotSprite, rand, share, type Effect, type EffectOptions } from \\\"./common.ts\\\";\\n\\n// Clear sky. By day: a bright sun with slowly turning rays, a few thin high clouds and drifting\\n// motes of light. By night: a moon and a field of gently twinkling stars.\\n\\ntype Star = { x: number; y: number; r: number; phase: number; speed: number };\\ntype Mote = { x: number; y: number; v: number; r: number; phase: number };\\n\\nexport class Clear implements Effect {\\n  protected w = 0;\\n  protected h = 0;\\n  protected time = 0;\\n  private stars: Star[] = [];\\n  private motes: Mote[] = [];\\n  private wisps: Clouds | null;\\n  private glow = dotSprite(\\\"255,240,200\\\", 64);\\n  private moonGlow = dotSprite(\\\"244,241,230\\\", 64);\\n  constructor(protected opts: EffectOptions, protected sunScale = 1) {\\n    this.wisps =\\n      opts.intensity === \\\"light\\\" && opts.isDay\\n        ? new Clouds({ color: \\\"255,255,255\\\", count: 3, top: 0.1, bottom: 0.4, speed: 8, alpha: 0.45, scale: [0.7, 1.1] })\\n        : null;\\n  }\\n  resize(w: number, h: number) {\\n    const first = this.stars.length === 0 && this.motes.length === 0;\\n    this.w = w;\\n    this.h = h;\\n    this.wisps?.resize(w, h);\\n    if (!first) return;\\n    if (!this.opts.isDay) {\\n      const n = share(this.opts, 320);\\n      for (let i = 0; i < n; i++) {\\n        this.stars.push({\\n          x: Math.random() * w,\\n          y: Math.random() ** 1.5 * h * 0.85,\\n          r: Math.random() < 0.08 ? rand(1.2, 1.9) : rand(0.4, 1.1),\\n          phase: rand(0, Math.PI * 2),\\n          speed: rand(0.6, 2.2),\\n        });\\n      }\\n    } else {\\n      const n = share(this.opts, 40);\\n      for (let i = 0; i < n; i++) this.motes.push(this.newMote(true));\\n    }\\n  }\\n  private newMote(anywhere: boolean): Mote {\\n    return {\\n      x: rand(0, this.w),\\n      y: anywhere ? rand(0, this.h) : this.h + 10,\\n      v: rand(6, 18),\\n      r: rand(2, 6),\\n      phase: rand(0, Math.PI * 2),\\n    };\\n  }\\n  update(dt: number) {\\n    this.time += dt;\\n    this.wisps?.update(dt);\\n    for (let i = 0; i < this.motes.length; i++) {\\n      const m = this.motes[i]!;\\n      m.y -= m.v * dt;\\n      m.x += Math.sin(this.time * 0.5 + m.phase) * 6 * dt;\\n      if (m.y < -10) this.motes[i] = this.newMote(false);\\n    }\\n  }\\n  protected sunAt() {\\n    return { x: this.w * 0.8, y: Math.min(this.h * 0.16, 150) };\\n  }\\n  protected drawSun(ctx: CanvasRenderingContext2D, alpha: number) {\\n    const { x, y } = this.sunAt();\\n    const r = 48 * this.sunScale;\\n    ctx.globalAlpha = 0.6 * alpha;\\n    const g = r * 9;\\n    ctx.drawImage(this.glow, x - g / 2, y - g / 2, g, g);\\n    // Rays turn slowly (held still under reduced motion).\\n    ctx.save();\\n    ctx.translate(x, y);\\n    ctx.rotate(this.opts.still ? 0 : this.time * 0.03);\\n    ctx.fillStyle = `rgba(255,248,225,${0.12 * alpha})`;\\n    for (let i = 0; i < 14; i++) {\\n      ctx.rotate((Math.PI * 2) / 14);\\n      ctx.beginPath();\\n      ctx.moveTo(-6, r * 1.2);\\n      ctx.lineTo(6, r * 1.2);\\n      ctx.lineTo(0, r * (i % 2 ? 4.2 : 6));\\n      ctx.fill();\\n    }\\n    ctx.restore();\\n    ctx.globalAlpha = alpha;\\n    ctx.fillStyle = \\\"#fff8e1\\\";\\n    ctx.beginPath();\\n    ctx.arc(x, y, r, 0, Math.PI * 2);\\n    ctx.fill();\\n    ctx.globalAlpha = 1;\\n  }\\n  protected drawNight(ctx: CanvasRenderingContext2D, alpha: number, starShare = 1) {\\n    ctx.fillStyle = \\\"#fff\\\";\\n    const limit = Math.round(this.stars.length * starShare);\\n    for (let i = 0; i < limit; i++) {\\n      const s = this.stars[i]!;\\n      const tw = this.opts.still ? 0.8 : 0.55 + 0.45 * Math.sin(this.time * s.speed + s.phase);\\n      ctx.globalAlpha = tw * alpha;\\n      ctx.fillRect(s.x, s.y, s.r * 1.6, s.r * 1.6);\\n    }\\n    const x = this.w * 0.78;\\n    const y = Math.min(this.h * 0.16, 140);\\n    ctx.globalAlpha = 0.35 * alpha;\\n    ctx.drawImage(this.moonGlow, x - 110, y - 110, 220, 220);\\n    ctx.globalAlpha = alpha;\\n    ctx.fillStyle = \\\"#f4f1e6\\\";\\n    ctx.beginPath();\\n    ctx.arc(x, y, 30, 0, Math.PI * 2);\\n    ctx.fill();\\n    // Craters.\\n    ctx.fillStyle = \\\"rgba(200,196,182,0.55)\\\";\\n    for (const [dx, dy, r] of [\\n      [-9, -6, 6],\\n      [8, 7, 4.5],\\n      [6, -10, 3],\\n    ] as const) {\\n      ctx.beginPath();\\n      ctx.arc(x + dx, y + dy, r, 0, Math.PI * 2);\\n      ctx.fill();\\n    }\\n    ctx.globalAlpha = 1;\\n  }\\n  draw(ctx: CanvasRenderingContext2D, alpha: number) {\\n    if (!this.opts.isDay) {\\n      this.drawNight(ctx, alpha);\\n      return;\\n    }\\n    this.drawSun(ctx, alpha);\\n    this.wisps?.draw(ctx, alpha);\\n    for (const m of this.motes) {\\n      ctx.globalAlpha = 0.25 * alpha;\\n      ctx.drawImage(this.glow, m.x - m.r, m.y - m.r, m.r * 2, m.r * 2);\\n    }\\n    ctx.globalAlpha = 1;\\n  }\\n  count() {\\n    return this.stars.length + this.motes.length + (this.wisps?.size ?? 0);\\n  }\\n}\\n\"}"}}]},"finish_reason":null}]}

