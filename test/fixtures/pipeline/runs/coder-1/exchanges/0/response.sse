data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":23,"function":{"arguments":"{\"path\":\"client/src/lib/scene-state.ts\",\"content\":\"import { useEffect, useSyncExternalStore } from \\\"react\\\";\\nimport type { Scene } from \\\"./weather.ts\\\";\\nimport { getState, store } from \\\"./storage.ts\\\";\\n\\n// Which scene is behind the app right now. Home sets it from the shown city's weather; Search,\\n// Saved cities and Settings keep the last city's scene; Compare and the loading, location-off and\\n// first-visit states ask for the calm one.\\n\\nexport type ShownScene = Pick<Scene, \\\"condition\\\" | \\\"intensity\\\" | \\\"isDay\\\" | \\\"key\\\" | \\\"label\\\"> | null;\\n\\nlet current: ShownScene = null;\\nconst listeners = new Set<() => void>();\\n\\nfunction set(scene: ShownScene) {\\n  if (current?.key === scene?.key && current?.intensity === scene?.intensity) return;\\n  current = scene;\\n  for (const l of listeners) l();\\n}\\n\\nexport const useShownScene = () =>\\n  useSyncExternalStore(\\n    (l) => {\\n      listeners.add(l);\\n      return () => listeners.delete(l);\\n    },\\n    () => current,\\n  );\\n\\n/** Show a city's scene (and remember it for the other screens), or the calm one for null. */\\nexport function useScene(scene: ShownScene | \\\"keep\\\", remember = true) {\\n  const key = scene === \\\"keep\\\" ? \\\"keep\\\" : scene ? `${scene.key}:${scene.intensity}` : \\\"calm\\\";\\n  useEffect(() => {\\n    if (scene === \\\"keep\\\") {\\n      const last = getState().lastScene;\\n      if (!last) return set(null);\\n      const [condition, time] = last.key.split(\\\"-\\\") as [Scene[\\\"condition\\\"], string];\\n      set({ condition, intensity: last.intensity, isDay: time === \\\"day\\\", key: last.key as Scene[\\\"key\\\"], label: \\\"\\\" });\\n      return;\\n    }\\n    set(scene);\\n    if (scene && remember) store.setLastScene({ key: scene.key, intensity: scene.intensity });\\n    // `key` stands for the scene's fields.\\n    // eslint-disable-next-line react-hooks/exhaustive-deps\\n  }, [key, remember]);\\n}\\n\"}"}}]},"finish_reason":null}]}

