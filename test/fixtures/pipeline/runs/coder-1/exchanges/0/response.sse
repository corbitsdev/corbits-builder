data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":22,"function":{"arguments":"{\"path\":\"client/src/lib/places.ts\",\"content\":\"import type { Forecast } from \\\"@app/shared\\\";\\nimport { MY_LOCATION_ID, type MyLocation, type SavedCity } from \\\"./storage.ts\\\";\\nimport { conditionText, iconFor, isDayAt, sceneFor } from \\\"./weather.ts\\\";\\n\\n/** A place the app can show: the device location or a saved or previewed city. */\\nexport type Place = {\\n  id: string;\\n  name: string;\\n  admin1?: string | null;\\n  country?: string | null;\\n  lat: number;\\n  lon: number;\\n  isHere: boolean;\\n};\\n\\nexport function hereAsPlace(here: MyLocation): Place {\\n  return {\\n    id: MY_LOCATION_ID,\\n    name: here.name ?? \\\"My location\\\",\\n    admin1: here.admin1,\\n    country: here.country,\\n    lat: here.lat,\\n    lon: here.lon,\\n    isHere: true,\\n  };\\n}\\n\\nexport const cityAsPlace = (c: SavedCity): Place => ({ ...c, isHere: false });\\n\\n/** \\\"England, United Kingdom\\\" */\\nexport const region = (p: { admin1?: string | null; country?: string | null; name?: string }) =>\\n  [p.admin1, p.country].filter((x, i, xs) => x && xs.indexOf(x) === i).join(\\\", \\\");\\n\\n/** Where Home shows a place: saved places and My location by id, others by coordinates. */\\nexport function placeHref(p: Place, saved: boolean): string {\\n  if (p.isHere || saved) return `/?city=${encodeURIComponent(p.id)}`;\\n  const q = new URLSearchParams({ lat: String(p.lat), lon: String(p.lon), name: p.name });\\n  if (p.admin1) q.set(\\\"admin1\\\", p.admin1);\\n  if (p.country) q.set(\\\"country\\\", p.country);\\n  return `/?${q}`;\\n}\\n\\n/** Chip, temperature and words for a place's weather. */\\nexport function glance(f: Forecast) {\\n  const scene = sceneFor(f);\\n  return {\\n    wx: scene.key,\\n    icon: iconFor(f.current.weather_code, isDayAt(f)),\\n    text: conditionText(f),\\n    tempC: f.current.temperature_2m,\\n    scene,\\n  };\\n}\\n\"}"}}]},"finish_reason":null}]}

