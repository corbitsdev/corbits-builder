data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":54,"function":{"arguments":"{\"path\":\"server/src/openMeteo.ts\",\"content\":\"// Relays requests to Open-Meteo's free forecast and city-search services, exactly as they document\\n// them (https://open-meteo.com/en/docs and https://open-meteo.com/en/docs/geocoding-api).\\n// Nothing is stored: answers are kept in memory for five minutes so repeat lookups (switching\\n// between cities, a search typed twice) do not spend the free service's daily allowance.\\n\\nconst FORECAST_URL = \\\"https://api.open-meteo.com/v1/forecast\\\";\\nconst SEARCH_URL = \\\"https://geocoding-api.open-meteo.com/v1/search\\\";\\nconst TTL_MS = 5 * 60_000;\\nconst TIMEOUT_MS = 10_000;\\nconst MAX_ENTRIES = 500;\\n\\nconst CURRENT = [\\n  \\\"temperature_2m\\\",\\n  \\\"apparent_temperature\\\",\\n  \\\"relative_humidity_2m\\\",\\n  \\\"dew_point_2m\\\",\\n  \\\"is_day\\\",\\n  \\\"precipitation\\\",\\n  \\\"weather_code\\\",\\n  \\\"wind_speed_10m\\\",\\n  \\\"wind_direction_10m\\\",\\n  \\\"wind_gusts_10m\\\",\\n];\\nconst HOURLY = [\\\"temperature_2m\\\", \\\"weather_code\\\", \\\"precipitation_probability\\\", \\\"is_day\\\"];\\nconst DAILY = [\\n  \\\"weather_code\\\",\\n  \\\"temperature_2m_max\\\",\\n  \\\"temperature_2m_min\\\",\\n  \\\"precipitation_sum\\\",\\n  \\\"precipitation_probability_max\\\",\\n  \\\"sunrise\\\",\\n  \\\"sunset\\\",\\n];\\n\\nexport class UpstreamError extends Error {}\\n\\nconst cache = new Map<string, { at: number; body: unknown }>();\\n\\nasync function getCached(url: string): Promise<unknown> {\\n  const hit = cache.get(url);\\n  if (hit && Date.now() - hit.at < TTL_MS) return hit.body;\\n  let response: Response;\\n  try {\\n    response = await fetch(url, { signal: AbortSignal.timeout(TIMEOUT_MS) });\\n  } catch {\\n    throw new UpstreamError(\\\"The weather service didn't answer in time.\\\");\\n  }\\n  if (!response.ok) throw new UpstreamError(`The weather service answered ${response.status}.`);\\n  const body: unknown = await response.json();\\n  if (cache.size >= MAX_ENTRIES) cache.delete(cache.keys().next().value!);\\n  cache.set(url, { at: Date.now(), body });\\n  return body;\\n}\\n\\n// Coordinates are rounded to about 1 km so nearby requests share one cached answer.\\nconst round = (n: number) => Math.round(n * 100) / 100;\\n\\nexport function forecast(lat: number, lon: number) {\\n  const params = new URLSearchParams({\\n    latitude: String(round(lat)),\\n    longitude: String(round(lon)),\\n    current: CURRENT.join(\\\",\\\"),\\n    hourly: HOURLY.join(\\\",\\\"),\\n    daily: DAILY.join(\\\",\\\"),\\n    timezone: \\\"auto\\\",\\n    timeformat: \\\"unixtime\\\",\\n    forecast_days: \\\"8\\\",\\n  });\\n  return getCached(`${FORECAST_URL}?${params}`);\\n}\\n\\nexport function searchPlaces(name: string, count = 10) {\\n  const params = new URLSearchParams({\\n    name,\\n    count: String(count),\\n    language: \\\"en\\\",\\n    format: \\\"json\\\",\\n  });\\n  return getCached(`${SEARCH_URL}?${params}`);\\n}\\n\\n/** Great-circle distance in km. */\\nexport function distanceKm(aLat: number, aLon: number, bLat: number, bLon: number) {\\n  const r = (d: number) => (d * Math.PI) / 180;\\n  const dLat = r(bLat - aLat);\\n  const dLon = r(bLon - aLon);\\n  const h = Math.sin(dLat / 2) ** 2 + Math.cos(r(aLat)) * Math.cos(r(bLat)) * Math.sin(dLon / 2) ** 2;\\n  return 2 * 6371 * Math.asin(Math.sqrt(h));\\n}\\n\"}"}}]},"finish_reason":null}]}

