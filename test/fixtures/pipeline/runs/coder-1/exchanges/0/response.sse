data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":34,"function":{"arguments":"{\"path\":\"client/src/pages/search.tsx\",\"content\":\"import { useEffect, useRef, useState } from \\\"react\\\";\\nimport { Link, useSearchParams } from \\\"react-router\\\";\\nimport { CircleAlert, Navigation, Plus, Search as SearchIcon } from \\\"lucide-react\\\";\\nimport type { Place as FoundPlace } from \\\"@app/shared\\\";\\nimport { Badge, Button, Card, Input, Skeleton } from \\\"@corbits/react-ui\\\";\\nimport { toast } from \\\"@corbits/react-ui/ui/toast\\\";\\nimport { useDebounced, useForecast, usePlaces } from \\\"../api.ts\\\";\\nimport { Notice, WxChip } from \\\"../components/weather-bits.tsx\\\";\\nimport { temp } from \\\"../lib/format.ts\\\";\\nimport { glance, placeHref, region, type Place } from \\\"../lib/places.ts\\\";\\nimport { useScene } from \\\"../lib/scene-state.ts\\\";\\nimport { cityId, readCached, store, useStore } from \\\"../lib/storage.ts\\\";\\nimport { useLocateAction } from \\\"../lib/use-locate.ts\\\";\\n\\nexport function Search() {\\n  useScene(\\\"keep\\\");\\n  const [params, setParams] = useSearchParams();\\n  // The box is local state (typing stays instant); the address follows it so Back keeps the search.\\n  const [text, setText] = useState(() => params.get(\\\"q\\\") ?? \\\"\\\");\\n  const q = useDebounced(text.trim());\\n  const results = usePlaces(q);\\n  const input = useRef<HTMLInputElement>(null);\\n  const { locate, locating } = useLocateAction();\\n\\n  useEffect(() => {\\n    input.current?.focus();\\n  }, []);\\n\\n  useEffect(() => {\\n    if ((params.get(\\\"q\\\") ?? \\\"\\\") !== q) setParams(q ? { q } : {}, { replace: true });\\n  }, [q, params, setParams]);\\n  const typing = text.trim() !== q;\\n  const ready = q.length >= 2;\\n  const list = results.data?.results ?? [];\\n\\n  return (\\n    <div className=\\\"stack narrow\\\">\\n      <div className=\\\"screen-header\\\">\\n        <div className=\\\"flex flex-col gap-1\\\">\\n        <h1 className=\\\"page-title\\\" data-testid=\\\"search-title\\\">\\n          Search\\n        </h1>\\n        <p className=\\\"muted\\\">Find any city, then open it or save it.</p>\\n      </div>\\n      </div>\\n      <Card className=\\\"gap-2\\\">\\n        <label htmlFor=\\\"search-input\\\" className=\\\"label\\\">\\n          City name\\n        </label>\\n        <div className=\\\"row\\\">\\n          <Input\\n            ref={input}\\n            id=\\\"search-input\\\"\\n            type=\\\"search\\\"\\n            className=\\\"h-11 grow text-base\\\"\\n            value={text}\\n            onChange={(e) => setText(e.target.value)}\\n            placeholder=\\\"Try “Lisbon”\\\"\\n            autoComplete=\\\"off\\\"\\n            aria-busy={(ready && (typing || results.isFetching)) || undefined}\\n            aria-describedby=\\\"search-hint\\\"\\n            data-testid=\\\"search-input\\\"\\n          />\\n          <Button\\n            variant=\\\"outline\\\"\\n            className=\\\"h-11\\\"\\n            onClick={() => void locate()}\\n            disabled={locating}\\n            aria-label=\\\"Use my location\\\"\\n            data-testid=\\\"search-locate-button\\\"\\n          >\\n            <Navigation />\\n            <span className=\\\"hide-sm\\\">My location</span>\\n          </Button>\\n        </div>\\n        <p id=\\\"search-hint\\\" className=\\\"small muted\\\">\\n          Results update as you type.\\n        </p>\\n      </Card>\\n\\n      {!ready ? null : typing || results.isPending ? (\\n        <Card className=\\\"results-card\\\" aria-label=\\\"Results\\\" role=\\\"region\\\">\\n          <p className=\\\"sr\\\" role=\\\"status\\\">\\n            Looking for places\\n          </p>\\n          {Array.from({ length: 4 }, (_, i) => (\\n            <Skeleton key={i} className=\\\"skeleton-row\\\" />\\n          ))}\\n        </Card>\\n      ) : results.isError ? (\\n        <Notice\\n          icon={<CircleAlert />}\\n          title=\\\"Search isn't working right now.\\\"\\n          tone=\\\"error\\\"\\n          testId=\\\"search-error-notice\\\"\\n          actions={\\n            <Button\\n              onClick={() => {\\n                toast(\\\"Trying again…\\\");\\n                void results.refetch();\\n              }}\\n              data-testid=\\\"search-retry-button\\\"\\n            >\\n              Try again\\n            </Button>\\n          }\\n        >\\n          We couldn't reach the city finder. Check your connection and try again.\\n        </Notice>\\n      ) : list.length === 0 ? (\\n        <Card className=\\\"empty-card\\\" role=\\\"status\\\" data-testid=\\\"search-no-results\\\">\\n          <SearchIcon aria-hidden=\\\"true\\\" />\\n          <h2 className=\\\"text-lg font-semibold\\\">No results for “{q}”</h2>\\n          <p>Check the spelling, or try a larger city nearby. Small villages often appear under their nearest town.</p>\\n          <Button variant=\\\"outline\\\" onClick={() => {\\n              setText(\\\"\\\");\\n              input.current?.focus();\\n            }}\\n            data-testid=\\\"search-clear-link\\\">\\n            Clear search\\n          </Button>\\n        </Card>\\n      ) : (\\n        <Card className=\\\"results-card\\\" aria-label=\\\"Results\\\" role=\\\"region\\\">\\n          <p className=\\\"small muted\\\" role=\\\"status\\\">\\n            {list.length === 1\\n              ? `1 place called “${q}”.`\\n              : `${list.length} places called “${q}”. Pick yours by region and country.`}\\n          </p>\\n          <ul className=\\\"city-list\\\" data-testid=\\\"search-results-list\\\">\\n            {list.map((p) => (\\n              <ResultRow key={p.id} found={p} />\\n            ))}\\n          </ul>\\n        </Card>\\n      )}\\n    </div>\\n  );\\n}\\n\\nfunction ResultRow({ found }: { found: FoundPlace }) {\\n  const link = useRef<HTMLAnchorElement>(null);\\n  const unit = useStore((s) => s.settings.unit);\\n  const id = cityId(found.latitude, found.longitude);\\n  const saved = useStore((s) => s.cities.some((c) => c.id === id));\\n  const place: Place = {\\n    id,\\n    name: found.name,\\n    admin1: found.admin1,\\n    country: found.country,\\n    lat: found.latitude,\\n    lon: found.longitude,\\n    isHere: false,\\n  };\\n  const f = useForecast(place);\\n  const data = f.data ?? readCached(id)?.data;\\n  const g = data ? glance(data) : null;\\n  const where = region(place) || \\\"Region not known\\\";\\n  const weather = g ? `${temp(g.tempC, unit)} · ${g.text}` : f.isError ? \\\"Weather unavailable\\\" : \\\"Loading weather…\\\";\\n  const save = () => {\\n    const added = store.save({ name: found.name, admin1: found.admin1, country: found.country, lat: found.latitude, lon: found.longitude });\\n    toast(added ? `${found.name} saved to your places.` : `${found.name} is already in your places.`);\\n    // The Save button turns into a \\\"Saved\\\" badge, so keep keyboard focus on the row.\\n    requestAnimationFrame(() => link.current?.focus());\\n  };\\n  return (\\n    <li className=\\\"city-row result-row\\\">\\n      {g ? <WxChip wx={g.wx} icon={g.icon} /> : <Skeleton className=\\\"size-9 rounded-full\\\" />}\\n      <Link ref={link} className=\\\"city-main\\\" to={placeHref(place, saved)} data-testid=\\\"search-result-link\\\">\\n        <b>{found.name}</b>\\n        <span className=\\\"small muted\\\">{where}</span>\\n        <span className=\\\"small show-sm\\\">{weather}</span>\\n      </Link>\\n      <span className=\\\"small muted hide-sm\\\">{weather}</span>\\n      {saved ? (\\n        <Badge tone=\\\"success\\\" className=\\\"badge-plain\\\" data-testid=\\\"search-saved-badge\\\">\\n          Saved\\n        </Badge>\\n      ) : (\\n        <Button variant=\\\"outline\\\" onClick={save} aria-label={`Save ${found.name}, ${where}`} data-testid=\\\"search-save-button\\\">\\n          <Plus />\\n          Save\\n        </Button>\\n      )}\\n    </li>\\n  );\\n}\\n\"}"}}]},"finish_reason":null}]}

