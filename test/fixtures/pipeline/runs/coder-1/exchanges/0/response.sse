data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":12,"function":{"arguments":"{\"path\":\"client/src/components/forecast.tsx\",\"content\":\"import type { Forecast } from \\\"@app/shared\\\";\\nimport { Skeleton } from \\\"@corbits/react-ui\\\";\\nimport { rain, temp, windFrom, windSpeed, cityClock, type Unit } from \\\"../lib/format.ts\\\";\\nimport { next24, next7, today } from \\\"../lib/view.ts\\\";\\nimport { WxIcon } from \\\"./weather-bits.tsx\\\";\\n\\n// The figures on Home: the stat tiles, the 24-hour strip and the 7-day list.\\n\\nfunction Stat({ label, value, sub, testId }: { label: string; value: string; sub: string; testId: string }) {\\n  return (\\n    <div className=\\\"stat\\\">\\n      <span>{label}</span>\\n      <span data-testid={testId}>{value}</span>\\n      <small>{sub}</small>\\n    </div>\\n  );\\n}\\n\\nexport function StatTiles({ f, unit }: { f: Forecast; unit: Unit }) {\\n  const c = f.current;\\n  const t = today(f);\\n  const diff = c.apparent_temperature - c.temperature_2m;\\n  const feelsSub =\\n    diff <= -2\\n      ? c.wind_speed_10m >= 10\\n        ? \\\"Wind makes it feel colder\\\"\\n        : \\\"Feels colder than it is\\\"\\n      : diff >= 2\\n        ? \\\"Humidity makes it feel warmer\\\"\\n        : \\\"Close to the real temperature\\\";\\n  const gust = unit === \\\"f\\\" ? Math.round(c.wind_gusts_10m * 0.621371) : Math.round(c.wind_gusts_10m);\\n  return (\\n    <div className=\\\"stats\\\">\\n      <Stat label=\\\"Feels like\\\" value={temp(c.apparent_temperature, unit)} sub={feelsSub} testId=\\\"home-feels-count\\\" />\\n      <Stat\\n        label=\\\"Wind\\\"\\n        value={windSpeed(c.wind_speed_10m, unit)}\\n        sub={c.wind_speed_10m < 2 ? `Calm, gusts ${gust}` : `From the ${windFrom(c.wind_direction_10m)}, gusts ${gust}`}\\n        testId=\\\"home-wind-count\\\"\\n      />\\n      <Stat\\n        label=\\\"Humidity\\\"\\n        value={`${Math.round(c.relative_humidity_2m)}%`}\\n        sub={`Dew point ${temp(c.dew_point_2m, unit)}`}\\n        testId=\\\"home-humidity-count\\\"\\n      />\\n      <Stat label=\\\"High / low\\\" value={`${temp(t.hiC, unit)} / ${temp(t.loC, unit)}`} sub=\\\"Today\\\" testId=\\\"home-high-low-count\\\" />\\n      <Stat\\n        label=\\\"Rain today\\\"\\n        value={rain(t.rainMm, unit)}\\n        sub={t.pop == null ? \\\"Chance not known\\\" : `${Math.round(t.pop)}% chance`}\\n        testId=\\\"home-rain-count\\\"\\n      />\\n      <Stat\\n        label=\\\"Sun\\\"\\n        value={\\n          t.sunrise && t.sunset && t.sunrise !== t.sunset\\n            ? `${cityClock(t.sunrise, f.utc_offset_seconds)} / ${cityClock(t.sunset, f.utc_offset_seconds)}`\\n            : \\\"–\\\"\\n        }\\n        sub=\\\"Sunrise / sunset\\\"\\n        testId=\\\"home-sun-count\\\"\\n      />\\n    </div>\\n  );\\n}\\n\\nexport function HourStrip({ f, unit }: { f: Forecast; unit: Unit }) {\\n  const hours = next24(f);\\n  return (\\n    <ol className=\\\"hours\\\" data-testid=\\\"home-hours-list\\\" tabIndex={0} aria-label=\\\"Hourly forecast, scroll for more\\\">\\n      {hours.map((h) => (\\n        <li key={h.time}>\\n          <span>{h.label}</span>\\n          <WxIcon name={h.icon} label={h.text} />\\n          <b>{temp(h.tempC, unit)}</b>\\n          <small className=\\\"pop\\\">\\n            {h.pop == null ? \\\"–\\\" : `${Math.round(h.pop)}%`}\\n            <span className=\\\"sr\\\"> chance of rain</span>\\n          </small>\\n        </li>\\n      ))}\\n    </ol>\\n  );\\n}\\n\\nexport function DayList({ f, unit }: { f: Forecast; unit: Unit }) {\\n  const days = next7(f);\\n  const lows = days.map((d) => d.loC).filter((n): n is number => n != null);\\n  const highs = days.map((d) => d.hiC).filter((n): n is number => n != null);\\n  const min = Math.min(...lows);\\n  const max = Math.max(...highs);\\n  const span = Math.max(1, max - min);\\n  return (\\n    <ol className=\\\"days\\\" data-testid=\\\"home-days-list\\\">\\n      {days.map((d) => (\\n        <li key={d.time}>\\n          <b>{d.label}</b>\\n          <span className=\\\"day-cond\\\">\\n            <WxIcon name={d.icon} />\\n            <span>{d.text}</span>\\n          </span>\\n          <span className=\\\"pop\\\">\\n            {d.pop == null ? \\\"–\\\" : `${Math.round(d.pop)}%`}\\n            <span className=\\\"sr\\\"> chance of rain</span>\\n          </span>\\n          <span className=\\\"range\\\">\\n            <span className=\\\"sr\\\">Low </span>\\n            <span className=\\\"lo\\\">{temp(d.loC, unit)}</span>\\n            <span className=\\\"range-bar\\\" aria-hidden=\\\"true\\\">\\n              <span\\n                style={{\\n                  left: `${(((d.loC ?? min) - min) / span) * 100}%`,\\n                  right: `${((max - (d.hiC ?? max)) / span) * 100}%`,\\n                }}\\n              />\\n            </span>\\n            <span className=\\\"sr\\\">, high </span>\\n            <b>{temp(d.hiC, unit)}</b>\\n          </span>\\n        </li>\\n      ))}\\n    </ol>\\n  );\\n}\\n\\n/** Placeholders in the same layout while the weather loads. */\\nexport function HeroSkeleton() {\\n  return (\\n    <>\\n      <div className=\\\"hero-top\\\">\\n        <Skeleton className=\\\"size-[72px]\\\" />\\n        <div className=\\\"flex flex-col gap-2\\\">\\n          <Skeleton className=\\\"h-[72px] w-[140px]\\\" />\\n          <Skeleton className=\\\"h-[22px] w-[160px]\\\" />\\n          <Skeleton className=\\\"h-4 w-[240px] max-w-full\\\" />\\n        </div>\\n      </div>\\n      <div className=\\\"stats\\\">\\n        {Array.from({ length: 6 }, (_, i) => (\\n          <div className=\\\"stat\\\" key={i}>\\n            <Skeleton className=\\\"h-3 w-3/5\\\" />\\n            <Skeleton className=\\\"h-6 w-4/5\\\" />\\n            <Skeleton className=\\\"h-3 w-4/5\\\" />\\n          </div>\\n        ))}\\n      </div>\\n    </>\\n  );\\n}\\n\\nexport function ListSkeleton({ rows, tall }: { rows: number; tall?: boolean }) {\\n  return (\\n    <div className={tall ? \\\"flex flex-col gap-2\\\" : \\\"flex gap-2 overflow-hidden\\\"}>\\n      {Array.from({ length: rows }, (_, i) => (\\n        <Skeleton key={i} className={tall ? \\\"h-10 w-full\\\" : \\\"h-[104px] w-16 shrink-0\\\"} />\\n      ))}\\n    </div>\\n  );\\n}\\n\"}"}}]},"finish_reason":null}]}

