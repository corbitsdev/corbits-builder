data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":44,"function":{"arguments":"{\"path\":\"client/src/scene/heat.ts\",\"content\":\"import { dotSprite, rand, share, type EffectOptions } from \\\"./common.ts\\\";\\nimport { Clear } from \\\"./clear.ts\\\";\\n\\n// Hot and clear: a huge, glaring sun, warm haze, and heat shimmer rising off the ground as wavy\\n// bands of light that ripple and climb. Under reduced motion the shimmer is drawn once, still.\\n\\ntype Wave = { y: number; amp: number; len: number; speed: number; phase: number; a: number };\\ntype Mote = { x: number; y: number; v: number; r: number; phase: number };\\n\\nexport class Heat extends Clear {\\n  private waves: Wave[] = [];\\n  private rising: Mote[] = [];\\n  private warm = dotSprite(\\\"255,205,140\\\", 32);\\n  constructor(opts: EffectOptions) {\\n    super(opts, opts.intensity === \\\"heavy\\\" ? 1.55 : 1.35);\\n  }\\n  override resize(w: number, h: number) {\\n    const first = this.waves.length === 0;\\n    super.resize(w, h);\\n    if (!first) return;\\n    const n = share(this.opts, 26);\\n    for (let i = 0; i < n; i++) {\\n      this.waves.push({\\n        y: h * rand(0.55, 1),\\n        amp: rand(2, 6),\\n        len: rand(60, 160),\\n        speed: rand(0.8, 2.2),\\n        phase: rand(0, Math.PI * 2),\\n        a: rand(0.05, 0.13),\\n      });\\n    }\\n    for (let i = 0; i < share(this.opts, 60); i++) this.rising.push(this.newRising(true));\\n  }\\n  private newRising(anywhere: boolean): Mote {\\n    return {\\n      x: rand(0, this.w),\\n      y: anywhere ? rand(this.h * 0.5, this.h) : this.h + 10,\\n      v: rand(12, 34),\\n      r: rand(3, 9),\\n      phase: rand(0, Math.PI * 2),\\n    };\\n  }\\n  override update(dt: number) {\\n    super.update(dt);\\n    for (const wv of this.waves) {\\n      wv.y -= 9 * dt;\\n      if (wv.y < this.h * 0.5) wv.y = this.h + 5;\\n    }\\n    for (let i = 0; i < this.rising.length; i++) {\\n      const m = this.rising[i]!;\\n      m.y -= m.v * dt;\\n      m.x += Math.sin(this.time * 2 + m.phase) * 10 * dt;\\n      if (m.y < this.h * 0.45) this.rising[i] = this.newRising(false);\\n    }\\n  }\\n  override draw(ctx: CanvasRenderingContext2D, alpha: number) {\\n    const day = this.opts.isDay;\\n    // Warm haze from the ground up.\\n    const haze = ctx.createLinearGradient(0, this.h * 0.45, 0, this.h);\\n    haze.addColorStop(0, \\\"rgba(255,190,120,0)\\\");\\n    haze.addColorStop(1, `rgba(255,190,120,${(day ? 0.3 : 0.18) * alpha})`);\\n    ctx.fillStyle = haze;\\n    ctx.fillRect(0, this.h * 0.45, this.w, this.h * 0.55);\\n    if (day) this.drawSun(ctx, alpha);\\n    else this.drawNight(ctx, alpha, 0.5);\\n    if (this.opts.still) return;\\n    // Shimmer: rippling bands of light, the classic mirage over hot ground.\\n    ctx.lineWidth = 3;\\n    for (const wv of this.waves) {\\n      const k = (wv.y - this.h * 0.5) / (this.h * 0.5); // fades out as it rises\\n      ctx.strokeStyle = `rgba(255,${day ? 240 : 200},${day ? 215 : 170},${wv.a * k * alpha})`;\\n      ctx.beginPath();\\n      for (let x = 0; x <= this.w; x += 12) {\\n        const y = wv.y + Math.sin(x / wv.len + this.time * wv.speed * 3 + wv.phase) * wv.amp;\\n        if (x === 0) ctx.moveTo(x, y);\\n        else ctx.lineTo(x, y);\\n      }\\n      ctx.stroke();\\n    }\\n    for (const m of this.rising) {\\n      const k = (m.y - this.h * 0.45) / (this.h * 0.55);\\n      ctx.globalAlpha = 0.22 * k * alpha;\\n      ctx.drawImage(this.warm, m.x - m.r, m.y - m.r * 1.6, m.r * 2, m.r * 3.2);\\n    }\\n    ctx.globalAlpha = 1;\\n  }\\n  override count() {\\n    return super.count() + this.waves.length + this.rising.length;\\n  }\\n}\\n\"}"}}]},"finish_reason":null}]}

