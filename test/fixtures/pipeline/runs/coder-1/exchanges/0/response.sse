data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":20,"function":{"arguments":"{\"path\":\"client/src/lib/install.ts\",\"content\":\"import { useSyncExternalStore } from \\\"react\\\";\\n\\n// The browser's own install offer. Chrome and Edge fire `beforeinstallprompt`; we keep it so the\\n// Install button can open the real prompt. Safari has no prompt; the dialog explains its steps.\\n\\ntype InstallEvent = Event & { prompt: () => Promise<void>; userChoice: Promise<{ outcome: \\\"accepted\\\" | \\\"dismissed\\\" }> };\\n\\nlet deferred: InstallEvent | null = null;\\nlet installed =\\n  typeof matchMedia === \\\"function\\\" &&\\n  (matchMedia(\\\"(display-mode: standalone)\\\").matches || (navigator as { standalone?: boolean }).standalone === true);\\nconst listeners = new Set<() => void>();\\nconst emit = () => listeners.forEach((l) => l());\\n\\naddEventListener(\\\"beforeinstallprompt\\\", (e) => {\\n  e.preventDefault();\\n  deferred = e as InstallEvent;\\n  emit();\\n});\\naddEventListener(\\\"appinstalled\\\", () => {\\n  installed = true;\\n  deferred = null;\\n  emit();\\n});\\n\\nlet snapshot = { canPrompt: false, installed };\\nexport const useInstall = () =>\\n  useSyncExternalStore(\\n    (l) => {\\n      listeners.add(l);\\n      return () => listeners.delete(l);\\n    },\\n    () => {\\n      const next = { canPrompt: deferred !== null, installed };\\n      if (next.canPrompt !== snapshot.canPrompt || next.installed !== snapshot.installed) snapshot = next;\\n      return snapshot;\\n    },\\n  );\\n\\n/** Opens the browser's install prompt. Resolves to whether the person accepted. */\\nexport async function promptInstall(): Promise<boolean> {\\n  if (!deferred) return false;\\n  const e = deferred;\\n  deferred = null;\\n  emit();\\n  await e.prompt();\\n  const choice = await e.userChoice;\\n  return choice.outcome === \\\"accepted\\\";\\n}\\n\"}"}}]},"finish_reason":null}]}

