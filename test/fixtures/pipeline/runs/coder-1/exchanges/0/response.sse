data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":42,"function":{"arguments":"{\"path\":\"client/src/scene/engine.ts\",\"content\":\"import type { Condition, Intensity } from \\\"../lib/weather.ts\\\";\\nimport type { Effect, EffectOptions } from \\\"./common.ts\\\";\\nimport { Clear } from \\\"./clear.ts\\\";\\nimport { Cloudy } from \\\"./cloud.ts\\\";\\nimport { Fog } from \\\"./fog.ts\\\";\\nimport { Heat } from \\\"./heat.ts\\\";\\nimport { QualityMonitor } from \\\"./quality.ts\\\";\\nimport { Rain } from \\\"./rain.ts\\\";\\nimport { Snow } from \\\"./snow.ts\\\";\\nimport { Storm } from \\\"./storm.ts\\\";\\nimport { Wind } from \\\"./wind.ts\\\";\\n\\n// The scene's drawing loop: one canvas, one effect per weather, a 1.2 second cross-fade between\\n// scenes, automatic quality steps, a full stop while the tab is hidden, and a still frame under\\n// reduced motion.\\n\\nexport type SceneSpec = { condition: Condition; intensity: Intensity; isDay: boolean } | null;\\n\\nconst FADE_S = 1.2;\\nconst MAX_QUALITY = 3;\\nconst SIMPLER_QUALITY = 1;\\n\\nfunction makeEffect(spec: NonNullable<SceneSpec>, opts: EffectOptions): Effect {\\n  switch (spec.condition) {\\n    case \\\"rain\\\":\\n      return new Rain(opts);\\n    case \\\"storm\\\":\\n      return new Storm(opts);\\n    case \\\"snow\\\":\\n      return new Snow(opts);\\n    case \\\"wind\\\":\\n      return new Wind(opts);\\n    case \\\"cloudy\\\":\\n      return new Cloudy(opts);\\n    case \\\"fog\\\":\\n      return new Fog(opts);\\n    case \\\"hot\\\":\\n      return new Heat(opts);\\n    default:\\n      return new Clear(opts);\\n  }\\n}\\n\\nconst keyOf = (s: SceneSpec) => (s ? `${s.condition}-${s.intensity}-${s.isDay ? \\\"day\\\" : \\\"night\\\"}` : \\\"calm\\\");\\n\\ntype Layer = { spec: SceneSpec; effect: Effect | null; alpha: number; target: number };\\n\\nexport class Engine {\\n  private ctx: CanvasRenderingContext2D;\\n  private layers: Layer[] = [];\\n  private w = 0;\\n  private h = 0;\\n  private dpr = 1;\\n  private raf = 0;\\n  private last = 0;\\n  private running = false;\\n  private monitor = new QualityMonitor();\\n  private quality: number;\\n  private maxQuality = MAX_QUALITY;\\n  private reduced = false;\\n  private upTimer = 0;\\n  private maxFlashes = 0;\\n\\n  constructor(private canvas: HTMLCanvasElement) {\\n    this.ctx = canvas.getContext(\\\"2d\\\", { alpha: true })!;\\n    // Phones with few cores start one step lower; the monitor raises it if they cope.\\n    this.quality = (navigator.hardwareConcurrency ?? 8) <= 4 ? 2 : MAX_QUALITY;\\n    addEventListener(\\\"resize\\\", this.onResize);\\n    document.addEventListener(\\\"visibilitychange\\\", this.onVisibility);\\n    this.onResize();\\n  }\\n\\n  destroy() {\\n    this.stop();\\n    clearTimeout(this.upTimer);\\n    removeEventListener(\\\"resize\\\", this.onResize);\\n    document.removeEventListener(\\\"visibilitychange\\\", this.onVisibility);\\n  }\\n\\n  private options(spec: NonNullable<SceneSpec>): EffectOptions {\\n    return { intensity: spec.intensity, isDay: spec.isDay, quality: this.quality, still: this.reduced };\\n  }\\n\\n  private build(spec: SceneSpec): Effect | null {\\n    if (!spec) return null;\\n    const effect = makeEffect(spec, this.options(spec));\\n    effect.resize(this.w, this.h);\\n    return effect;\\n  }\\n\\n  setScene(spec: SceneSpec) {\\n    const top = this.layers[this.layers.length - 1];\\n    if (top && keyOf(top.spec) === keyOf(spec)) return;\\n    for (const l of this.layers) l.target = 0;\\n    const instant = this.reduced || this.layers.length === 0;\\n    this.layers.push({ spec, effect: this.build(spec), alpha: instant ? 1 : 0, target: 1 });\\n    if (instant) this.layers = this.layers.slice(-1);\\n    this.monitor.reset(performance.now());\\n    this.refresh();\\n  }\\n\\n  setSimpler(simpler: boolean) {\\n    const max = simpler ? SIMPLER_QUALITY : MAX_QUALITY;\\n    if (max === this.maxQuality) return;\\n    this.maxQuality = max;\\n    this.setQuality(simpler ? Math.min(this.quality, max) : max);\\n  }\\n\\n  setReduced(reduced: boolean) {\\n    if (reduced === this.reduced) return;\\n    this.reduced = reduced;\\n    this.rebuild();\\n    this.refresh();\\n  }\\n\\n  private setQuality(q: number) {\\n    this.quality = Math.max(0, Math.min(this.maxQuality, q));\\n    this.rebuild();\\n    this.onResize();\\n    this.monitor.reset(performance.now());\\n    this.refresh();\\n  }\\n\\n  /** Rebuild the visible effects at the current quality, keeping the fade where it was. */\\n  private rebuild() {\\n    for (const l of this.layers) l.effect = this.build(l.spec);\\n  }\\n\\n  /** Start or stop the loop to match the current settings, and draw at least once. */\\n  private refresh() {\\n    this.setDataset();\\n    const animate = !this.reduced && this.quality > 0 && !document.hidden && this.layers.some((l) => l.spec);\\n    if (animate) this.start();\\n    else {\\n      this.stop();\\n      this.render(0);\\n      // At the still level, try moving again after a while in case the device has recovered.\\n      clearTimeout(this.upTimer);\\n      if (!this.reduced && this.quality === 0 && this.maxQuality > 0)\\n        this.upTimer = window.setTimeout(() => this.setQuality(1), 10_000);\\n    }\\n  }\\n\\n  private start() {\\n    if (this.running) return;\\n    this.running = true;\\n    this.last = performance.now();\\n    this.monitor.reset(this.last);\\n    this.raf = requestAnimationFrame(this.tick);\\n    this.setDataset();\\n  }\\n\\n  private stop() {\\n    this.running = false;\\n    cancelAnimationFrame(this.raf);\\n    this.setDataset();\\n  }\\n\\n  private tick = (now: number) => {\\n    if (!this.running) return;\\n    const dt = Math.min(0.05, Math.max(0, (now - this.last) / 1000));\\n    this.last = now;\\n    this.render(dt);\\n    const step = this.monitor.frame(now);\\n    if (step !== 0) this.setQuality(this.quality + step);\\n    if (this.running) this.raf = requestAnimationFrame(this.tick);\\n  };\\n\\n  private render(dt: number) {\\n    const ctx = this.ctx;\\n    for (const l of this.layers) {\\n      l.alpha = l.target > l.alpha ? Math.min(1, l.alpha + dt / FADE_S) : Math.max(0, l.alpha - dt / FADE_S);\\n      if (dt > 0) l.effect?.update(dt, this.last / 1000);\\n    }\\n    // Faded-out scenes are dropped once the new one is fully in.\\n    this.layers = this.layers.filter((l) => l.target === 1 || l.alpha > 0);\\n    ctx.setTransform(this.dpr, 0, 0, this.dpr, 0, 0);\\n    ctx.clearRect(0, 0, this.w, this.h);\\n    for (const l of this.layers) if (l.effect && l.alpha > 0) l.effect.draw(ctx, l.alpha);\\n    for (const l of this.layers) {\\n      if (l.effect instanceof Storm) this.maxFlashes = Math.max(this.maxFlashes, l.effect.flashesLastSecond());\\n    }\\n    if (dt > 0 && Math.random() < 0.05) this.setDataset();\\n  }\\n\\n  private onResize = () => {\\n    this.w = window.innerWidth;\\n    this.h = window.innerHeight;\\n    this.dpr = Math.min(window.devicePixelRatio || 1, this.quality >= 3 ? 1.5 : 1);\\n    this.canvas.width = Math.round(this.w * this.dpr);\\n    this.canvas.height = Math.round(this.h * this.dpr);\\n    for (const l of this.layers) l.effect?.resize(this.w, this.h);\\n    if (!this.running) this.render(0);\\n  };\\n\\n  private onVisibility = () => {\\n    if (document.hidden) this.stop();\\n    else this.refresh();\\n  };\\n\\n  private setDataset() {\\n    const d = this.canvas.dataset;\\n    d.quality = String(this.quality);\\n    d.running = String(this.running);\\n    d.particles = String(this.layers.filter((l) => l.target === 1).reduce((n, l) => n + (l.effect?.count() ?? 0), 0));\\n    d.fps = String(Math.round(this.monitor.fps));\\n    d.maxFlashesPerSecond = String(this.maxFlashes);\\n    // At the lowest level, frosted blur is switched off too (it is costly on weak devices).\\n    document.documentElement.dataset.lite = String(this.quality === 0);\\n  }\\n}\\n\"}"}}]},"finish_reason":null}]}

