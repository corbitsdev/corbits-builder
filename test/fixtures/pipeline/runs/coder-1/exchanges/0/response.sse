data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":33,"function":{"arguments":"{\"path\":\"client/src/pages/not-found.tsx\",\"content\":\"import { Link } from \\\"react-router\\\";\\nimport { Button, EmptyState } from \\\"@corbits/react-ui\\\";\\n\\nexport function NotFound() {\\n  return (\\n    <EmptyState\\n      className=\\\"py-16\\\"\\n      title=\\\"Page not found\\\"\\n      description=\\\"The address may be mistyped or the page may have moved.\\\"\\n      action={\\n        <Button asChild>\\n          <Link to=\\\"/\\\">Go home</Link>\\n        </Button>\\n      }\\n    />\\n  );\\n}\\n\"}"}}]},"finish_reason":null}]}

