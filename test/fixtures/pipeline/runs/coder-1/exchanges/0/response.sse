data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":35,"function":{"arguments":"{\"path\":\"client/src/pages/settings.tsx\",\"content\":\"import { useState } from \\\"react\\\";\\nimport { Download, Navigation } from \\\"lucide-react\\\";\\nimport { Badge, Button, Card, Switch } from \\\"@corbits/react-ui\\\";\\nimport { toast } from \\\"@corbits/react-ui/ui/toast\\\";\\nimport { UnitToggle, WxIcon } from \\\"../components/weather-bits.tsx\\\";\\nimport { promptInstall, useInstall } from \\\"../lib/install.ts\\\";\\nimport { useScene } from \\\"../lib/scene-state.ts\\\";\\nimport { store, useStore } from \\\"../lib/storage.ts\\\";\\nimport { useLocateAction } from \\\"../lib/use-locate.ts\\\";\\nimport { ALL_CONDITIONS, CONDITION_ICON, CONDITION_NAMES } from \\\"../lib/weather.ts\\\";\\nimport { useReducedMotion } from \\\"../scene/SceneLayer.tsx\\\";\\n\\nexport function Settings() {\\n  useScene(\\\"keep\\\");\\n  const simpler = useStore((s) => s.settings.simpler);\\n  const reduced = useReducedMotion();\\n  const { locate, locating } = useLocateAction();\\n  const install = useInstall();\\n  const [open, setOpen] = useState(false);\\n\\n  const confirmInstall = async () => {\\n    setOpen(false);\\n    const accepted = await promptInstall();\\n    if (accepted) toast(\\\"Installing. The app will open from your home screen.\\\");\\n  };\\n\\n  return (\\n    <div className=\\\"stack narrow\\\">\\n      <div className=\\\"screen-header\\\">\\n        <div className=\\\"flex flex-col gap-1\\\">\\n          <h1 className=\\\"page-title\\\" data-testid=\\\"settings-title\\\">\\n            Settings\\n          </h1>\\n          <p className=\\\"muted\\\">Changes save straight away, in this browser.</p>\\n        </div>\\n        <Button onClick={() => setOpen(true)} disabled={install.installed} data-testid=\\\"settings-install-button\\\">\\n          <Download />\\n          {install.installed ? \\\"Installed\\\" : \\\"Install app\\\"}\\n        </Button>\\n      </div>\\n\\n      <Card aria-label=\\\"Units\\\" role=\\\"region\\\">\\n        <div className=\\\"setting-row\\\">\\n          <div>\\n            <h2 className=\\\"text-lg font-semibold\\\">Units</h2>\\n            <p className=\\\"muted\\\">\\n              Changes every temperature in the app. °C shows wind in km/h and rain in mm; °F shows mph and inches.\\n            </p>\\n          </div>\\n          <UnitToggle prefix=\\\"settings\\\" />\\n        </div>\\n      </Card>\\n\\n      <Card aria-label=\\\"Effects and motion\\\" role=\\\"region\\\">\\n        <h2 className=\\\"text-lg font-semibold\\\">Effects and motion</h2>\\n        <div className=\\\"setting-row\\\">\\n          <div>\\n            <b id=\\\"simpler-label\\\">Simpler effects</b>\\n            <p className=\\\"muted\\\" id=\\\"simpler-help\\\">\\n              Fewer raindrops, flakes and clouds. Kinder to older phones and battery. Each kind of weather still looks\\n              different.\\n            </p>\\n          </div>\\n          <span className=\\\"inline-flex\\\" data-testid=\\\"settings-effects-checkbox\\\">\\n            <Switch checked={simpler} onCheckedChange={store.setSimpler} label=\\\"Simpler effects\\\" describedBy=\\\"simpler-help\\\" />\\n          </span>\\n        </div>\\n        <div className=\\\"setting-row\\\">\\n          <div>\\n            <b>Reduced motion</b>\\n            <p className=\\\"muted\\\">\\n              Set by your device. When it asks for less motion, scenes hold still: the weather shows through colour and\\n              soft shapes, with no falling, flashing or shimmering.\\n            </p>\\n          </div>\\n          <Badge className=\\\"badge-plain\\\" data-testid=\\\"settings-motion-status\\\">\\n            {reduced ? \\\"Your device: less motion\\\" : \\\"Your device: full motion\\\"}\\n          </Badge>\\n        </div>\\n        <div className=\\\"setting-row\\\">\\n          <div>\\n            <b>Automatic smoothness</b>\\n            <p className=\\\"muted\\\">\\n              If your device struggles, the app quietly lightens the scene, and brings detail back when it can.\\n            </p>\\n          </div>\\n          <Badge tone=\\\"success\\\" className=\\\"badge-plain\\\">\\n            Always on\\n          </Badge>\\n        </div>\\n      </Card>\\n\\n      <Card aria-label=\\\"Location\\\" role=\\\"region\\\">\\n        <div className=\\\"setting-row\\\">\\n          <div>\\n            <h2 className=\\\"text-lg font-semibold\\\">Location</h2>\\n            <p className=\\\"muted\\\">Used only to fetch your local weather. Tap to check where you are again.</p>\\n          </div>\\n          <Button variant=\\\"outline\\\" onClick={() => void locate()} disabled={locating} data-testid=\\\"settings-locate-button\\\">\\n            <Navigation />\\n            {locating ? \\\"Checking…\\\" : \\\"Use my location\\\"}\\n          </Button>\\n        </div>\\n      </Card>\\n\\n      <Card aria-label=\\\"Saved in this browser\\\" role=\\\"region\\\" className=\\\"gap-2\\\">\\n        <h2 className=\\\"text-lg font-semibold\\\">Saved in this browser</h2>\\n        <p className=\\\"muted\\\" data-testid=\\\"settings-browser-note\\\">\\n          Your saved cities, units and effects choice live only in this browser on this device. There's no account and\\n          nothing is kept about you. If you clear your browser's data, they'll be gone and you'll need to add your cities\\n          again.\\n        </p>\\n      </Card>\\n\\n      <Card aria-label=\\\"The scenes\\\" role=\\\"region\\\" className=\\\"gap-3\\\">\\n        <h2 className=\\\"text-lg font-semibold\\\">The scenes</h2>\\n        <p className=\\\"muted\\\">\\n          Each kind of weather has a day and a night look, timed by sunrise and sunset in the city you're viewing.\\n        </p>\\n        <ul className=\\\"swatches\\\" data-testid=\\\"settings-scene-list\\\">\\n          {ALL_CONDITIONS.flatMap((c) =>\\n            ([\\\"day\\\", \\\"night\\\"] as const).map((time, i) => (\\n              <li className=\\\"swatch\\\" data-wx={`${c}-${time}`} key={`${c}-${time}`}>\\n                <span>\\n                  <WxIcon name={CONDITION_ICON[c][i]!} />\\n                </span>\\n                <span>\\n                  {CONDITION_NAMES[c]}, {time}\\n                </span>\\n              </li>\\n            )),\\n          )}\\n        </ul>\\n      </Card>\\n      <p className=\\\"small muted frost-strip\\\">\\n        Weather and city search by{\\\" \\\"}\\n        <a className=\\\"underline\\\" href=\\\"https://open-meteo.com/\\\" target=\\\"_blank\\\" rel=\\\"noreferrer\\\">\\n          Open-Meteo\\n        </a>\\n        , free for personal use.\\n      </p>\\n\\n      {open ? (\\n        <div className=\\\"scrim\\\" data-open=\\\"true\\\" onClick={() => setOpen(false)}>\\n          <Card\\n            role=\\\"dialog\\\"\\n            aria-modal=\\\"true\\\"\\n            aria-labelledby=\\\"install-dialog-title\\\"\\n            data-testid=\\\"install-dialog\\\"\\n            className=\\\"welcome\\\"\\n            onClick={(e) => e.stopPropagation()}\\n          >\\n            <h2 id=\\\"install-dialog-title\\\" className=\\\"text-lg font-semibold\\\">\\n              Put the weather on your home screen\\n            </h2>\\n            <p className=\\\"muted\\\">\\n              Installed, it opens full screen like any other app. No app store, no sign-in, and your cities stay in this\\n              browser.\\n            </p>\\n            {install.canPrompt ? null : (\\n              <div className=\\\"text-sm\\\">\\n                <p className=\\\"font-semibold\\\">How to add it</p>\\n                <ul className=\\\"mt-2 list-disc space-y-1 pl-5 text-muted-foreground\\\">\\n                  <li>iPhone or iPad (Safari): tap Share, then “Add to Home Screen”.</li>\\n                  <li>Android (Chrome): open the ⋮ menu, then “Install app” or “Add to Home screen”.</li>\\n                  <li>Computer (Chrome or Edge): click the install icon at the right of the address bar.</li>\\n                </ul>\\n              </div>\\n            )}\\n            <div className=\\\"row justify-end gap-2\\\">\\n              <Button variant=\\\"outline\\\" onClick={() => setOpen(false)} data-testid=\\\"install-cancel-button\\\">\\n                {install.canPrompt ? \\\"Not now\\\" : \\\"Close\\\"}\\n              </Button>\\n              {install.canPrompt ? (\\n                <Button onClick={() => void confirmInstall()} data-testid=\\\"install-confirm-button\\\">\\n                  <Download />\\n                  Install\\n                </Button>\\n              ) : null}\\n            </div>\\n          </Card>\\n        </div>\\n      ) : null}\\n    </div>\\n  );\\n}\\n\"}"}}]},"finish_reason":null}]}

