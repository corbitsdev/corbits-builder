data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":0,"function":{"arguments":"{\"path\":\".builder/designs/styles.css\",\"content\":\"/* Tokens: names match @corbits/react-ui. Adaptive weather-driven concept: crisp neutrals, frosted panels; the shown scene re-sets the palette (see Palettes). */\\n:root {\\n  --background: #eef2f6;\\n  --foreground: #121820;\\n  --card: rgb(255 255 255 / 0.82);\\n  --card-foreground: #121820;\\n  --popover: #ffffff;\\n  --popover-foreground: #121820;\\n  --primary: #2f5b8a;\\n  --primary-foreground: #ffffff;\\n  --primary-active: #264b72;\\n  --secondary: rgb(18 24 32 / 0.06);\\n  --secondary-foreground: #121820;\\n  --muted: rgb(18 24 32 / 0.06);\\n  --muted-foreground: #46505e;\\n  --accent: rgb(18 24 32 / 0.08);\\n  --accent-foreground: #121820;\\n  --destructive: #a8322a;\\n  --destructive-foreground: #ffffff;\\n  --success: #cfe3d3;\\n  --success-foreground: #121820;\\n  --border: rgb(18 24 32 / 0.12);\\n  --input: #7b8594;\\n  --ring: #2f5b8a;\\n  --radius: 0.875rem;\\n  --radius-sm: calc(var(--radius) - 4px);\\n  --radius-lg: calc(var(--radius) + 4px);\\n  --shadow-popover: 0 12px 32px rgb(10 20 40 / 0.16), 0 1px 3px rgb(10 20 40 / 0.08);\\n  --font-sans: system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial, sans-serif;\\n  --font-mono: \\\"Space Mono\\\", \\\"Fira Code\\\", Monaco, Consolas, monospace;\\n  --ease-out: cubic-bezier(0.23, 1, 0.32, 1);\\n  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);\\n  --duration-micro: 150ms;\\n  --duration-standard: 200ms;\\n  --duration-large: 300ms;\\n  color-scheme: light;\\n}\\n.dark {\\n  --background: #0b0f24;\\n  --foreground: #eef1fa;\\n  --card: rgb(18 23 52 / 0.74);\\n  --card-foreground: #eef1fa;\\n  --popover: #171c3d;\\n  --popover-foreground: #eef1fa;\\n  --primary: #a5b4fc;\\n  --primary-foreground: #0b1030;\\n  --primary-active: #c3cdfd;\\n  --secondary: rgb(255 255 255 / 0.1);\\n  --secondary-foreground: #eef1fa;\\n  --muted: rgb(255 255 255 / 0.08);\\n  --muted-foreground: #b6bdd6;\\n  --accent: rgb(255 255 255 / 0.12);\\n  --accent-foreground: #eef1fa;\\n  --destructive: #f08a80;\\n  --destructive-foreground: #0b0f24;\\n  --success: #2f5a45;\\n  --success-foreground: #eef1fa;\\n  --border: rgb(255 255 255 / 0.14);\\n  --input: #8b93b3;\\n  --ring: #a5b4fc;\\n  --shadow-popover: 0 12px 32px rgb(0 0 0 / 0.5);\\n  color-scheme: dark;\\n}\\n@media (prefers-color-scheme: dark) {\\n  :root:not(.dark):not(.light) {\\n    --background: #0b0f24;\\n    --foreground: #eef1fa;\\n    --card: rgb(18 23 52 / 0.74);\\n    --card-foreground: #eef1fa;\\n    --popover: #171c3d;\\n    --popover-foreground: #eef1fa;\\n    --primary: #a5b4fc;\\n    --primary-foreground: #0b1030;\\n    --primary-active: #c3cdfd;\\n    --secondary: rgb(255 255 255 / 0.1);\\n    --secondary-foreground: #eef1fa;\\n    --muted: rgb(255 255 255 / 0.08);\\n    --muted-foreground: #b6bdd6;\\n    --accent: rgb(255 255 255 / 0.12);\\n    --accent-foreground: #eef1fa;\\n    --destructive: #f08a80;\\n    --destructive-foreground: #0b0f24;\\n    --success: #2f5a45;\\n    --success-foreground: #eef1fa;\\n    --border: rgb(255 255 255 / 0.14);\\n    --input: #8b93b3;\\n    --ring: #a5b4fc;\\n    --shadow-popover: 0 12px 32px rgb(0 0 0 / 0.5);\\n    color-scheme: dark;\\n  }\\n}\\n\\n/* Base */\\n*,\\n*::before,\\n*::after {\\n  box-sizing: border-box;\\n}\\n[hidden] {\\n  display: none !important;\\n}\\nhtml {\\n  scrollbar-gutter: stable;\\n}\\nbody {\\n  margin: 0;\\n  background: var(--background);\\n  color: var(--foreground);\\n  font: 400 14px/20px var(--font-sans);\\n}\\nh1 {\\n  font-size: 24px;\\n  line-height: 32px;\\n  font-weight: 600;\\n  margin: 0;\\n  text-wrap: balance;\\n}\\nh2 {\\n  font-size: 18px;\\n  line-height: 28px;\\n  font-weight: 600;\\n  margin: 0;\\n}\\na {\\n  color: inherit;\\n}\\n:focus-visible {\\n  outline: 2px solid var(--ring);\\n  outline-offset: 2px;\\n}\\n\\n/* Layout */\\n.app-bar {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  gap: 16px;\\n  min-height: 56px;\\n  padding: 0 16px;\\n  border-bottom: 1px solid var(--border);\\n}\\n.app-main {\\n  max-width: 1200px;\\n  margin: 0 auto;\\n  padding: 24px 16px 48px;\\n}\\n.screen-header {\\n  display: flex;\\n  flex-wrap: wrap;\\n  align-items: center;\\n  justify-content: space-between;\\n  gap: 16px;\\n  margin-bottom: 24px;\\n}\\n@media (min-width: 640px) {\\n  .app-bar {\\n    padding: 0 24px;\\n  }\\n  .app-main {\\n    padding: 32px 24px 64px;\\n  }\\n}\\n@media (min-width: 1024px) {\\n  .app-main {\\n    padding-inline: 32px;\\n  }\\n}\\n.stack {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 16px;\\n}\\n.row {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n}\\n.wrap {\\n  flex-wrap: wrap;\\n}\\n.center {\\n  align-items: center;\\n  justify-content: center;\\n}\\n.between {\\n  justify-content: space-between;\\n}\\n.grow {\\n  flex: 1;\\n  min-width: 0;\\n}\\n.grid-2,\\n.grid-3,\\n.grid-4 {\\n  display: grid;\\n  gap: 16px;\\n}\\n@media (min-width: 768px) {\\n  .grid-2 {\\n    grid-template-columns: repeat(2, minmax(0, 1fr));\\n  }\\n  .grid-3 {\\n    grid-template-columns: repeat(3, minmax(0, 1fr));\\n  }\\n  .grid-4 {\\n    grid-template-columns: repeat(4, minmax(0, 1fr));\\n  }\\n}\\n.gap-1 {\\n  gap: 4px;\\n}\\n.gap-2 {\\n  gap: 8px;\\n}\\n.gap-3 {\\n  gap: 12px;\\n}\\n.gap-4 {\\n  gap: 16px;\\n}\\n.gap-5 {\\n  gap: 24px;\\n}\\n.gap-6 {\\n  gap: 32px;\\n}\\n.pad-1 {\\n  padding: 4px;\\n}\\n.pad-2 {\\n  padding: 8px;\\n}\\n.pad-3 {\\n  padding: 12px;\\n}\\n.pad-4 {\\n  padding: 16px;\\n}\\n.pad-5 {\\n  padding: 24px;\\n}\\n.pad-6 {\\n  padding: 32px;\\n}\\n.muted {\\n  color: var(--muted-foreground);\\n}\\n\\n/* Shell: at four or more screens the nav is a sidebar, a drawer from .menu-button under 768px */\\n.app-name {\\n  font-weight: 600;\\n  text-decoration: none;\\n}\\n.app-nav {\\n  display: flex;\\n  gap: 4px;\\n}\\n.app-nav a,\\n.sidebar-item {\\n  display: flex;\\n  align-items: center;\\n  gap: 10px;\\n  padding: 8px;\\n  border-radius: var(--radius-sm);\\n  color: var(--muted-foreground);\\n  text-decoration: none;\\n  transition: background-color var(--duration-micro) var(--ease-out);\\n}\\n.app-nav a[aria-current=\\\"page\\\"],\\n.sidebar-item[aria-current=\\\"page\\\"] {\\n  background: var(--muted);\\n  color: var(--foreground);\\n}\\n@media (hover: hover) and (pointer: fine) {\\n  .app-nav a:hover,\\n  .sidebar-item:hover {\\n    color: var(--foreground);\\n  }\\n}\\n.sidebar,\\n.app:has(.app-nav > :nth-child(4)) .app-nav {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 2px;\\n  width: 240px;\\n  padding: 8px;\\n  overflow-y: auto;\\n  border-right: 1px solid var(--border);\\n  background: var(--card);\\n  color: var(--card-foreground);\\n}\\n.sidebar-section {\\n  display: grid;\\n  gap: 2px;\\n  padding-block: 8px;\\n}\\n.sidebar-section > :first-child:not(a) {\\n  padding: 4px 8px;\\n  color: var(--muted-foreground);\\n  font-size: 11px;\\n  font-weight: 600;\\n  letter-spacing: 0.12em;\\n  text-transform: uppercase;\\n}\\n.app-bar .menu-button {\\n  display: none;\\n}\\n@media (min-width: 768px) {\\n  .app:has(.app-nav > :nth-child(4)) .app-nav {\\n    position: fixed;\\n    top: 56px;\\n    bottom: 0;\\n    left: 0;\\n  }\\n  .app:has(.app-nav > :nth-child(4)) .app-main {\\n    margin-left: 240px;\\n  }\\n}\\n@media (max-width: 767px) {\\n  .app:has(.app-nav > :nth-child(4)) .menu-button {\\n    display: inline-flex;\\n  }\\n  .app:has(.app-nav > :nth-child(4)) .app-nav {\\n    position: fixed;\\n    top: 56px;\\n    bottom: 0;\\n    left: 0;\\n    z-index: 10;\\n    width: min(280px, 85vw);\\n    box-shadow: var(--shadow-popover);\\n    display: none;\\n  }\\n  .app:has(.menu-button[aria-expanded=\\\"true\\\"]) .app-nav {\\n    display: flex;\\n  }\\n}\\n.top-bar {\\n  display: flex;\\n  flex-wrap: wrap;\\n  align-items: center;\\n  gap: 12px;\\n  min-height: 56px;\\n  padding: 8px 16px;\\n  border-bottom: 1px solid var(--border);\\n}\\n.top-bar-actions {\\n  display: flex;\\n  align-items: center;\\n  gap: 4px;\\n  margin-left: auto;\\n}\\n.theme-toggle {\\n  color: var(--muted-foreground);\\n}\\n.page-shell {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 24px;\\n  max-width: 1024px;\\n  margin: 0 auto;\\n}\\n.section {\\n  display: grid;\\n  gap: 12px;\\n}\\n.list-detail {\\n  display: grid;\\n  gap: 24px;\\n}\\n@media (min-width: 1024px) {\\n  .list-detail {\\n    grid-template-columns: minmax(0, 448px) minmax(0, 1fr);\\n  }\\n  .list-detail > :first-child {\\n    padding-right: 24px;\\n    border-right: 1px solid var(--border);\\n  }\\n}\\n\\n/* Button */\\n.button {\\n  display: inline-flex;\\n  align-items: center;\\n  justify-content: center;\\n  gap: 8px;\\n  min-height: 44px;\\n  padding: 0 16px;\\n  border: 1px solid transparent;\\n  border-radius: var(--radius);\\n  background: var(--primary);\\n  color: var(--primary-foreground);\\n  font: 500 14px/20px var(--font-sans);\\n  text-decoration: none;\\n  cursor: pointer;\\n  transition:\\n    background-color var(--duration-micro) var(--ease-out),\\n    transform var(--duration-micro) var(--ease-out);\\n}\\n@media (pointer: fine) {\\n  .button {\\n    min-height: 36px;\\n  }\\n}\\n@media (hover: hover) and (pointer: fine) {\\n  .button:hover {\\n    background: var(--primary-active);\\n  }\\n}\\n.button:active {\\n  transform: scale(0.97);\\n}\\n.button:disabled {\\n  opacity: 0.5;\\n  cursor: not-allowed;\\n  transform: none;\\n}\\n.button-outline {\\n  background: transparent;\\n  color: var(--foreground);\\n  border-color: var(--border);\\n}\\n.button-ghost {\\n  background: transparent;\\n  color: var(--foreground);\\n}\\n@media (hover: hover) and (pointer: fine) {\\n  .button-outline:hover,\\n  .button-ghost:hover {\\n    background: var(--accent);\\n    color: var(--accent-foreground);\\n  }\\n}\\n\\n/* Input */\\n.input {\\n  width: 100%;\\n  min-height: 44px;\\n  padding: 0 12px;\\n  border: 1px solid var(--input);\\n  border-radius: var(--radius);\\n  background: var(--background);\\n  color: var(--foreground);\\n  font: 400 16px/24px var(--font-sans);\\n}\\n.input[aria-invalid=\\\"true\\\"] {\\n  border-color: var(--destructive);\\n}\\n.textarea,\\n.select {\\n  width: 100%;\\n  padding: 8px 12px;\\n  border: 1px solid var(--input);\\n  border-radius: var(--radius);\\n  background: var(--background);\\n  color: var(--foreground);\\n  font: 400 16px/24px var(--font-sans);\\n}\\n.textarea {\\n  min-height: 96px;\\n  resize: vertical;\\n}\\n.select {\\n  min-height: 44px;\\n}\\n.checkbox {\\n  width: 16px;\\n  height: 16px;\\n  margin: 0;\\n  accent-color: var(--primary);\\n}\\n.switch {\\n  appearance: none;\\n  display: inline-flex;\\n  width: 36px;\\n  height: 20px;\\n  margin: 0;\\n  padding: 2px;\\n  border-radius: 999px;\\n  background: var(--input);\\n  cursor: pointer;\\n  transition: background-color var(--duration-micro) var(--ease-out);\\n}\\n.switch::before {\\n  content: \\\"\\\";\\n  width: 16px;\\n  height: 16px;\\n  border-radius: 50%;\\n  background: var(--background);\\n  transition: transform var(--duration-micro) var(--ease-out);\\n}\\n.switch:checked {\\n  background: var(--primary);\\n}\\n.switch:checked::before {\\n  transform: translateX(16px);\\n}\\n.file-input {\\n  display: grid;\\n  justify-items: center;\\n  gap: 8px;\\n  padding: 24px;\\n  border: 1px dashed var(--input);\\n  border-radius: var(--radius);\\n  color: var(--muted-foreground);\\n  text-align: center;\\n}\\n\\n/* Tabs and filters */\\n.tabs,\\n.filter-bar {\\n  display: flex;\\n  flex-wrap: wrap;\\n  align-items: center;\\n  gap: 4px;\\n}\\n.tabs {\\n  border-bottom: 1px solid var(--border);\\n}\\n.tabs > * {\\n  padding: 8px 12px;\\n  border: 0;\\n  border-bottom: 2px solid transparent;\\n  background: none;\\n  color: var(--muted-foreground);\\n  font: 500 14px/20px var(--font-sans);\\n  text-decoration: none;\\n  cursor: pointer;\\n}\\n.tabs > [aria-selected=\\\"true\\\"],\\n.tabs > [aria-current=\\\"page\\\"] {\\n  border-bottom-color: var(--primary);\\n  color: var(--foreground);\\n}\\n.filter-bar {\\n  gap: 8px;\\n}\\n.filter-chip {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 4px;\\n  padding: 4px 10px;\\n  border: 1px solid var(--border);\\n  border-radius: 999px;\\n  background: transparent;\\n  color: var(--foreground);\\n  font: 600 12px/16px var(--font-sans);\\n  cursor: pointer;\\n}\\n.filter-chip[aria-pressed=\\\"true\\\"] {\\n  border-color: var(--primary);\\n  background: var(--primary);\\n  color: var(--primary-foreground);\\n}\\n\\n/* Data */\\n.card {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 16px;\\n  padding: 24px;\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius-lg);\\n  background: var(--card);\\n  color: var(--card-foreground);\\n}\\n.table,\\n.sortable-table {\\n  width: 100%;\\n  border-collapse: collapse;\\n  font-size: 14px;\\n}\\n.table th,\\n.sortable-table th {\\n  height: 40px;\\n  padding: 0 12px;\\n  color: var(--muted-foreground);\\n  font-weight: 500;\\n  text-align: left;\\n}\\n.table td,\\n.sortable-table td {\\n  padding: 12px;\\n  border-top: 1px solid var(--border);\\n}\\n.sortable-table th {\\n  cursor: pointer;\\n}\\n.sortable-table th[aria-sort=\\\"ascending\\\"]::after {\\n  content: \\\" ↑\\\";\\n}\\n.sortable-table th[aria-sort=\\\"descending\\\"]::after {\\n  content: \\\" ↓\\\";\\n}\\n.badge {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 4px;\\n  padding: 2px 6px;\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius-sm);\\n  background: var(--muted);\\n  color: var(--muted-foreground);\\n  font-size: 10px;\\n  line-height: 14px;\\n  font-weight: 600;\\n  letter-spacing: 0.08em;\\n  text-transform: uppercase;\\n}\\n.badge-success {\\n  border-color: var(--success);\\n  background: var(--success);\\n  color: var(--success-foreground);\\n}\\n.badge-warning {\\n  border-color: color-mix(in srgb, var(--primary) 40%, transparent);\\n  background: color-mix(in srgb, var(--primary) 12%, transparent);\\n  color: var(--foreground);\\n}\\n.badge-danger {\\n  border-color: var(--destructive);\\n  background: var(--destructive);\\n  color: var(--destructive-foreground);\\n}\\n.status-dot {\\n  display: inline-block;\\n  width: 8px;\\n  height: 8px;\\n  border-radius: 50%;\\n  background: var(--muted-foreground);\\n}\\n.status-dot[data-tone=\\\"success\\\"] {\\n  background: var(--success);\\n}\\n.status-dot[data-tone=\\\"warning\\\"] {\\n  background: var(--primary);\\n}\\n.status-dot[data-tone=\\\"danger\\\"] {\\n  background: var(--destructive);\\n}\\n.avatar {\\n  display: inline-grid;\\n  place-items: center;\\n  width: 32px;\\n  height: 32px;\\n  border-radius: 50%;\\n  background: var(--muted);\\n  color: var(--muted-foreground);\\n  font-size: 12px;\\n  font-weight: 700;\\n  text-transform: uppercase;\\n}\\n.stat-grid {\\n  display: grid;\\n  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));\\n  gap: 12px;\\n}\\n.stat-grid-item {\\n  display: grid;\\n  gap: 6px;\\n  padding: 16px;\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius-lg);\\n  background: var(--card);\\n}\\n.stat-grid-item > :first-child {\\n  color: var(--muted-foreground);\\n  font-size: 10px;\\n  font-weight: 600;\\n  letter-spacing: 0.12em;\\n  text-transform: uppercase;\\n}\\n.stat-grid-item > :nth-child(2) {\\n  font-size: 28px;\\n  line-height: 1;\\n  font-weight: 900;\\n  font-variant-numeric: tabular-nums;\\n}\\n\\n/* Charts: bars take an inline height, lines are inline SVG */\\n.bar-chart {\\n  display: flex;\\n  align-items: flex-end;\\n  gap: 8px;\\n  height: 160px;\\n  padding-top: 8px;\\n  border-bottom: 1px solid var(--border);\\n}\\n.bar-chart > * {\\n  flex: 1;\\n  min-width: 0;\\n  border-radius: var(--radius-sm) var(--radius-sm) 0 0;\\n  background: var(--primary);\\n}\\n.time-series-chart,\\n.sparkline {\\n  display: block;\\n  color: var(--primary);\\n}\\n.time-series-chart {\\n  width: 100%;\\n  height: 200px;\\n}\\n.sparkline {\\n  width: 96px;\\n  height: 24px;\\n}\\n.time-series-chart path,\\n.sparkline path {\\n  fill: none;\\n  stroke: currentColor;\\n  stroke-width: 2;\\n  vector-effect: non-scaling-stroke;\\n}\\n\\n/* Empty and error */\\n.empty-state,\\n.empty {\\n  display: grid;\\n  justify-items: center;\\n  gap: 16px;\\n  padding: 48px 16px;\\n  text-align: center;\\n}\\n.empty-state p,\\n.empty p {\\n  margin: 0;\\n  color: var(--muted-foreground);\\n  max-width: 45ch;\\n}\\n\\n/* Skeleton */\\n.skeleton {\\n  background: var(--muted);\\n  border-radius: var(--radius-sm);\\n  animation: pulse 1500ms var(--ease-in-out) infinite;\\n}\\n.skeleton-row {\\n  height: 56px;\\n  margin-bottom: 8px;\\n}\\n@keyframes pulse {\\n  50% {\\n    opacity: 0.6;\\n  }\\n}\\n\\n/* Dialog */\\n.dialog {\\n  width: min(480px, calc(100vw - 32px));\\n  padding: 24px;\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius-lg);\\n  background: var(--popover);\\n  color: var(--popover-foreground);\\n  box-shadow: var(--shadow-popover);\\n}\\n.dialog::backdrop {\\n  background: rgb(0 0 0 / 0.5);\\n}\\n.form {\\n  display: grid;\\n  gap: 8px;\\n}\\n.form-actions {\\n  display: flex;\\n  justify-content: flex-end;\\n  gap: 8px;\\n  margin-top: 16px;\\n}\\n.confirm-button {\\n  background: var(--destructive);\\n  color: var(--destructive-foreground);\\n}\\n@media (hover: hover) and (pointer: fine) {\\n  .confirm-button:hover {\\n    background: var(--destructive);\\n    opacity: 0.9;\\n  }\\n}\\n\\n/* Menu */\\n.menu {\\n  display: grid;\\n  min-width: 128px;\\n  padding: 4px;\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius-lg);\\n  background: var(--popover);\\n  color: var(--popover-foreground);\\n  box-shadow: var(--shadow-popover);\\n}\\n.menu > * {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  padding: 8px 10px;\\n  border: 0;\\n  border-radius: var(--radius-sm);\\n  background: none;\\n  color: inherit;\\n  font: inherit;\\n  text-align: left;\\n  text-decoration: none;\\n  cursor: pointer;\\n}\\n.menu > hr {\\n  height: 1px;\\n  margin: 4px 0;\\n  padding: 0;\\n  background: var(--border);\\n}\\n@media (hover: hover) and (pointer: fine) {\\n  .menu > :hover {\\n    background: var(--muted);\\n  }\\n}\\n\\n/* Toast */\\n.toast {\\n  position: fixed;\\n  left: 16px;\\n  right: 16px;\\n  bottom: 16px;\\n  padding: 12px 16px;\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius);\\n  background: var(--popover);\\n  color: var(--popover-foreground);\\n  box-shadow: var(--shadow-popover);\\n  transition:\\n    opacity var(--duration-standard) var(--ease-out),\\n    transform var(--duration-standard) var(--ease-out);\\n}\\n.toast[data-open=\\\"false\\\"] {\\n  opacity: 0;\\n  transform: translateY(8px);\\n  pointer-events: none;\\n}\\n.toaster {\\n  position: fixed;\\n  inset: auto 16px 16px;\\n  z-index: 20;\\n  display: grid;\\n  gap: 8px;\\n  pointer-events: none;\\n}\\n.toast[data-open=\\\"true\\\"] {\\n  pointer-events: auto;\\n}\\n.toaster .toast {\\n  position: static;\\n}\\n@media (min-width: 768px) {\\n  .toast,\\n  .toaster {\\n    left: auto;\\n    width: 360px;\\n  }\\n}\\n\\n@media (prefers-reduced-motion: reduce) {\\n  *,\\n  *::before,\\n  *::after {\\n    transition-property:\\n      opacity, color, background-color, border-color !important;\\n    animation-iteration-count: 1 !important;\\n  }\\n  .button:active {\\n    transform: none;\\n  }\\n  .toast[data-open=\\\"false\\\"] {\\n    transform: none;\\n  }\\n}\\n\\n/* ===== Weather layer: scenes, palettes and frosted panels (added for this design) ===== */\\n.sr {\\n  position: absolute;\\n  width: 1px;\\n  height: 1px;\\n  overflow: hidden;\\n  clip: rect(0 0 0 0);\\n  white-space: nowrap;\\n}\\nsvg.i {\\n  width: 20px;\\n  height: 20px;\\n  flex: none;\\n  fill: none;\\n  stroke: currentColor;\\n  stroke-width: 2;\\n  stroke-linecap: round;\\n  stroke-linejoin: round;\\n}\\nsvg.i-sm { width: 16px; height: 16px; }\\nsvg.i-lg { width: 32px; height: 32px; stroke-width: 1.75; }\\nsvg.i-xl { width: 72px; height: 72px; stroke-width: 1.25; }\\n\\n/* Frosted panels with subtle depth */\\n.card,\\n.stat-grid-item,\\n.app:has(.app-nav > :nth-child(4)) .app-nav,\\n.dialog,\\n.toast {\\n}\\n.card {\\n  box-shadow: 0 1px 2px rgb(10 20 40 / 0.06), 0 10px 30px rgb(10 20 40 / 0.1);\\n}\\n.app {\\n  color: var(--foreground);\\n  transition: color var(--duration-large) var(--ease-out);\\n}\\n.app-bar {\\n  position: sticky;\\n  top: 0;\\n  z-index: 11;\\n  background: var(--card);\\n  color: var(--card-foreground);\\n}\\n.app-main h1 { font-size: 30px; line-height: 36px; letter-spacing: -0.01em; }\\n.unit-toggle {\\n  display: inline-flex;\\n  padding: 3px;\\n  gap: 2px;\\n  border: 1px solid var(--border);\\n  border-radius: 999px;\\n  background: var(--muted);\\n}\\n.unit-toggle .filter-chip { border: 0; min-height: 32px; padding: 4px 12px; font-size: 14px; }\\n.unit-toggle .filter-chip[aria-pressed=\\\"false\\\"] { color: var(--muted-foreground); }\\n\\n/* Scene: full screen, behind everything */\\n.scene {\\n  position: fixed;\\n  inset: 0;\\n  z-index: -1;\\n  overflow: hidden;\\n  background: var(--sky-a);\\n  box-shadow: inset 0 -50vh 50vh -10vh var(--sky-b);\\n  transition: background-color var(--duration-large) var(--ease-out);\\n  animation: scene-in 1200ms var(--ease-out) both;\\n}\\n.scene i,\\n.scene::before,\\n.scene::after {\\n  content: \\\"\\\";\\n  position: absolute;\\n  top: 0;\\n  left: 0;\\n  display: block;\\n  pointer-events: none;\\n}\\n/* Particle fields: one small shape repeated by its shadows across the screen; ::after repeats it one screen above for a seamless loop */\\n.scene i {\\n  --c: rgb(255 255 255 / 0.5);\\n  --field-a: 3vw 5vh var(--c), 11vw 62vh var(--c), 17vw 28vh var(--c), 24vw 84vh var(--c), 29vw 12vh var(--c), 35vw 47vh var(--c), 41vw 73vh var(--c), 46vw 20vh var(--c), 52vw 58vh var(--c), 57vw 91vh var(--c), 63vw 35vh var(--c), 68vw 4vh var(--c), 72vw 66vh var(--c), 78vw 25vh var(--c), 83vw 80vh var(--c), 88vw 43vh var(--c), 93vw 10vh var(--c), 97vw 70vh var(--c), 7vw 38vh var(--c), 20vw 52vh var(--c), 44vw 95vh var(--c), 60vw 15vh var(--c), 75vw 50vh var(--c), 90vw 88vh var(--c);\\n  --field-b: 1vw 22vh var(--c), 6vw 77vh var(--c), 13vw 9vh var(--c), 19vw 45vh var(--c), 26vw 66vh var(--c), 31vw 30vh var(--c), 37vw 88vh var(--c), 42vw 5vh var(--c), 48vw 40vh var(--c), 54vw 72vh var(--c), 59vw 18vh var(--c), 65vw 55vh var(--c), 70vw 93vh var(--c), 76vw 8vh var(--c), 81vw 37vh var(--c), 86vw 62vh var(--c), 92vw 26vh var(--c), 98vw 49vh var(--c), 9vw 93vh var(--c), 33vw 58vh var(--c), 50vw 2vh var(--c), 67vw 80vh var(--c), 84vw 14vh var(--c), 15vw 70vh var(--c);\\n}\\n.scene i::after {\\n  content: \\\"\\\";\\n  position: absolute;\\n  top: -100vh;\\n  left: 0;\\n  width: inherit;\\n  height: inherit;\\n  border-radius: inherit;\\n  box-shadow: inherit;\\n}\\n@keyframes scene-in { from { opacity: 0; } }\\n@keyframes drift { from { transform: translateX(-6vw); } to { transform: translateX(6vw); } }\\n@keyframes fall { to { transform: translateY(100vh); } }\\n@keyframes blow { to { transform: translateX(100vw); } }\\n@keyframes flash { 0%, 88%, 100% { opacity: 0; } 89% { opacity: 0.9; } 90.5% { opacity: 0; } 92% { opacity: 0.55; } 93.5% { opacity: 0; } }\\n@keyframes shimmer { from { transform: translateY(0) skewX(0); } to { transform: translateY(-6px) skewX(2deg); } }\\n@keyframes twinkle { from { opacity: 0.55; } to { opacity: 1; } }\\n\\n/* Sky colours per condition and day/night */\\n[data-wx=\\\"clear-day\\\"] { --sky-a: #3d7fd1; --sky-b: #9cc9f2; }\\n[data-wx=\\\"hot-day\\\"] { --sky-a: #e7801c; --sky-b: #f9d58a; }\\n[data-wx=\\\"cloudy-day\\\"] { --sky-a: #7d8ea1; --sky-b: #c9d3dd; }\\n[data-wx=\\\"rain-day\\\"] { --sky-a: #3f5876; --sky-b: #8ea2b7; }\\n[data-wx=\\\"storm-day\\\"] { --sky-a: #2a2e44; --sky-b: #5b607b; }\\n[data-wx=\\\"snow-day\\\"] { --sky-a: #8fa6bf; --sky-b: #dce5ee; }\\n[data-wx=\\\"wind-day\\\"] { --sky-a: #4f86ad; --sky-b: #bcd6e6; }\\n[data-wx=\\\"fog-day\\\"] { --sky-a: #9aa1a8; --sky-b: #dde1e5; }\\n[data-wx=\\\"clear-night\\\"] { --sky-a: #070b26; --sky-b: #283070; }\\n[data-wx=\\\"hot-night\\\"] { --sky-a: #1d1736; --sky-b: #5a2f45; }\\n[data-wx=\\\"cloudy-night\\\"] { --sky-a: #161c29; --sky-b: #3a4356; }\\n[data-wx=\\\"rain-night\\\"] { --sky-a: #0c1626; --sky-b: #2a3b55; }\\n[data-wx=\\\"storm-night\\\"] { --sky-a: #07071a; --sky-b: #2b2445; }\\n[data-wx=\\\"snow-night\\\"] { --sky-a: #18263f; --sky-b: #4a5f80; }\\n[data-wx=\\\"wind-night\\\"] { --sky-a: #0b1f30; --sky-b: #2c4b60; }\\n[data-wx=\\\"fog-night\\\"] { --sky-a: #1b1f24; --sky-b: #40464e; }\\n[data-wx=\\\"calm\\\"] { --sky-a: #cfd9e4; --sky-b: #f3f6f9; }\\n\\n/* Clouds (cloudy, rain, storm, snow, wind): soft blurred shapes */\\n.scene:is([data-wx^=\\\"cloudy\\\"], [data-wx^=\\\"rain\\\"], [data-wx^=\\\"storm\\\"], [data-wx^=\\\"snow\\\"], [data-wx^=\\\"wind\\\"])::before {\\n  top: 4vh;\\n  left: 4vw;\\n  width: 40vw;\\n  height: 12vh;\\n  border-radius: 50%;\\n  background: rgb(255 255 255 / 0.3);\\n  box-shadow: 46vw -2vh 0 2vh rgb(255 255 255 / 0.24), 22vw 16vh 0 1vh rgb(255 255 255 / 0.16), 70vw 18vh 0 0 rgb(255 255 255 / 0.18);\\n  filter: blur(28px);\\n  animation: drift 60s var(--ease-in-out) infinite alternate;\\n}\\n.scene[data-wx$=\\\"-night\\\"]:not([data-wx^=\\\"clear\\\"]):not([data-wx^=\\\"hot\\\"])::before { opacity: 0.5; }\\n.scene[data-wx^=\\\"storm\\\"]::before { filter: brightness(0.55); }\\n.scene[data-wx^=\\\"wind\\\"]::before { animation-duration: 9s; }\\n.scene[data-wx^=\\\"cloudy\\\"] i:nth-child(1),\\n.scene[data-wx^=\\\"cloudy\\\"] i:nth-child(2) {\\n  top: 34vh;\\n  left: 10vw;\\n  width: 36vw;\\n  height: 12vh;\\n  border-radius: 50%;\\n  background: rgb(255 255 255 / 0.22);\\n  box-shadow: 44vw 6vh 0 1vh rgb(255 255 255 / 0.18);\\n  filter: blur(30px);\\n  animation: drift 40s var(--ease-in-out) infinite alternate-reverse;\\n}\\n.scene[data-wx^=\\\"cloudy\\\"] i:nth-child(2) { top: 64vh; left: 24vw; animation-duration: 80s; animation-direction: alternate; }\\n\\n/* Rain and storm drops: near and far layers */\\n.scene:is([data-wx^=\\\"rain\\\"], [data-wx^=\\\"storm\\\"]) i:nth-child(1) {\\n  --c: rgb(255 255 255 / 0.55);\\n  width: 2px;\\n  height: 18px;\\n  border-radius: 1px;\\n  box-shadow: var(--field-a);\\n  animation: fall 800ms linear infinite;\\n}\\n.scene:is([data-wx^=\\\"rain\\\"], [data-wx^=\\\"storm\\\"]) i:nth-child(2) {\\n  --c: rgb(255 255 255 / 0.3);\\n  width: 1px;\\n  height: 10px;\\n  box-shadow: var(--field-b);\\n  animation: fall 1300ms linear infinite;\\n}\\n.scene[data-intensity=\\\"light\\\"] i:nth-child(1) { opacity: 0.45; }\\n.scene[data-intensity=\\\"light\\\"] i:nth-child(2) { display: none; }\\n.scene[data-wx^=\\\"storm\\\"] i:nth-child(3) {\\n  width: 100vw;\\n  height: 100vh;\\n  background: rgb(220 225 255 / 0.4);\\n  opacity: 0;\\n  animation: flash 7s linear infinite;\\n}\\n\\n/* Snow: flakes with depth */\\n.scene[data-wx^=\\\"snow\\\"] i:nth-child(1) {\\n  --c: rgb(255 255 255 / 0.95);\\n  width: 5px;\\n  height: 5px;\\n  border-radius: 50%;\\n  box-shadow: var(--field-a);\\n  animation: fall 11s linear infinite;\\n}\\n.scene[data-wx^=\\\"snow\\\"] i:nth-child(2) {\\n  --c: rgb(255 255 255 / 0.7);\\n  width: 3px;\\n  height: 3px;\\n  border-radius: 50%;\\n  box-shadow: var(--field-b);\\n  filter: blur(0.5px);\\n  animation: fall 19s linear infinite;\\n}\\n\\n/* Wind: streaks and blown leaves */\\n.scene[data-wx^=\\\"wind\\\"] i:nth-child(1),\\n.scene[data-wx^=\\\"wind\\\"] i:nth-child(2) {\\n  --c: rgb(255 255 255 / 0.5);\\n  width: 90px;\\n  height: 2px;\\n  border-radius: 1px;\\n  box-shadow: var(--field-a);\\n  animation: blow 1.6s linear infinite;\\n}\\n.scene[data-wx^=\\\"wind\\\"] i:nth-child(2) {\\n  --c: rgb(255 255 255 / 0.6);\\n  width: 5px;\\n  height: 3px;\\n  box-shadow: var(--field-b);\\n  animation-duration: 4s;\\n}\\n.scene[data-wx^=\\\"wind\\\"] i::after { top: 0; left: -100vw; }\\n\\n/* Fog: low rolling mist */\\n.scene[data-wx^=\\\"fog\\\"] i:nth-child(1),\\n.scene[data-wx^=\\\"fog\\\"] i:nth-child(2) {\\n  top: 42vh;\\n  left: -10vw;\\n  width: 70vw;\\n  height: 22vh;\\n  border-radius: 50%;\\n  background: rgb(255 255 255 / 0.45);\\n  box-shadow: 60vw 8vh 0 0 rgb(255 255 255 / 0.4);\\n  filter: blur(40px);\\n  animation: drift 30s var(--ease-in-out) infinite alternate;\\n}\\n.scene[data-wx^=\\\"fog\\\"] i:nth-child(2) { top: 66vh; animation-duration: 45s; animation-direction: alternate-reverse; }\\n.scene[data-wx^=\\\"fog\\\"] i:nth-child(3) { top: 70vh; width: 100vw; height: 30vh; background: rgb(255 255 255 / 0.25); filter: blur(30px); }\\n.scene[data-wx=\\\"fog-night\\\"] i { opacity: 0.45; }\\n\\n/* Clear and hot: sun glow, heat shimmer */\\n.scene:is([data-wx=\\\"clear-day\\\"], [data-wx=\\\"hot-day\\\"])::before {\\n  top: 10vh;\\n  left: auto;\\n  right: 12vw;\\n  width: 96px;\\n  height: 96px;\\n  border-radius: 50%;\\n  background: #fff8e1;\\n  box-shadow: 0 0 60px 30px rgb(255 240 200 / 0.55), 0 0 220px 120px rgb(255 225 160 / 0.22);\\n}\\n.scene[data-wx=\\\"hot-day\\\"]::before {\\n  width: 132px;\\n  height: 132px;\\n  background: #fff4d6;\\n  box-shadow: 0 0 80px 40px rgb(255 210 140 / 0.6), 0 0 300px 160px rgb(255 190 110 / 0.28);\\n}\\n.scene[data-wx=\\\"hot-day\\\"] i:nth-child(3) {\\n  top: 58vh;\\n  width: 100vw;\\n  height: 42vh;\\n  background: rgb(255 255 255 / 0.07);\\n  filter: blur(6px);\\n  animation: shimmer 2.4s var(--ease-in-out) infinite alternate;\\n}\\n\\n/* Clear night: stars and moon */\\n.scene:is([data-wx=\\\"clear-night\\\"], [data-wx=\\\"hot-night\\\"])::before {\\n  top: 12vh;\\n  left: auto;\\n  right: 16vw;\\n  width: 56px;\\n  height: 56px;\\n  border-radius: 50%;\\n  background: #f4f1e6;\\n  box-shadow: 0 0 40px 12px rgb(244 241 230 / 0.2);\\n}\\n.scene:is([data-wx=\\\"clear-night\\\"], [data-wx=\\\"hot-night\\\"]) i:nth-child(1),\\n.scene:is([data-wx=\\\"clear-night\\\"], [data-wx=\\\"hot-night\\\"]) i:nth-child(2) {\\n  --c: rgb(255 255 255 / 0.9);\\n  width: 2px;\\n  height: 2px;\\n  border-radius: 50%;\\n  box-shadow: var(--field-a);\\n  animation: twinkle 4s var(--ease-in-out) infinite alternate;\\n}\\n.scene:is([data-wx=\\\"clear-night\\\"], [data-wx=\\\"hot-night\\\"]) i:nth-child(2) { --c: rgb(255 255 255 / 0.6); box-shadow: var(--field-b); animation-delay: -2s; }\\n\\n/* Simpler effects: fewer layers. Calm: nothing moves, nothing flashes. */\\n.scene.lite i:nth-child(2) { display: none; }\\n.scene.lite i:nth-child(1) { opacity: 0.6; }\\n.scene.calm i,\\n.scene.calm::before,\\n.scene.calm::after { animation: none !important; }\\n.scene.calm[data-wx^=\\\"storm\\\"] i:nth-child(3) { display: none; }\\n@media (prefers-reduced-motion: reduce) {\\n  .scene,\\n  .scene i,\\n  .scene::before,\\n  .scene::after { animation: none !important; }\\n  .scene[data-wx^=\\\"storm\\\"] i:nth-child(3) { display: none; }\\n}\\n\\n/* Palettes: the shown scene sets the whole app's accent and panels */\\n.app:has(section:not([hidden]) > [data-state]:not([hidden]) > .scene[data-wx$=\\\"-day\\\"]),\\n.app:has(section:not([hidden]) > [data-state]:not([hidden]) > .scene[data-wx=\\\"calm\\\"]) {\\n  --background: #ffffff;\\n  --foreground: #121820;\\n  --card: rgb(255 255 255 / 0.82);\\n  --card-foreground: #121820;\\n  --popover: #ffffff;\\n  --popover-foreground: #121820;\\n  --muted: rgb(18 24 32 / 0.06);\\n  --muted-foreground: #434d5b;\\n  --accent: rgb(18 24 32 / 0.08);\\n  --accent-foreground: #121820;\\n  --border: rgb(18 24 32 / 0.12);\\n  --input: #7b8594;\\n  --pop: #1f5f99;\\n  color-scheme: light;\\n}\\n.app:has(section:not([hidden]) > [data-state]:not([hidden]) > .scene[data-wx$=\\\"-night\\\"]) {\\n  --background: #0e1330;\\n  --foreground: #eef1fa;\\n  --card: rgb(14 18 40 / 0.74);\\n  --card-foreground: #eef1fa;\\n  --popover: #171c3d;\\n  --popover-foreground: #eef1fa;\\n  --muted: rgb(255 255 255 / 0.08);\\n  --muted-foreground: #b6bdd6;\\n  --accent: rgb(255 255 255 / 0.12);\\n  --accent-foreground: #eef1fa;\\n  --border: rgb(255 255 255 / 0.14);\\n  --input: #8b93b3;\\n  --pop: #9cc7f0;\\n  color-scheme: dark;\\n}\\n.app:has(section:not([hidden]) > [data-state]:not([hidden]) > .scene[data-wx=\\\"clear-day\\\"]) { --primary: #1d5fb3; --primary-active: #174e94; --ring: #1d5fb3; --primary-foreground: #fff; }\\n.app:has(section:not([hidden]) > [data-state]:not([hidden]) > .scene[data-wx=\\\"hot-day\\\"]) { --primary: #a54a08; --primary-active: #8a3e06; --ring: #a54a08; --primary-foreground: #fff; }\\n.app:has(section:not([hidden]) > [data-state]:not([hidden]) > .scene[data-wx=\\\"cloudy-day\\\"]) { --primary: #3f5872; --primary-active: #33485e; --ring: #3f5872; --primary-foreground: #fff; }\\n.app:has(section:not([hidden]) > [data-state]:not([hidden]) > .scene[data-wx=\\\"rain-day\\\"]) { --primary: #2f5b8a; --primary-active: #264b72; --ring: #2f5b8a; --primary-foreground: #fff; }\\n.app:has(section:not([hidden]) > [data-state]:not([hidden]) > .scene[data-wx=\\\"storm-day\\\"]) { --primary: #4f46a8; --primary-active: #423a90; --ring: #4f46a8; --primary-foreground: #fff; }\\n.app:has(section:not([hidden]) > [data-state]:not([hidden]) > .scene[data-wx=\\\"snow-day\\\"]) { --primary: #2563a8; --primary-active: #1e5290; --ring: #2563a8; --primary-foreground: #fff; }\\n.app:has(section:not([hidden]) > [data-state]:not([hidden]) > .scene[data-wx=\\\"wind-day\\\"]) { --primary: #0e6a82; --primary-active: #0b586c; --ring: #0e6a82; --primary-foreground: #fff; }\\n.app:has(section:not([hidden]) > [data-state]:not([hidden]) > .scene[data-wx=\\\"fog-day\\\"]) { --primary: #4b5563; --primary-active: #3d4651; --ring: #4b5563; --primary-foreground: #fff; }\\n.app:has(section:not([hidden]) > [data-state]:not([hidden]) > .scene[data-wx=\\\"clear-night\\\"]) { --primary: #a5b4fc; --primary-active: #c3cdfd; --ring: #a5b4fc; --primary-foreground: #0b1030; }\\n.app:has(section:not([hidden]) > [data-state]:not([hidden]) > .scene[data-wx=\\\"hot-night\\\"]) { --primary: #f6b44b; --primary-active: #f8c56f; --ring: #f6b44b; --primary-foreground: #1d1736; }\\n.app:has(section:not([hidden]) > [data-state]:not([hidden]) > .scene[data-wx=\\\"cloudy-night\\\"]) { --primary: #9fb3cf; --primary-active: #b8c8de; --ring: #9fb3cf; --primary-foreground: #11151f; }\\n.app:has(section:not([hidden]) > [data-state]:not([hidden]) > .scene[data-wx=\\\"rain-night\\\"]) { --primary: #7fa9db; --primary-active: #9dbde4; --ring: #7fa9db; --primary-foreground: #0c1626; }\\n.app:has(section:not([hidden]) > [data-state]:not([hidden]) > .scene[data-wx=\\\"storm-night\\\"]) { --primary: #b2a6ff; --primary-active: #c9c0ff; --ring: #b2a6ff; --primary-foreground: #0e0b22; }\\n.app:has(section:not([hidden]) > [data-state]:not([hidden]) > .scene[data-wx=\\\"snow-night\\\"]) { --primary: #bcd7f5; --primary-active: #d3e5f8; --ring: #bcd7f5; --primary-foreground: #18263f; }\\n.app:has(section:not([hidden]) > [data-state]:not([hidden]) > .scene[data-wx=\\\"wind-night\\\"]) { --primary: #6cc6dc; --primary-active: #8fd4e5; --ring: #6cc6dc; --primary-foreground: #0b1f30; }\\n.app:has(section:not([hidden]) > [data-state]:not([hidden]) > .scene[data-wx=\\\"fog-night\\\"]) { --primary: #c0c7cf; --primary-active: #d4d9df; --ring: #c0c7cf; --primary-foreground: #1b1f24; }\\n\\n/* Weather screen layout: places panel + main view */\\n.wx-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }\\n.wx-main,\\n.places { min-width: 0; }\\n@media (min-width: 1200px) {\\n  .wx-layout { grid-template-columns: 280px minmax(0, 1fr); align-items: start; gap: 24px; }\\n  .places { position: sticky; top: 80px; }\\n}\\n.places { gap: 12px; padding: 16px; }\\n.label {\\n  font-size: 12px;\\n  line-height: 16px;\\n  font-weight: 600;\\n  letter-spacing: 0.08em;\\n  text-transform: uppercase;\\n  color: var(--muted-foreground);\\n}\\n.search-entry {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  min-height: 44px;\\n  padding: 0 12px;\\n  border: 1px solid var(--input);\\n  border-radius: var(--radius);\\n  background: var(--popover);\\n  color: var(--muted-foreground);\\n  font-size: 16px;\\n  text-decoration: none;\\n}\\n.place-list {\\n  list-style: none;\\n  margin: 0;\\n  padding: 2px 2px 6px;\\n  display: flex;\\n  gap: 8px;\\n  overflow-x: auto;\\n  scroll-snap-type: x mandatory;\\n}\\n.place-list > li { flex: 0 0 auto; scroll-snap-align: start; }\\n@media (min-width: 1200px) {\\n  .place-list { flex-direction: column; overflow: visible; padding: 0; }\\n}\\n.place {\\n  display: flex;\\n  align-items: center;\\n  gap: 10px;\\n  min-width: 196px;\\n  padding: 8px 12px 8px 8px;\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius);\\n  color: inherit;\\n  text-decoration: none;\\n}\\n.place[aria-current=\\\"true\\\"] { border-color: var(--primary); box-shadow: inset 0 0 0 1px var(--primary); background: var(--muted); }\\n.place-text { display: grid; line-height: 18px; }\\n.place-temp { font-size: 20px; font-weight: 600; font-variant-numeric: tabular-nums; }\\n.wx-chip {\\n  display: inline-grid;\\n  place-items: center;\\n  width: 36px;\\n  height: 36px;\\n  flex: none;\\n  border-radius: 50%;\\n  background: var(--sky-a);\\n  color: #fff;\\n  box-shadow: inset 0 -12px 12px -4px var(--sky-b), inset 0 0 0 1px rgb(0 0 0 / 0.12);\\n}\\n.wx-chip svg { filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.45)); }\\n\\n/* Current conditions */\\n.sub { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 0; }\\n.hero-top { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }\\n.temp {\\n  margin: 0;\\n  font-size: clamp(64px, 14vw, 96px);\\n  line-height: 1;\\n  font-weight: 250;\\n  letter-spacing: -0.04em;\\n  font-variant-numeric: tabular-nums;\\n}\\n.cond { margin: 0; font-size: 20px; line-height: 28px; font-weight: 600; }\\n.hero .stat-grid { grid-template-columns: repeat(auto-fit, minmax(132px, 1fr)); }\\n.hero .stat-grid-item { background: var(--muted); -webkit-backdrop-filter: none; backdrop-filter: none; }\\n.hero .stat-grid-item > :nth-child(2) { font-size: 24px; font-weight: 600; }\\n.hero .stat-grid-item small { color: var(--muted-foreground); font-size: 12px; line-height: 16px; }\\n.hero-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }\\n.small { font-size: 12px; line-height: 16px; }\\n.switch-label { gap: 10px; cursor: pointer; font-weight: 500; }\\n\\n/* 24-hour strip */\\n.hours {\\n  list-style: none;\\n  margin: 0;\\n  padding: 0 0 6px;\\n  display: flex;\\n  gap: 4px;\\n  overflow-x: auto;\\n  scroll-snap-type: x proximity;\\n}\\n.hours > li {\\n  flex: 0 0 64px;\\n  display: grid;\\n  justify-items: center;\\n  gap: 6px;\\n  padding: 10px 4px;\\n  border-radius: var(--radius);\\n  scroll-snap-align: start;\\n  text-align: center;\\n}\\n.hours > li:first-child { background: var(--muted); font-weight: 600; }\\n.hours b { font-size: 16px; font-variant-numeric: tabular-nums; }\\n.pop { color: var(--pop, #1f5f99); font-size: 12px; font-weight: 600; font-variant-numeric: tabular-nums; }\\n\\n/* 7-day list */\\n.days { list-style: none; margin: 0; padding: 0; }\\n.days > li {\\n  display: grid;\\n  grid-template-columns: 52px minmax(0, 1fr) 40px auto;\\n  align-items: center;\\n  gap: 10px;\\n  padding: 10px 0;\\n  border-top: 1px solid var(--border);\\n}\\n.day-cond { display: flex; align-items: center; gap: 8px; min-width: 0; }\\n.range { display: flex; align-items: center; gap: 8px; font-variant-numeric: tabular-nums; }\\n.range .lo { color: var(--muted-foreground); }\\n.range-bar { display: none; position: relative; width: 120px; height: 6px; border-radius: 3px; background: var(--muted); }\\n.range-bar > span { position: absolute; inset-block: 0; border-radius: 3px; background: var(--primary); }\\n@media (min-width: 560px) {\\n  .range-bar { display: block; }\\n  .days > li { grid-template-columns: 64px minmax(0, 1fr) 48px auto; gap: 16px; }\\n}\\n\\n/* Notices (offline, error, permission) */\\n.notice { flex-direction: row; align-items: flex-start; gap: 12px; padding: 16px; border-left: 4px solid var(--primary); }\\n.notice-error { border-left-color: var(--destructive); }\\n.notice p { margin: 0; }\\n\\n/* Saved cities list */\\n.city-list { list-style: none; margin: 0; padding: 4px 16px; gap: 0; }\\n.city-row {\\n  display: grid;\\n  grid-template-columns: auto auto minmax(0, 1fr) auto auto;\\n  align-items: center;\\n  gap: 12px;\\n  padding: 12px 0;\\n}\\n.city-row + .city-row { border-top: 1px solid var(--border); }\\n.city-main { display: grid; color: inherit; text-decoration: none; line-height: 20px; }\\n.city-cond { grid-column: 3; color: var(--muted-foreground); font-size: 13px; }\\n.city-temp { font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; text-align: right; min-width: 3ch; }\\n\\n\\n/* Compare */\\n.cmp-grid {\\n  display: grid;\\n  grid-auto-flow: column;\\n  grid-auto-columns: minmax(min(260px, 82vw), 1fr);\\n  gap: 16px;\\n  overflow-x: auto;\\n  padding-bottom: 8px;\\n  scroll-snap-type: x mandatory;\\n}\\n.cmp-grid > * { scroll-snap-align: start; }\\n.cmp { padding: 0; overflow: hidden; gap: 0; }\\n.cmp > :not(.wx-band) { padding-inline: 20px; }\\n.wx-band {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  height: 72px;\\n  padding: 0 20px;\\n  background: var(--sky-a);\\n  box-shadow: inset 0 -28px 28px -8px var(--sky-b);\\n  color: #fff;\\n}\\n.wx-band svg { filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.4)); }\\n.cmp-head { padding-top: 16px; }\\n.cmp-temp { margin: 8px 0 0; font-size: 48px; line-height: 1; font-weight: 300; font-variant-numeric: tabular-nums; }\\n.cmp-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 16px 0; }\\n.cmp-stats dt { color: var(--muted-foreground); font-size: 12px; }\\n.cmp-stats dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; }\\n.outlook {\\n  list-style: none;\\n  margin: 0;\\n  padding: 12px 20px 20px;\\n  display: grid;\\n  grid-template-columns: repeat(4, 1fr);\\n  gap: 4px;\\n  border-top: 1px solid var(--border);\\n  text-align: center;\\n  font-size: 13px;\\n}\\n.outlook li { display: grid; justify-items: center; gap: 4px; }\\n\\n/* Settings: scene gallery */\\n.swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 12px; }\\n.swatch { display: grid; gap: 6px; font-size: 13px; }\\n.swatch > span:first-child {\\n  display: grid;\\n  place-items: center;\\n  height: 64px;\\n  border-radius: var(--radius);\\n  background: var(--sky-a);\\n  box-shadow: inset 0 -24px 24px -8px var(--sky-b);\\n  color: #fff;\\n}\\n.swatch svg { filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.4)); }\\n.setting-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }\\n.setting-row p { margin: 4px 0 0; max-width: 60ch; }\\n\\n/* Adaptive layer: narrow pages, rows, phone/desktop helpers */\\n.narrow { max-width: 760px; margin-inline: auto; }\\n.icon-button { padding-inline: 10px; }\\n.city-main { min-width: 0; }\\n.city-main > * { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n.result-row { grid-template-columns: auto minmax(0, 1fr) auto auto; }\\n.show-sm { display: block; }\\n.hide-sm { display: none; }\\n@media (min-width: 640px) {\\n  .show-sm { display: none; }\\n  .hide-sm { display: inline; }\\n}\\n.place-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); overflow: visible; scroll-snap-type: none; }\\n.place-grid .place { min-width: 0; }\\n.welcome { max-width: 560px; margin: 8vh auto 0; padding: 48px 24px; }\\n.wx-chip-lg { width: 64px; height: 64px; }\\n.swatches { list-style: none; margin: 0; padding: 0; }\\n.app-nav svg.i { width: 18px; height: 18px; }\\n.app-bar .app-name { margin-right: auto; }\\n@media (min-width: 768px) {\\n  .app-bar [data-testid=\\\"top-search-link\\\"] { display: none; }\\n}\\n40:.badge {\\n55:.badge-success {\\n60:.badge-warning {\\n65:.badge-danger {\\n98:.stat-grid {\\n103:.stat-grid-item {\\n111:.stat-grid-item > :first-child {\\n118:.stat-grid-item > :nth-child(2) {\\n162:.empty-state,\\n163:.empty {\\n170:.empty-state p,\\n171:.empty p {\\n265:.toast {\\n280:.toast[data-open=\\\"false\\\"] {\\n285:.toaster {\\n292:.toaster .toast {\\n296:  .toast,\\n297:  .toaster {\\n313:  .toast[data-open=\\\"false\\\"] {\\n\"}"}}]},"finish_reason":null}]}

data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":1,"id":"des_write_html","function":{"name":"write_file","arguments":""}}]},"finish_reason":null}]}

data: {"choices":[{"index":0,"delta":{"tool_calls":[{"index":1,"function":{"arguments":"{\"path\":\".builder/designs/index.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n  <head>\\n    <meta charset=\\\"utf-8\\\" />\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\" />\\n    <title>Animated Weather</title>\\n    <meta name=\\\"theme-color\\\" content=\\\"#3f5876\\\" />\\n    <link rel=\\\"stylesheet\\\" href=\\\"styles.css\\\" />\\n  </head>\\n  <body>\\n    <svg width='0' height='0' style='position:absolute' aria-hidden='true'><symbol id='i-sun' viewBox='0 0 24 24'><circle cx='12' cy='12' r='4'/><path d='M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41'/></symbol><symbol id='i-moon' viewBox='0 0 24 24'><path d='M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z'/></symbol><symbol id='i-cloud' viewBox='0 0 24 24'><path d='M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z'/></symbol><symbol id='i-cloud-sun' viewBox='0 0 24 24'><path d='M12 2v2M4.93 4.93l1.41 1.41M20 12h2M19.07 4.93l-1.41 1.41M15.95 12.65a4 4 0 0 0-5.93-4.13'/><path d='M13 22H7a5 5 0 1 1 4.9-6H13a3 3 0 0 1 0 6Z'/></symbol><symbol id='i-cloud-moon' viewBox='0 0 24 24'><path d='M10.19 8.5A4 4 0 0 1 16 4.5a3.5 3.5 0 0 0 4.5 4.5 4 4 0 0 1-1.87 3.73'/><path d='M13 22H7a5 5 0 1 1 4.9-6H13a3 3 0 0 1 0 6Z'/></symbol><symbol id='i-rain' viewBox='0 0 24 24'><path d='M4 14.9A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.24'/><path d='M16 14v6M8 14v6M12 16v6'/></symbol><symbol id='i-drizzle' viewBox='0 0 24 24'><path d='M4 14.9A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.24'/><path d='M8 19v1M8 14v1M16 19v1M16 14v1M12 21v1M12 16v1'/></symbol><symbol id='i-storm' viewBox='0 0 24 24'><path d='M6 16.33A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 .5 8.97'/><path d='m13 12-3 5h4l-3 5'/></symbol><symbol id='i-snow' viewBox='0 0 24 24'><path d='M2 12h20M12 2v20M20 16l-4-4 4-4M4 8l4 4-4 4M16 4l-4 4-4-4M8 20l4-4 4 4'/></symbol><symbol id='i-wind' viewBox='0 0 24 24'><path d='M12.8 19.6A2 2 0 1 0 14 16H2M17.5 8a2.5 2.5 0 1 1 2 4H2M9.8 4.4A2 2 0 1 1 11 8H2'/></symbol><symbol id='i-fog' viewBox='0 0 24 24'><path d='M4 14.9A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.24'/><path d='M16 17H7M17 21H9'/></symbol><symbol id='i-search' viewBox='0 0 24 24'><circle cx='11' cy='11' r='8'/><path d='m21 21-4.3-4.3'/></symbol><symbol id='i-locate' viewBox='0 0 24 24'><path d='M3 11 22 2l-9 19-2-8-8-2Z'/></symbol><symbol id='i-refresh' viewBox='0 0 24 24'><path d='M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8M21 3v5h-5M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16M8 16H3v5'/></symbol><symbol id='i-bookmark' viewBox='0 0 24 24'><path d='m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16Z'/></symbol><symbol id='i-trash' viewBox='0 0 24 24'><path d='M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2'/></symbol><symbol id='i-offline' viewBox='0 0 24 24'><path d='M12 20h.01M8.5 16.43a5 5 0 0 1 7 0M2 8.82a15 15 0 0 1 4.17-2.65M10.66 5c4.01-.36 8.14.9 11.34 3.76M16.85 11.25a10 10 0 0 1 2.22 1.68M5 13a10 10 0 0 1 5.24-2.76M2 2l20 20'/></symbol><symbol id='i-alert' viewBox='0 0 24 24'><circle cx='12' cy='12' r='10'/><path d='M12 8v4M12 16h.01'/></symbol><symbol id='i-pin-off' viewBox='0 0 24 24'><path d='M12.75 7.09a3 3 0 0 1 2.16 2.16M17.07 17.06C15.6 18.84 13.9 20.38 12.6 21.8a1 1 0 0 1-1.2 0C9.54 20.19 4 15 4 10a7.9 7.9 0 0 1 1.45-4.55M8.5 2.86A8 8 0 0 1 20 10a8.6 8.6 0 0 1-.83 3.6M2 2l20 20'/></symbol><symbol id='i-check' viewBox='0 0 24 24'><path d='M20 6 9 17l-5-5'/></symbol><symbol id='i-compare' viewBox='0 0 24 24'><rect x='3' y='3' width='18' height='18' rx='2'/><path d='M12 3v18'/></symbol><symbol id='i-download' viewBox='0 0 24 24'><path d='M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3'/></symbol><symbol id='i-home' viewBox='0 0 24 24'><path d='M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1Z'/></symbol><symbol id='i-settings' viewBox='0 0 24 24'><path d='M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6'/></symbol><symbol id='i-plus' viewBox='0 0 24 24'><path d='M12 5v14M5 12h14'/></symbol><symbol id='i-clock' viewBox='0 0 24 24'><circle cx='12' cy='12' r='10'/><path d='M12 6v6l4 2'/></symbol></svg>\\n    <div class=\\\"app\\\">\\n      <header class=\\\"app-bar\\\">\\n        <button type=\\\"button\\\" class=\\\"button button-ghost menu-button\\\" aria-expanded=\\\"false\\\" aria-label=\\\"Menu\\\" data-menu-toggle data-testid=\\\"menu-button\\\">\\n          <svg width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" aria-hidden=\\\"true\\\"><path d=\\\"M4 6h16M4 12h16M4 18h16\\\" /></svg>\\n        </button>\\n        <a href=\\\"#/home\\\" class=\\\"app-name\\\" data-testid=\\\"app-name-link\\\">Animated Weather</a>\\n        <nav class=\\\"app-nav\\\" aria-label=\\\"Main\\\"><a href='#/home' data-testid='nav-home-link'><svg class='i' aria-hidden='true'><use href='#i-home'/></svg>Home</a><a href='#/search' data-testid='nav-search-link'><svg class='i' aria-hidden='true'><use href='#i-search'/></svg>Search</a><a href='#/cities' data-testid='nav-cities-link'><svg class='i' aria-hidden='true'><use href='#i-bookmark'/></svg>Saved cities</a><a href='#/compare' data-testid='nav-compare-link'><svg class='i' aria-hidden='true'><use href='#i-compare'/></svg>Compare</a><a href='#/settings' data-testid='nav-settings-link'><svg class='i' aria-hidden='true'><use href='#i-settings'/></svg>Settings</a></nav>\\n        <a href=\\\"#/search\\\" class=\\\"button button-ghost icon-button\\\" aria-label=\\\"Search for a city\\\" data-testid=\\\"top-search-link\\\"><svg class='i' aria-hidden='true'><use href='#i-search'/></svg></a>\\n      </header>\\n      <main class=\\\"app-main\\\">\\n<section data-screen=\\\"home\\\" data-testid='screen-home' aria-label='Home'>\\n<div data-state=\\\"populated\\\" data-testid='home-populated'><div class='scene' data-wx='rain-day' aria-hidden='true'><i></i><i></i><i></i></div><div class='wx-layout'><aside class='card places' aria-label='Your places'><a class='search-entry' href='#/search' data-testid='home-search-link'><svg class='i' aria-hidden='true'><use href='#i-search'/></svg><span class='grow'>Search for a city</span></a><div class='row between'><h2 class='label'>Your places</h2><a class='button button-ghost' href='#/cities' data-testid='home-edit-link'>Edit</a></div><ul class='place-list' data-testid='home-places-list'><li><a class='place' href='#/home' aria-current='true' data-testid='home-place-row'><span class='wx-chip' data-wx='rain-day'><svg class='i' aria-hidden='true'><use href='#i-rain'/></svg></span><span class='grow place-text'><b>My location</b><small class='muted'>London · Moderate rain</small></span><span class='place-temp'>9°</span></a></li><li><a class='place' href='#/home/hot' data-testid='home-place-row'><span class='wx-chip' data-wx='hot-day'><svg class='i' aria-hidden='true'><use href='#i-sun'/></svg></span><span class='grow place-text'><b>Perth</b><small class='muted'>Sunny and hot</small></span><span class='place-temp'>34°</span></a></li><li><a class='place' href='#/home/snow' data-testid='home-place-row'><span class='wx-chip' data-wx='snow-day'><svg class='i' aria-hidden='true'><use href='#i-snow'/></svg></span><span class='grow place-text'><b>Oslo</b><small class='muted'>Heavy snow</small></span><span class='place-temp'>−3°</span></a></li><li><a class='place' href='#/home/night' data-testid='home-place-row'><span class='wx-chip' data-wx='clear-night'><svg class='i' aria-hidden='true'><use href='#i-moon'/></svg></span><span class='grow place-text'><b>Sydney</b><small class='muted'>Clear</small></span><span class='place-temp'>22°</span></a></li><li><a class='place' href='#/home/storm' data-testid='home-place-row'><span class='wx-chip' data-wx='storm-night'><svg class='i' aria-hidden='true'><use href='#i-storm'/></svg></span><span class='grow place-text'><b>Darwin</b><small class='muted'>Thunderstorm</small></span><span class='place-temp'>27°</span></a></li><li><a class='place' href='#/home/fog' data-testid='home-place-row'><span class='wx-chip' data-wx='fog-day'><svg class='i' aria-hidden='true'><use href='#i-fog'/></svg></span><span class='grow place-text'><b>Milan</b><small class='muted'>Fog</small></span><span class='place-temp'>2°</span></a></li><li><a class='place' href='#/home/wind' data-testid='home-place-row'><span class='wx-chip' data-wx='wind-day'><svg class='i' aria-hidden='true'><use href='#i-wind'/></svg></span><span class='grow place-text'><b>Cape Town</b><small class='muted'>Sunny and windy</small></span><span class='place-temp'>24°</span></a></li><li><a class='place' href='#/home/cloudy' data-testid='home-place-row'><span class='wx-chip' data-wx='cloudy-night'><svg class='i' aria-hidden='true'><use href='#i-cloud-moon'/></svg></span><span class='grow place-text'><b>Vancouver</b><small class='muted'>Overcast</small></span><span class='place-temp'>5°</span></a></li></ul><button type='button' class='button button-outline' data-toast='toast-locate' data-testid='home-locate-button'><svg class='i' aria-hidden='true'><use href='#i-locate'/></svg>Use my location</button></aside><div class='wx-main stack gap-4'><div class='screen-header'><div class='stack gap-1'><h1 data-testid='home-title'>London</h1><p class='sub muted'><svg class='i i-sm' aria-hidden='true'><use href='#i-locate'/></svg>My location · England, United Kingdom · <span class='row gap-1' data-testid='home-local-time'><svg class='i i-sm' aria-hidden='true'><use href='#i-clock'/></svg>10:40 local time</span></p></div><div class='row wrap'><div class='unit-toggle' role='group' aria-label='Temperature units' data-toggle-group><button type='button' class='filter-chip' aria-pressed='true' data-testid='home-celsius-button'>°C</button><button type='button' class='filter-chip' aria-pressed='false' data-toast='toast-units' data-testid='home-fahrenheit-button'>°F</button></div><button type='button' class='button' data-toast='toast-refreshed' data-testid='home-refresh-button'><svg class='i' aria-hidden='true'><use href='#i-refresh'/></svg>Refresh</button></div></div><section class='card hero' aria-label='Current conditions'><div class='hero-top'><svg class='i i-xl' aria-hidden='true'><use href='#i-rain'/></svg><div class='stack gap-1'><p class='temp' data-testid='home-temperature-count'>9°</p><p class='cond'>Moderate rain</p><p class='muted' style='margin:0'>Rain easing to showers by 14:00, dry this evening.</p></div></div><div class='stat-grid'><div class='stat-grid-item'><span>Feels like</span><span data-testid='home-feels-count'>6°</span><small>Wind makes it feel colder</small></div><div class='stat-grid-item'><span>Wind</span><span data-testid='home-wind-count'>24 km/h</span><small>From the south-west, gusts 41</small></div><div class='stat-grid-item'><span>Humidity</span><span data-testid='home-humidity-count'>91%</span><small>Dew point 8°</small></div><div class='stat-grid-item'><span>High / low</span><span data-testid='home-high-low-count'>10° / 5°</span><small>Today</small></div><div class='stat-grid-item'><span>Rain today</span><span data-testid='home-rain-count'>7.2 mm</span><small>90% chance</small></div><div class='stat-grid-item'><span>Sun</span><span data-testid='home-sun-count'>08:02 / 16:18</span><small>Sunrise / sunset</small></div></div><div class='hero-foot'><span class='row wrap gap-2'><span class='muted small' data-testid='home-updated-count'>Updated 2 min ago · Weather from Open-Meteo</span></span><span class='badge' data-testid='home-scene-badge'>Scene: Moderate rain, day</span><label class='row switch-label'><input type='checkbox' role='switch' class='switch' data-testid='home-effects-checkbox'>Simpler effects</label></div></section><section class='card' aria-label='Next 24 hours'><div class=