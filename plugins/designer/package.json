{
  "name": "@corbits-builder/designer",
  "version": "0.2.0",
  "private": true,
  "description": "Designs how an interface could look, such as a web app, a mobile app's screens, a dashboard or a marketing page, as clickable mockups the person compares, tries and approves, and lets the person choose its fonts and colours.",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "type": "module",
  "exports": {
    "./agent": "./src/agent.ts",
    "./contract": "./src/contract.ts",
    "./skills": "./src/skills.ts",
    "./mockup": "./src/mockup/definition.ts",
    "./pick-fonts": "./src/pick-fonts/definition.ts",
    "./pick-fonts/schema": "./src/pick-fonts/schema.ts",
    "./pick-fonts/view": "./src/pick-fonts/view.tsx",
    "./pick-fonts/data": "./src/pick-fonts/data.json",
    "./pick-colours": "./src/pick-colours/definition.ts",
    "./pick-colours/schema": "./src/pick-colours/schema.ts",
    "./pick-colours/view": "./src/pick-colours/view.tsx",
    "./review": "./src/review/definition.ts",
    "./review/schema": "./src/review/schema.ts",
    "./review/view": "./src/review/view.tsx",
    "./choose": "./src/choose/definition.ts",
    "./choose/schema": "./src/choose/schema.ts",
    "./choose/view": "./src/choose/view.tsx",
    "./looks": "./src/looks/definition.ts",
    "./looks/schema": "./src/looks/schema.ts",
    "./looks/view": "./src/looks/view.tsx",
    "./packages/*": "./src/packages/*.ts"
  },
  "dependencies": {
    "@corbits-builder/coder": "workspace:*",
    "@corbits-builder/hub": "workspace:*",
    "@corbits-builder/plugin": "workspace:*",
    "@corbits-builder/plugin-host": "workspace:*",
    "@corbits-builder/plugin-ui": "workspace:*",
    "@corbits-builder/schemas": "workspace:*",
    "@corbits/react-ui": "0.5.1",
    "@intx/agent": "workspace:*",
    "@intx/tools-mail": "workspace:*",
    "@intx/workflow": "workspace:*",
    "arktype": "catalog:",
    "lucide-react": "0.545.0",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  },
  "builder": {
    "handle": "designer",
    "runs": "specialist",
    "groups": [
      "look",
      "design",
      "type",
      "colour"
    ],
    "when": "The person wants to see how something they are making could look, to try or approve a design, or to choose its fonts or colours.",
    "unless": "They want something already built changed in a way they already stated exactly.",
    "packages": {
      "designer": {
        "entry": "./src/packages/designer.ts",
        "role": "designer"
      }
    },
    "starters": {
      "designer": "./src/start.ts"
    },
    "actions": {
      "mockup": {
        "reads": [
          "brand.guidelines",
          "look.font-primary",
          "look.font-secondary",
          "look.color-primary",
          "look.color-background"
        ],
        "returns": [
          "filed:design_option"
        ],
        "start": {
          "workflow": "designer"
        },
        "presents": [
          "choose",
          "review"
        ]
      },
      "looks": {},
      "review": {
        "requires": [
          [
            "filed:design_option"
          ]
        ],
        "returns": [
          "design_chosen"
        ],
        "place": "page",
        "host": [
          "design",
          "mockupFrame",
          "earlierAnswer"
        ]
      },
      "choose": {
        "requires": [
          [
            "filed:design_option"
          ]
        ],
        "returns": [
          "design_chosen"
        ],
        "place": "page",
        "host": [
          "designConcepts",
          "mockupFrame"
        ]
      },
      "pick-fonts": {
        "reads": [
          "look.font-primary",
          "look.font-secondary"
        ]
      },
      "pick-colours": {
        "reads": [
          "look.color-primary",
          "look.color-background"
        ]
      }
    },
    "examples": [
      "make me a mockup for a dog-walking app",
      "design the screens for my phone app",
      "mock up a landing page for my product",
      "show me a few different looks",
      "can I see what it would look like",
      "redesign it",
      "let me see the mockup",
      "I want to give feedback on the design",
      "the design looks good, approve it",
      "the font is ugly",
      "can we use a different typeface",
      "I'm not sure about the font, what else could work",
      "the writing looks boring, can it be more elegant",
      "make it look like a newspaper with a serif",
      "the colours clash",
      "can we make it less orange",
      "I don't know which colour would suit us",
      "the background is too bright",
      "the buttons don't look right"
    ],
    "triggers": [
      "font",
      "fonts",
      "typeface",
      "lettering",
      "colour",
      "color",
      "colours",
      "colors",
      "palette"
    ],
    "facts": {
      "filed:design_option": "a design option is filed",
      "design_chosen": "the person chose a design from the design options"
    }
  }
}
