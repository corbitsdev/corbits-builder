{
  "name": "@corbits-builder/presenter",
  "version": "0.1.0-rc.3",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "type": "module",
  "exports": {
    "./skills": "./src/skills.ts",
    "./personas": "./src/personas.ts",
    "./packages/*": "./src/packages/*.ts"
  },
  "dependencies": {
    "@corbits-builder/hub": "workspace:*",
    "@intx/agent": "workspace:*",
    "@intx/tools-mail": "workspace:*",
    "@intx/workflow": "workspace:*"
  },
  "builder": {
    "roles": [
      {
        "name": "presenter",
        "model": "presenter",
        "limits": "presenter",
        "called": "the presenter",
        "ended": {
          "failed": "The presenter stopped before finishing.",
          "cancelled": "The presentation was stopped.",
          "task": "The presenter building the approval package"
        }
      }
    ],
    "packages": {
      "presenter": {
        "entry": "./src/packages/presenter.ts",
        "role": "presenter"
      }
    }
  }
}
