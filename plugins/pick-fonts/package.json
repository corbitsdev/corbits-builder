{
  "name": "@corbits-builder/pick-fonts",
  "version": "0.1.0-rc.3",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "type": "module",
  "exports": {
    ".": "./src/screen.ts",
    "./schema": "./src/schema.ts",
    "./view": "./src/view.tsx",
    "./data": "./data/fonts.json"
  },
  "dependencies": {
    "@corbits-builder/plugin": "workspace:*",
    "@corbits/react-ui": "0.5.1",
    "arktype": "catalog:",
    "lucide-react": "0.545.0",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  },
  "builder": {
    "handle": "pick-fonts",
    "runs": "screen",
    "groups": [
      "look",
      "type"
    ],
    "when": "The person is unhappy with the typeface or unsure which font would suit.",
    "unless": "They already said exactly which font they want, or they want text bigger or smaller, or a whole new look.",
    "screen": "./src/screen.ts",
    "view": "./src/view.tsx",
    "data": "./data/fonts.json",
    "authorizes": false,
    "reads": [
      "look.font-primary",
      "look.font-secondary"
    ],
    "writes": [
      "look.font-primary",
      "look.font-secondary"
    ],
    "examples": [
      "the font is ugly",
      "can we use a different typeface",
      "I'm not sure about the font, what else could work",
      "the writing looks boring, can it be more elegant",
      "make it look like a newspaper with a serif"
    ],
    "triggers": [
      "font",
      "fonts",
      "typeface",
      "lettering"
    ]
  }
}
