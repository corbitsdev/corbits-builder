{
  "name": "@corbits-builder/build-app",
  "version": "0.1.0-rc.3",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "type": "module",
  "exports": {
    ".": "./src/input.ts"
  },
  "dependencies": {
    "@corbits-builder/plugin": "workspace:*",
    "arktype": "catalog:"
  },
  "builder": {
    "handle": "build-app",
    "runs": "workflow",
    "groups": [
      "build"
    ],
    "when": "The project has no app yet and its requirements or build plan say what to build.",
    "unless": "The project already has an app; a change to it is change-app.",
    "input": "./src/input.ts",
    "requires": [
      [
        "filed:product_requirements"
      ],
      [
        "filed:build_plan"
      ]
    ],
    "returns": [
      "app_exists"
    ],
    "examples": [
      "build it",
      "go ahead and build the app",
      "start building"
    ]
  }
}
