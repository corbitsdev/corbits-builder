{
  "name": "@corbits-builder/coder",
  "version": "0.9.0",
  "private": true,
  "description": "Builds the project's code the first time, whatever kind of thing it is, and changes the code the project has, built here or imported.",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "type": "module",
  "dependencies": {
    "@corbits-builder/app-checks": "workspace:*",
    "@corbits-builder/plugin": "workspace:*",
    "@corbits-builder/schemas": "workspace:*",
    "@corbits/react-ui": "0.5.1",
    "arktype": "catalog:"
  },
  "builder": {
    "handle": "coder",
    "runs": "specialist",
    "groups": [
      "build",
      "change"
    ],
    "when": "The project's code needs building for the first time, or the person asks for a change to the code the project has.",
    "unless": "The person is still unsure what they want and would rather compare options or see a mockup first.",
    "roles": [
      {
        "name": "coder",
        "label": "Coder",
        "model": "builder",
        "limits": "coding",
        "tools": [
          "read_artifact",
          "web"
        ],
        "status": {
          "working": "Working on the code",
          "done": "Worked on the code"
        },
        "preferences": [
          "replies",
          "technical"
        ],
        "buildsFrom": [
          "problem_brief",
          "constraints",
          "approaches",
          "product_requirements",
          "build_plan",
          "design"
        ],
        "files": "app",
        "writesCode": true
      }
    ],
    "settings": {
      "builder": {
        "label": "App builder",
        "hint": "Builds the app.",
        "tier": "high"
      }
    },
    "budgets": {
      "coding": {
        "maxOutputTokens": 65536
      }
    },
    "agents": {
      "coder": {
        "prompt": "./prompt.md",
        "workspace": "./src/workspace.ts"
      }
    },
    "starters": {
      "coder": "./src/start.ts"
    },
    "appStarters": {
      "web-app": {
        "about": "A web app people use in a browser: a Bun workspace with client/ (Vite, React, React Router, TanStack Query, Tailwind CSS v4 and @corbits/react-ui), server/ (Hono on Bun, with data people enter kept as validated JSON files under server/data through createStore, and data the app ships with under server/src/data) and packages/shared (zod schemas both sides use).",
        "folder": "starter",
        "run": {
          "command": "bun run dev",
          "port": "CLIENT_PORT",
          "extraPorts": [
            "PORT"
          ]
        },
        "production": {
          "install": "bun install --frozen-lockfile",
          "build": "bun run build",
          "start": "bun run start",
          "port": "PORT",
          "data": [
            "server/data"
          ]
        },
        "setup": "bun install --frozen-lockfile",
        "checks": [
          "bun install --frozen-lockfile",
          "bun run typecheck",
          "bun run build"
        ],
        "setupFailed": "If it says the lockfile is frozen, bring bun.lock up to date with install_packages, naming the packages the output says changed at the versions package.json gives them.",
        "legacyDefault": true
      },
      "bare": {
        "about": "A TypeScript project on Bun that is not a web app, such as a command-line tool, a library, a script or a service: one package with tests and no framework.",
        "folder": "starters/bare",
        "setup": "bun install --frozen-lockfile",
        "checks": [
          "bun install --frozen-lockfile",
          "bun run typecheck",
          "bun run test",
          "bun run build"
        ],
        "setupFailed": "If it says the lockfile is frozen, bring bun.lock up to date with install_packages, naming the packages the output says changed at the versions package.json gives them."
      }
    },
    "actions": {
      "build": {
        "requires": [
          [
            "filed:product_requirements",
            "!app_exists"
          ],
          [
            "filed:build_plan",
            "!app_exists"
          ]
        ],
        "returns": [
          "app_exists"
        ],
        "writes": [
          "stack.language",
          "stack.starter",
          "stack.checks",
          "stack.run",
          "stack.production"
        ],
        "start": {
          "workflow": "coder",
          "correlation": "coder",
          "app": "new"
        },
        "done": [
          "builds"
        ]
      },
      "change": {
        "requires": [
          [
            "app_exists"
          ]
        ],
        "returns": [],
        "reads": [
          "brand.guidelines",
          "stack.language"
        ],
        "writes": [
          "stack.language",
          "stack.checks",
          "stack.run",
          "stack.production"
        ],
        "start": {
          "workflow": "coder",
          "correlation": "coder-change",
          "app": "existing"
        },
        "done": [
          "builds"
        ]
      },
      "builds": {
        "requires": [
          [
            "app_exists"
          ]
        ],
        "all": [
          {
            "command": {
              "value": "stack.checks"
            }
          }
        ],
        "returns": [
          "builds:app"
        ]
      }
    },
    "examples": [
      "build it",
      "go ahead and build it",
      "start building",
      "build me a command-line tool",
      "change the font to Inter",
      "add a flag that prints the version",
      "the save button does nothing"
    ],
    "facts": {
      "app_exists": "the project has code, built or imported",
      "!app_exists": "the project has no code yet",
      "builds:app": "the project's saved code builds"
    },
    "values": "./src/values.ts"
  }
}
