{
  "name": "@corbits-builder/coder",
  "version": "0.9.0",
  "private": true,
  "description": "Builds the app the first time, and changes the app the project has, built here or imported.",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "type": "module",
  "exports": {
    "./assets": "./src/assets.ts",
    "./contract": "./src/contract.ts",
    "./packages/*": "./src/packages/*.ts"
  },
  "dependencies": {
    "@corbits-builder/hub": "workspace:*",
    "@corbits-builder/plugin": "workspace:*",
    "@corbits-builder/plugin-host": "workspace:*",
    "@corbits/mcp": "0.4.1",
    "@corbits/react-ui": "0.5.1",
    "@intx/agent": "workspace:*",
    "@intx/tools-mail": "workspace:*",
    "@intx/workflow": "workspace:*",
    "arktype": "catalog:"
  },
  "builder": {
    "handle": "coder",
    "runs": "specialist",
    "groups": [
      "build",
      "change"
    ],
    "when": "The app needs building for the first time, or the person asks for a change to the app the project has.",
    "unless": "The person is unsure what they want and a screen would let them choose, or they want only a mockup.",
    "packages": {
      "coder": {
        "entry": "./src/packages/coder.ts",
        "role": "coder"
      },
      "coder-any-package": {
        "entry": "./src/packages/coder-any-package.ts",
        "role": "coder"
      }
    },
    "starters": {
      "coder": "./src/start.ts"
    },
    "actions": {
      "build": {
        "runs": "workflow",
        "when": "The project has no app yet and its requirements or build plan say what to build.",
        "unless": "The project already has an app; a change to it is coder change.",
        "input": "./src/build.ts",
        "requires": [
          [
            "filed:product_requirements",
            "!app_exists"
          ],
          [
            "filed:build_plan",
            "!app_exists"
          ]
        ],
        "returns": [
          "app_exists"
        ],
        "writes": [
          "stack.language"
        ],
        "start": {
          "workflow": "coder",
          "correlation": "coder",
          "app": "new"
        }
      },
      "change": {
        "runs": "workflow",
        "when": "The person asks for a change to the app the project already has, built here or imported: a fix, an addition or a correction.",
        "unless": "The project has no app yet, or the person is unsure what they want and a screen would let them choose.",
        "input": "./src/change.ts",
        "requires": [
          [
            "app_exists"
          ]
        ],
        "returns": [],
        "reads": [
          "brand.guidelines",
          "stack.language"
        ],
        "writes": [
          "stack.language"
        ],
        "start": {
          "workflow": "coder",
          "correlation": "coder-change",
          "app": "existing"
        }
      },
      "builds": {
        "runs": "check",
        "when": "Before showing, filing or deploying the app, to prove its saved version still builds.",
        "requires": [
          [
            "app_exists"
          ]
        ],
        "all": [
          {
            "command": {
              "run": [
                "bun",
                "run",
                "build"
              ]
            }
          }
        ],
        "returns": [
          "builds:app"
        ]
      }
    },
    "examples": [
      "build it",
      "go ahead and build the app",
      "start building",
      "change the font to Inter",
      "make the text bigger",
      "add a settings page",
      "the save button does nothing"
    ],
    "facts": {
      "app_exists": "the project has an app, built or imported",
      "!app_exists": "the project has no app yet",
      "builds:app": "the app's saved version builds"
    },
    "values": {
      "stack.language": {
        "about": "The programming language the app is written in, such as TypeScript.",
        "type": "text"
      }
    }
  }
}
