{
  "name": "@corbits-builder/change-app",
  "version": "0.1.0-rc.3",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "type": "module",
  "exports": {
    ".": "./src/input.ts"
  },
  "dependencies": {
    "@corbits-builder/plugin": "workspace:*",
    "arktype": "catalog:"
  },
  "builder": {
    "handle": "change-app",
    "runs": "workflow",
    "groups": [
      "build",
      "change"
    ],
    "when": "The person asks for a change to the app the project already has, built here or imported: a fix, an addition or a correction.",
    "unless": "The project has no app yet, or the person is unsure what they want and a screen would let them choose.",
    "input": "./src/input.ts",
    "requires": [
      [
        "app_exists"
      ]
    ],
    "returns": [],
    "examples": [
      "change the font to Inter",
      "make the text bigger",
      "add a settings page",
      "the save button does nothing"
    ]
  }
}
