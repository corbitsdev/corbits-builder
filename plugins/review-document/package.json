{
  "name": "@corbits-builder/review-document",
  "version": "0.1.0-rc.3",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "type": "module",
  "exports": {
    ".": "./src/input.ts"
  },
  "dependencies": {
    "@corbits-builder/plugin": "workspace:*",
    "@corbits-builder/schemas": "workspace:*",
    "arktype": "catalog:"
  },
  "builder": {
    "handle": "review-document",
    "runs": "workflow",
    "groups": [
      "documents",
      "review"
    ],
    "when": "You want a second opinion on a filed document before you rely on it or put it to the person.",
    "unless": "The person asked for something you can start directly.",
    "input": "./src/input.ts",
    "requires": [
      [
        "filed:{kind}"
      ]
    ],
    "returns": [],
    "examples": [
      "is this plan any good",
      "check the requirements for gaps"
    ]
  }
}
