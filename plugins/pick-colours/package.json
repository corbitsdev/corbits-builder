{
  "name": "@corbits-builder/pick-colours",
  "version": "0.1.0-rc.3",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "type": "module",
  "exports": {
    ".": "./src/screen.ts",
    "./schema": "./src/schema.ts",
    "./view": "./src/view.tsx"
  },
  "dependencies": {
    "@corbits-builder/plugin": "workspace:*",
    "@corbits/react-ui": "0.5.1",
    "arktype": "catalog:",
    "lucide-react": "0.545.0",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  },
  "builder": {
    "handle": "pick-colours",
    "runs": "screen",
    "groups": [
      "look",
      "colour"
    ],
    "when": "The person is unhappy with the colours, wants a different shade, or names a colour they want for the brand or the background.",
    "unless": "They want another font, bigger or smaller text, or a whole new look.",
    "screen": "./src/screen.ts",
    "returns": {
      "fact": "colours_chosen"
    },
    "authorizes": false,
    "reads": [
      "look.color-primary",
      "look.color-background"
    ],
    "writes": [
      "look.color-primary",
      "look.color-background"
    ],
    "examples": [
      "the colours clash",
      "can we make it less orange",
      "use our brand blue #1d4ed8",
      "the background is too bright, make it a soft grey",
      "I want the buttons green"
    ],
    "triggers": [
      "colour",
      "color",
      "colours",
      "colors",
      "palette"
    ]
  }
}
