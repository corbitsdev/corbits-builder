{
  "name": "@corbits-builder/cloudflare",
  "version": "0.1.0-rc.3",
  "private": true,
  "description": "Checks that the app is ready to deploy to Cloudflare Workers.",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "type": "module",
  "dependencies": {
    "@corbits-builder/hub": "workspace:*",
    "@corbits-builder/plugin": "workspace:*",
    "@corbits-builder/plugin-host": "workspace:*",
    "@corbits-builder/schemas": "workspace:*",
    "@intx/types": "workspace:*",
    "@intx/workflow": "workspace:*",
    "arktype": "catalog:"
  },
  "builder": {
    "handle": "cloudflare",
    "runs": "specialist",
    "groups": [
      "deploy"
    ],
    "when": "The person wants the app on Cloudflare Workers, or asks whether it is ready to go there.",
    "unless": "The app is meant for another host.",
    "actions": {
      "ready": {
        "rerun": "change",
        "all": [
          {
            "file": "wrangler.toml"
          },
          {
            "file": "src/index.ts"
          },
          {
            "fileContains": {
              "path": "package.json",
              "text": "wrangler"
            }
          },
          {
            "approved": "build_plan"
          }
        ],
        "returns": [
          "ready:cloudflare"
        ]
      },
      "routes": {
        "requires": [
          [
            "ready:cloudflare"
          ]
        ],
        "returns": [
          "routed:cloudflare"
        ]
      }
    },
    "facts": {
      "ready:cloudflare": "the app has what a Cloudflare Workers deploy needs and the person approved its build plan",
      "routed:cloudflare": "the app's wrangler.toml routes the Worker to a domain"
    }
  }
}
