{
  "name": "@corbits-builder/cloudflare",
  "version": "0.1.0-rc.3",
  "private": true,
  "description": "Publishes the project's app to Cloudflare, so people can open it at its own address, with the person's own Cloudflare account or without one.",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "type": "module",
  "dependencies": {
    "@corbits-builder/plugin": "workspace:*",
    "@corbits-builder/plugin-ui": "workspace:*",
    "@corbits-builder/publishing": "workspace:*",
    "@corbits-builder/schemas": "workspace:*",
    "@corbits/react-ui": "0.5.1",
    "@corbits/zip": "workspace:*",
    "@intx/agent": "workspace:*",
    "@intx/types": "workspace:*",
    "arktype": "catalog:",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  },
  "builder": {
    "handle": "cloudflare",
    "runs": "specialist",
    "groups": [
      "publish"
    ],
    "when": "The person wants their app published to, checked on or taken off Cloudflare, so people can open it at its own address, or asks whether it is ready to go there.",
    "unless": "The project has no saved app yet, or the person wants it published somewhere other than Cloudflare.",
    "values": "./src/values.ts",
    "credentials": {
      "cloudflare": {
        "about": "Your Cloudflare API token",
        "origin": "https://api.cloudflare.com",
        "sends": "bearer",
        "screen": "account",
        "notNeededWhile": "cloudflare.terms"
      }
    },
    "roles": [
      {
        "name": "cloudflare",
        "label": "Cloudflare publisher",
        "model": "publisher",
        "limits": "publisher",
        "tools": [],
        "status": {
          "working": "Publishing to Cloudflare",
          "done": "Published to Cloudflare"
        }
      }
    ],
    "settings": {
      "publisher": {
        "label": "Publisher",
        "hint": "Publishes the app where the person chose and explains what went wrong.",
        "tier": "low"
      }
    },
    "budgets": {
      "publisher": {
        "maxOutputTokens": 8192
      }
    },
    "agents": {
      "cloudflare": {
        "prompt": "./prompt.md",
        "skills": "./skills",
        "tools": "./src/tools.ts"
      },
      "cloudflare-remove": {
        "prompt": "./remove.md",
        "skills": "./skills",
        "tools": "./src/remove-tools.ts"
      }
    },
    "actions": {
      "account": {
        "reads": [
          "cloudflare.site",
          "publish.release",
          "publish.holding",
          "publish.keep",
          "publish.take-down"
        ],
        "host": [
          "tenants"
        ]
      },
      "ready": {
        "rerun": "change",
        "returns": [
          "ready:cloudflare"
        ]
      },
      "publish": {
        "requires": [
          [
            "app_exists",
            "ready:cloudflare",
            "agreed:publish"
          ]
        ],
        "reads": [
          "stack.production",
          "publish.release",
          "cloudflare.site",
          "cloudflare.terms"
        ],
        "writes": [
          "publish.release",
          "publish.keep",
          "cloudflare.site",
          "cloudflare.terms"
        ],
        "returns": [],
        "start": {
          "agent": "cloudflare"
        }
      },
      "live": {
        "rerun": "value",
        "requires": [
          [
            "app_exists"
          ]
        ],
        "returns": [
          "published:cloudflare"
        ]
      },
      "removable": {
        "rerun": "value",
        "returns": [
          "removable:cloudflare"
        ],
        "skip": "never"
      },
      "remove": {
        "requires": [
          [
            "removable:cloudflare"
          ]
        ],
        "reads": [
          "publish.release",
          "publish.holding",
          "publish.take-down",
          "cloudflare.site"
        ],
        "writes": [
          "publish.release",
          "publish.keep"
        ],
        "returns": [],
        "start": {
          "agent": "cloudflare-remove"
        }
      }
    },
    "facts": {
      "ready:cloudflare": "the saved app is made to run on Cloudflare Workers and says how it is built for production",
      "published:cloudflare": "the app as saved now is published on Cloudflare",
      "removable:cloudflare": "the person agreed, on the take-down screen, to take down the app as it is published on Cloudflare now"
    },
    "examples": [
      "put my app on Cloudflare",
      "publish the app to Cloudflare Workers",
      "is my app still up on Cloudflare",
      "take the app off Cloudflare"
    ]
  }
}
