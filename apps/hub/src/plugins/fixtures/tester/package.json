{
  "name": "@corbits-builder/tester",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "builder": {
    "handle": "tester",
    "runs": "specialist",
    "groups": [
      "test"
    ],
    "when": "The person wants the project's code tried out.",
    "unless": "They want the code changed.",
    "roles": [
      {
        "name": "tester",
        "label": "Tester",
        "model": "tester",
        "limits": "testing",
        "tools": [
          "read_artifact"
        ],
        "status": {
          "working": "Testing the code",
          "done": "Tested the code"
        },
        "preferences": [
          "technical"
        ],
        "writesCode": true
      }
    ],
    "settings": {
      "tester": {
        "label": "Tester",
        "hint": "Tries out the code.",
        "tier": "medium"
      }
    },
    "budgets": {
      "testing": {
        "maxOutputTokens": 16384
      }
    },
    "agents": {
      "tester": {
        "prompt": "./prompt.md"
      }
    },
    "starters": {
      "tester-probe": "./src/start.ts"
    },
    "actions": {
      "test": {
        "returns": [],
        "start": {
          "agent": "tester"
        }
      },
      "probe": {
        "returns": [],
        "writes": [
          "tester.notes"
        ],
        "start": {
          "workflow": "tester-probe"
        }
      }
    },
    "values": {
      "tester.notes": {
        "about": "What the person asked the tester to look into last.",
        "type": "text"
      }
    }
  }
}
