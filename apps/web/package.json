{
  "name": "@corbits-builder/web",
  "version": "0.1.0-rc.3",
  "private": true,
  "description": "Builder portal (Vite + React). Composes the hub's authenticated APIs.",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel css-types:watch serve",
    "serve": "vite",
    "build": "vite build",
    "css-types": "tcm -s -p \"src/**/*.module.css\" && tcm -s -p \"../../plugins/*/src/**/*.module.css\" && tcm -s -p \"../../packages/plugin-ui/src/**/*.module.css\"",
    "css-types:watch": "tcm -s -w -p \"src/**/*.module.css\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@corbits-builder/client": "workspace:*",
    "@corbits-builder/plugin": "workspace:*",
    "@corbits-builder/plugin-ui": "workspace:*",
    "@corbits-builder/schemas": "workspace:*",
    "@corbits/react-ui": "0.5.1",
    "@corbits/slidedeck": "workspace:*",
    "@intx/types": "workspace:*",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/query-async-storage-persister": "5.104.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-persist-client": "5.104.1",
    "arktype": "catalog:",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "idb-keyval": "6.2.2",
    "jszip": "3.10.2",
    "lucide-react": "0.545.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@storybook/react-vite": "11.0.0-beta.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "storybook": "11.0.0-beta.0",
    "typed-css-modules": "0.9.1",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
