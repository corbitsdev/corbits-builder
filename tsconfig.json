{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "customConditions": ["intx-src"],
    "moduleDetection": "force",
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "apps/hub",
    "scripts",
    "packages",
    "plugins",
    "workflows",
    "test"
  ],
  "exclude": [
    "node_modules",
    "vendor",
    "plugins/*/src/**/*.tsx",
    "packages/plugin-ui",
    "plugins/coder/starter",
    "plugins/coder/starters",
    "test/seed/**/app",
    "packages/client"
  ]
}
